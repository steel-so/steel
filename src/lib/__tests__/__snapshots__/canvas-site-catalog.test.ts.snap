exports[`templates > renders each template to stable html and css 1`] = `
"@layer s-base{
.s-site{--canvas-primary:#7b11f9;--canvas-secondary:#68d585;--canvas-accent:#f74d4d;--canvas-dark:#1e2541;--canvas-text:#161c2d;--canvas-muted:#5c6272;--canvas-background:#ffffff;--canvas-surface:#f4f7fa;--canvas-border:#e7e9ed;--canvas-inverse:#ffffff;--s-font-heading:var(--font-geist-sans), "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;--s-font-body:var(--font-geist-sans), "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;--s-space-xs:4px;--s-space-sm:8px;--s-space-md:16px;--s-space-lg:32px;--s-space-xl:64px;--s-space-xxl:120px;--s-radius-sm:8px;--s-shadow-sm:0px 1px 3px 0px #161c2d1f;--s-radius-md:16px;--s-shadow-md:0px 12px 32px -8px #161c2d29;--s-radius-lg:28px;--s-shadow-lg:0px 32px 54px 0px #161c2d29;--s-content:1200px}
.s-site{background:var(--canvas-background);color:var(--canvas-text);font-family:var(--s-font-body);font-size:17px;font-weight:400;line-height:1.7;letter-spacing:0px;text-transform:none;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
.s-site *,.s-site *::before,.s-site *::after{box-sizing:border-box}
.s-site :where(h1,h2,h3,h4,h5,h6,p,figure,blockquote,ul,ol,dl){margin:0}
.s-site :where(ul,ol){padding:0}
.s-site :where(img,video,svg,iframe){display:block;max-width:100%}
.s-site :where(img,video){height:auto}
.s-site :where(button,input,select,textarea){font:inherit;color:inherit}
.s-site :where(a){color:var(--canvas-primary);text-decoration:none;text-underline-offset:.2em}
.s-site :where(a):hover{color:var(--canvas-dark);text-decoration:underline}
.s-site :where(:focus-visible){outline:2px solid var(--canvas-primary);outline-offset:2px}
.s-site .s-rich :where(p+p,p+ul,p+ol,ul+p,ol+p){margin-top:.75em}
.s-site .s-rich :where(ul,ol){padding-left:1.4em}
.s-site .s-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.s-site :where(.s-t-h1){font-family:var(--s-font-heading);font-size:64px;font-weight:700;line-height:1.1;letter-spacing:-1.5px;text-transform:none}
.s-site :where(.s-t-h2){font-family:var(--s-font-heading);font-size:44px;font-weight:700;line-height:1.15;letter-spacing:-1px;text-transform:none}
.s-site :where(.s-t-h3){font-family:var(--s-font-heading);font-size:32px;font-weight:700;line-height:1.25;letter-spacing:-0.5px;text-transform:none}
.s-site :where(.s-t-h4){font-family:var(--s-font-heading);font-size:24px;font-weight:700;line-height:1.3;letter-spacing:-0.3px;text-transform:none}
.s-site :where(.s-t-h5){font-family:var(--s-font-heading);font-size:20px;font-weight:700;line-height:1.4;letter-spacing:0px;text-transform:none}
.s-site :where(.s-t-h6){font-family:var(--s-font-heading);font-size:17px;font-weight:700;line-height:1.4;letter-spacing:0px;text-transform:none}
.s-site :where(.s-t-lead){font-family:var(--s-font-body);font-size:21px;font-weight:400;line-height:1.6;letter-spacing:0px;text-transform:none}
.s-site :where(.s-t-body){font-family:var(--s-font-body);font-size:17px;font-weight:400;line-height:1.7;letter-spacing:0px;text-transform:none}
.s-site :where(.s-t-small){font-family:var(--s-font-body);font-size:14px;font-weight:400;line-height:1.6;letter-spacing:0px;text-transform:none}
.s-site :where(.s-t-overline){font-family:var(--s-font-body);font-size:13px;font-weight:700;line-height:1.4;letter-spacing:1.6px;text-transform:uppercase}
.s-site :where(.s-btn){display:inline-flex;align-items:center;justify-content:center;gap:.5em;padding:14px 32px;border-radius:999px;border:1px solid transparent;font-family:var(--s-font-body);font-size:17px;font-weight:700;letter-spacing:-0.3px;text-transform:none;line-height:1.2;white-space:nowrap;text-decoration:none;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s}
.s-site :where(.s-btn-sm){padding:8px 19px;font-size:14px}
.s-site :where(.s-btn-lg){padding:18px 42px;font-size:19px}
.s-site :where(.s-btn-primary){background:var(--canvas-primary);color:var(--canvas-inverse);border-color:var(--canvas-primary)}
.s-site :where(.s-btn-primary):hover{background:var(--canvas-dark);color:var(--canvas-inverse);text-decoration:none}
.s-site :where(.s-btn-secondary){background:var(--canvas-inverse);color:var(--canvas-primary);border-color:var(--canvas-inverse)}
.s-site :where(.s-btn-secondary):hover{background:var(--canvas-surface);color:var(--canvas-primary);text-decoration:none}
.s-site :where(.s-btn-outline){background:transparent;color:var(--canvas-text);border-color:var(--canvas-border)}
.s-site :where(.s-btn-outline):hover{background:var(--canvas-surface);color:var(--canvas-text);text-decoration:none}
.s-site :where(.s-btn-link){background:transparent;padding-left:0;padding-right:0;color:var(--canvas-primary)}
.s-site :where(.s-btn-link):hover{color:var(--canvas-dark);text-decoration:underline}
@media (max-width: 1023.98px){.s-site :where(.s-t-h1){font-size:52px}.s-site :where(.s-t-h2){font-size:38px}.s-site :where(.s-t-h3){font-size:28px}.s-site :where(.s-t-h4){font-size:22px}.s-site :where(.s-t-h5){font-size:19px}.s-site :where(.s-t-h6){font-size:17px}.s-site :where(.s-t-lead){font-size:19px}}
@media (max-width: 767.98px){.s-site :where(.s-t-h1){font-size:38px}.s-site :where(.s-t-h2){font-size:30px}.s-site :where(.s-t-h3){font-size:24px}.s-site :where(.s-t-h4){font-size:20px}.s-site :where(.s-t-h5){font-size:18px}.s-site :where(.s-t-h6){font-size:16px}.s-site :where(.s-t-lead){font-size:18px}}
.s-site .s-inner{position:relative;display:flex;flex-direction:column;margin-left:auto;margin-right:auto}
.s-site .s-bg-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;pointer-events:none}
.s-site .s-rich{overflow-wrap:break-word}
.s-site .s-btn-icon{width:1.15em;height:1.15em;flex:none}
.s-site .s-media{display:block;max-width:100%}
.s-site .s-caption{margin-top:8px;color:var(--canvas-muted)}
.s-site .s-icon-box{display:inline-flex;align-items:center;justify-content:center;flex:none}
.s-site .s-video-frame{position:relative;overflow:hidden;background:#000;width:100%}
.s-site .s-video-frame>iframe,.s-site .s-video-frame>video{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover}
.s-site .s-list{list-style:none;padding:0}
.s-site .s-list>li{display:flex;align-items:flex-start;gap:.6em}
.s-site .s-list .s-marker{flex:none;display:inline-flex;width:1.25em;height:1.25em;margin-top:.2em}
.s-site .s-list .s-marker>svg{width:100%;height:100%}
.s-site .s-list-dot>li::before{content:"";flex:none;width:.45em;height:.45em;margin-top:.65em;border-radius:50%;background:currentColor}
.s-site .s-list-number{counter-reset:s-li}
.s-site .s-list-number>li{counter-increment:s-li}
.s-site .s-list-number>li::before{content:counter(s-li) ".";flex:none;min-width:1.4em;font-weight:700}
.s-site .s-form{display:grid;gap:16px}
.s-site .s-field{display:flex;flex-direction:column;gap:6px;min-width:0}
.s-site .s-field-wide,.s-site .s-form-actions,.s-site .s-form-status,.s-site .s-form-empty{grid-column:1/-1}
.s-site .s-label{font-size:14px;font-weight:600}
.s-site .s-input{width:100%;padding:12px 14px;border:1px solid var(--canvas-border);border-radius:var(--s-radius-sm);background:var(--canvas-background);color:var(--canvas-text);font-size:16px;line-height:1.4}
.s-site textarea.s-input{min-height:120px;resize:vertical}
.s-site .s-check{display:flex;align-items:flex-start;gap:10px;font-size:15px}
.s-site .s-check>input{width:18px;height:18px;margin-top:2px;accent-color:var(--canvas-primary)}
.s-site .s-form-actions{display:flex}
.s-site .s-form-status{font-size:15px}
.s-site .s-form-status[data-state=error]{color:var(--canvas-accent)}
.s-site .s-hp{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
.s-site .s-form-empty{padding:16px;border:1px dashed var(--canvas-border);border-radius:var(--s-radius-sm);color:var(--canvas-muted);font-size:14px}
.s-site .s-menu{position:relative}
.s-site .s-menu-list{display:flex;list-style:none;margin:0;padding:0}
.s-site .s-menu-link{display:inline-block;padding:6px 0;color:inherit;text-decoration:none}
.s-site .s-menu-link[aria-current=page]{font-weight:700}
.s-site .s-menu-burger{display:none}
.s-site .s-menu-burger>summary{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;cursor:pointer;list-style:none;border-radius:var(--s-radius-sm)}
.s-site .s-menu-burger>summary::-webkit-details-marker{display:none}
.s-site .s-menu-burger>summary>svg{width:26px;height:26px}
.s-site .s-menu-burger .s-menu-list{position:absolute;top:100%;right:0;z-index:50;flex-direction:column;gap:4px;min-width:220px;padding:12px 20px;background:var(--canvas-background);color:var(--canvas-text);border-radius:var(--s-radius-md);box-shadow:var(--s-shadow-md)}
.s-site .s-social{display:flex;flex-wrap:wrap;list-style:none;padding:0}
.s-site .s-social a{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
.s-site .s-embed iframe{display:block;width:100%;border:0}
@media (max-width: 1023.98px){.s-site .s-menu-collapse-tablet .s-menu-inline{display:none}.s-site .s-menu-collapse-tablet .s-menu-burger{display:block}}
@media (max-width: 767.98px){.s-site .s-menu-collapse-mobile .s-menu-inline{display:none}.s-site .s-menu-collapse-mobile .s-menu-burger{display:block}}
@media (min-width: 1024px){.s-site .s-hide-base{display:none!important}}
@media (min-width: 768px) and (max-width: 1023.98px){.s-site .s-hide-tablet{display:none!important}}
@media (max-width: 767.98px){.s-site .s-hide-mobile{display:none!important}}
}
