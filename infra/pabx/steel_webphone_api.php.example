 * `steel_webphone` (ver docs/runbooks/pabx-webphone.md).
 */
const STEEL_WEBPHONE_DB_USER = 'steel_webphone';
const STEEL_WEBPHONE_DB_PASS = 'TROCAR';
// Domínio SIP do ramal (o mesmo do `sip_domain` do softphone: IP público do PABX).
const STEEL_WEBPHONE_SIP_DOMAIN = '177.136.201.206';
// WebSocket seguro do PABX: o nome precisa estar no certificado (*.stratustelecom.com.br).
