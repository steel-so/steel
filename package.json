{
  "name": "steel",
  "version": "2026.8.31",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm infra && pnpm next dev -p 3001",
    "infra": "pnpm docker:start && pnpm prisma:migrate:dev",
    "build": "prisma generate && next build",
    "start": "node .next/standalone/server.js",
    "start:dev-server": "next start -H 0.0.0.0 -p 3001",
    "check": "biome check --fix",
    "check:ci": "biome check",
    "check:staged": "biome check --fix --staged --no-errors-on-unmatched",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "vitest --project e2e",
    "test:component": "vitest --project component",
    "test:unit:watch": "vitest --project unit --watch",
    "test:unit:coverage": "vitest --project unit --coverage",
    "test:all": "vitest --run",
    "test:ci": "vitest --run --coverage",
    "test:coverage": "vitest --run --coverage --project unit --project integration",
    "test:ui": "vitest --ui",
    "test:ui:coverage": "vitest --ui --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "docker:create": "docker compose -f docker-compose.infra.yml up -d",
    "docker:start": "docker compose -f docker-compose.infra.yml start",
    "docker:stop": "docker compose -f docker-compose.infra.yml stop",
    "worker:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node20 --alias:server-only=./worker/server-only.shim.ts --outfile=dist/worker.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "worker": "node dist/worker.cjs",
    "realtime:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env --watch realtime/index.ts",
    "realtime:build": "esbuild realtime/index.ts --bundle --platform=node --target=node20 --alias:server-only=./realtime/server-only.shim.ts --outfile=dist/realtime.cjs --external:argon2 --external:@prisma/client --external:.prisma/client",
    "realtime": "node dist/realtime.cjs",
    "version:sync": "tsx scripts/sync-version.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "openapi:generate": "SKIP_ENV_VALIDATION=true tsx --tsconfig tsconfig.worker.json scripts/generate-openapi.ts",
    "openapi:v1:compat": "SKIP_ENV_VALIDATION=true tsx --tsconfig tsconfig.worker.json scripts/check-openapi-v1-compat.ts",
    "seed:whatsapp-dashboards": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/backfill-whatsapp-dashboards.ts",
    "seed:crm-pipeline": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/backfill-crm-default-pipeline.ts",
    "risk:backtest": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/risk-backtest.ts",
    "seed:dev": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/seed-dev.ts",
    "seed:servicedesk": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/backfill-servicedesk-defaults.ts",
    "seed:user-timezone": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/backfill-user-timezone.ts",
    "sites:migrate-landing-pages": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/sites-migrate-landing-pages.ts",
    "search:reindex": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/search-reindex.ts",
    "ai:index": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/ai-index.ts",
    "backup:workspace": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/trigger-workspace-backup.ts",
    "backup:full": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/trigger-full-backup.ts",
    "restore:full": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/restore-full-backup.ts",
    "restore:workspace": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/restore-workspace-backup.ts",
    "backup:decrypt": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/decrypt-backup-file.ts",
    "archive:whatsapp": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/trigger-whatsapp-archive.ts",
    "prepare": "husky",
    "email": "NODE_OPTIONS='--require dotenv/config' DOTENV_CONFIG_QUIET=true email dev --dir components/emails --port 3002"
  },
