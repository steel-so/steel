{
	"name": "@steel-so/n8n-nodes-steel",
	"version": "0.1.0",
	"description": "Nós do n8n para o Steel: gatilhos de webhook e ações sobre a API pública v1 (ServiceDesk, CRM e Comunicação)",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"steel",
		"servicedesk",
		"crm",
		"whatsapp"
	],
	"license": "UNLICENSED",
	"packageManager": "pnpm@10.33.2",
	"homepage": "https://github.com/steel-so/steel/tree/main/integrations/n8n",
	"author": {
		"name": "Stratus Telecom",
		"email": "dev@stratustelecom.com.br"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/steel-so/steel.git",
		"directory": "integrations/n8n"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check:bundle": "node scripts/check-bundle.cjs"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SteelApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Steel/Steel.node.js",
			"dist/nodes/SteelTrigger/SteelTrigger.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@steel-so/sdk": "0.1.2",
		"@types/node": "24.19.1",
		"@vitest/coverage-v8": "5.0.3",
		"n8n-workflow": "2.44.2",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	}
}
