# Node
NODE_ENV=development

# DB Config
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/DB_NAME
# App replicas (ADR 0038, docs/runbooks/app-replicas.md). Optional runtime
# connection through PgBouncer (transaction mode, compose profile `pooler`);
# unset = straight to Postgres. Migrations and backups keep DATABASE_URL.
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@steel-pgbouncer:5432/DB_NAME
# Connections in each process' pg pool (every replica, worker, realtime). Default 10.
# DB_POOL_MAX=10

# Redis Config
REDIS_URL=redis://:PASSWORD@localhost:6380
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=steel-sentinel-1:26379,steel-sentinel-2:26379,steel-sentinel-3:26379
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINEL_PASSWORD=

# Wiki realtime (Hocuspocus — `pnpm realtime:dev`). The browser connects to
# NEXT_PUBLIC_REALTIME_URL; unset = same origin `/realtime` (nginx in prod).
REALTIME_PORT=1235
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1235

# Services Config
MINIO_ENDPOINT=http://localhost:9002
# Publicly reachable base URL for objects in public buckets. Only needed when
# MINIO_ENDPOINT points to a host unreachable from browsers/external
# providers (e.g. an internal Docker service name in production) — defaults
# to MINIO_ENDPOINT otherwise, which is fine for local dev.
# MINIO_PUBLIC_URL=
MINIO_USER=
MINIO_PASSWORD=

# Auth Config
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Versioned secrets for OAuth-token encryption at rest (account.encryptOAuthTokens).
# Format: "<version>:<secret>[,<version>:<secret>]" — first entry is the current key.
# Keep old versions in the list until all encrypted payloads have rotated.
# Generate a secret: openssl rand -hex 32
# BETTER_AUTH_SECRETS=1:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Config
RESEND_API_KEY=
# Resend webhook signing secret (whsec_...) — optional: delivery/bounce/
# complaint events of CRM multichannel campaigns. Point the Resend webhook to
# /api/crm/campaigns/resend-webhook.
RESEND_WEBHOOK_SECRET=

# Axiom — opcional. Deixe vazio na máquina local: sem token/dataset o logger
# só escreve no console e o dataset do deploy não recebe logs locais/de teste.
NEXT_PUBLIC_AXIOM_TOKEN=
NEXT_PUBLIC_AXIOM_DATASET=
# Admin Analytics (/admin/analytics) — see docs/admin-analytics.md.
# API token with Query-only permission on the dataset above (Axiom →
# Settings → API tokens → New). Empty = the panel shows the setup steps.
AXIOM_QUERY_TOKEN=
# Query API base URL (default https://api.axiom.co).
# AXIOM_QUERY_URL=https://api.axiom.co
# Dev only: serve simulated analytics data (ignored in production).
# ANALYTICS_FIXTURES=true

# Steel Canvas playground (/<workspace>/canvas-lab). Always on outside
# production; in production only when 'true' (staging, screenshots).
# CANVAS_LAB=true
# Root domain of the published sites: <slug>.<SITES_ROOT_DOMAIN> is served by
# /s/<slug> (needs a wildcard DNS record and certificate). Optional: without
# it sites live only at /s/<slug> on the app domain.
# SITES_ROOT_DOMAIN=sites.steel.app
# MaxMind GeoLite2 City database for country/city on request logs (the IP is
# never stored). Missing file = enrichment skipped silently.
# GEOIP_DB_PATH=/var/lib/geoip/GeoLite2-City.mmdb

# Icons
HUGEICONS_TOKEN=

# Status Page
# Header secret for the manual triggers POST /api/status/collect/{core,peripheral}.
# The worker collects on its own (core every 1 min, peripheral every 5 min).
STATUS_COLLECTOR_SECRET=
# Base URL the worker probes for the "app" component (GET /api/status).
# Defaults to BETTER_AUTH_URL. In production, inside the Docker network:
# STATUS_APP_PROBE_URL=http://nextjs-app:3000

# Slack alerts (optional) -- Incoming Webhook of the #alerts channel: status
# component transitions and background job deaths. Unset disables alerts
# (logged no-op). On the server the deploy appends it from the
# SLACK_ALERTS_WEBHOOK_URL GitHub secret.
# SLACK_ALERTS_WEBHOOK_URL=

# Versioned secrets for workspace module-connection credential encryption at rest
# (WorkspaceModuleConnection.encryptedPassword). Same format/rotation story as
# BETTER_AUTH_SECRETS above, kept as its own secret so the two domains rotate
# independently. Generate a secret: openssl rand -hex 32
# CONNECTION_SECRETS=1:

# Billing (AbacatePay) — off by default. With BILLING_ENABLED=false the
# checkout, coupons, webhook, upgrade CTAs and the "payment" status probe are
# disabled and the two AbacatePay credentials below are optional; set it to
# true (and fill both credentials) to turn billing back on.
BILLING_ENABLED=false
ABACATE_PAY=
ABACATE_PAY_WEBHOOK_SECRET=
# API v2 webhook: register https://<host>/api/payment/webhook?webhookSecret=<this value>
# at AbacatePay; the body signature (X-Webhook-Signature) is checked too.
# Override only if AbacatePay moves the subscription-cancellation route.
# Defaults to /subscriptions/cancel (see lib/abacatepay.ts).
# ABACATE_PAY_CANCEL_PATH=/subscriptions/cancel

# Account Lifecycle
# Optional dev/staging override (in ms) for the 30-day account deletion
# grace period. Ignored in tests. Example: 60000 = 1 minute.
# ACCOUNT_DELETION_GRACE_OVERRIDE_MS=

# Workbench dashboard auth (/jobs — queue dashboard). Use strong values
# outside local dev: empty values leave the dashboard without basic auth.
WORKBENCH_USER=admin
WORKBENCH_PASS=pass

# Test/e2e switches (leave unset in production)
# Disables only better-auth's built-in rate limiter (the app keeps its own).
# DISABLE_AUTH_RATE_LIMIT=true
# Never sends e-mail through Resend (dry-run log only).
# MAIL_DRY_RUN=true

# Off-site backup copy (S3-compatible: Backblaze B2, Cloudflare R2, AWS S3...)
# The daily FULL backup (03:15) is copied here after it lands on MinIO. Leave
# ENDPOINT/BUCKET/keys empty to disable (the worker only logs a warning).
# BACKUP_OFFSITE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# BACKUP_OFFSITE_REGION=us-east-005
# BACKUP_OFFSITE_BUCKET=steel-backups-offsite
# BACKUP_OFFSITE_ACCESS_KEY_ID=
# BACKUP_OFFSITE_SECRET_ACCESS_KEY=
# Key prefix inside the bucket (default: steel/)
# BACKUP_OFFSITE_PREFIX=steel/
# true for providers that need path-style URLs (MinIO, some B2 setups)
# BACKUP_OFFSITE_FORCE_PATH_STYLE=false
# Provider-side encryption at rest (SSE-S3 AES256). Default true; set false
# only if the provider rejects the header (payload is already app-encrypted).
# BACKUP_OFFSITE_SSE=true
# Days to keep off-site copies (default 90, same as the local backups)
# BACKUP_OFFSITE_RETENTION_DAYS=90

# WhatsApp (Meta Cloud API webhook)
# Arbitrary string you choose; must match the "Verify Token" configured on the
# Meta app's webhook settings. Generate one: openssl rand -hex 24
WHATSAPP_META_VERIFY_TOKEN=
# From the Meta app dashboard: App Settings > Basic > App Secret
WHATSAPP_META_APP_SECRET=
# Optional: Meta app id (App Settings > Basic), used to upload the media header
# of new templates. Empty = resolved from each connection's access token.
WHATSAPP_META_APP_ID=
# WhatsApp Embedded Signup ("Conectar com a Meta" on the zap connections
# screen). Build-time values: also GitHub Secrets / build-args. Both empty =
# button hidden. The server exchange also needs WHATSAPP_META_APP_ID (or the
# public app id below) and WHATSAPP_META_APP_SECRET. See
# docs/adr/0030-whatsapp-embedded-signup.md.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Jitsi domain used for video calls started from a conversation. Defaults to
# the public meet.jit.si if unset.
# JITSI_DOMAIN=meet.jit.si
# PABX click-to-call from a WhatsApp conversation (button "Ligar"). Each user
# device is its own PABX: address (ip1ext) and token are read from the central
# MariaDB `steel.device` table. Without the database URL the button answers 503.
PABX_DEVICE_DB_URL=
# Dialer endpoint on each PABX; {host} is the device ip1ext.
# PABX_ENDPOINT_TEMPLATE=http://{host}:4561/steel_call_endpoint.php
# Browser calling (WebRTC): endpoint that hands out the extension's SIP credentials.
# PABX_WEBPHONE_ENDPOINT_TEMPLATE=http://{host}:4561/steel_webphone_endpoint.php
# Status webhook the PABX dialplan calls (default: BETTER_AUTH_URL + /api/pabx/calls/webhook).
# PABX_CALLBACK_URL=
# Pix in the WhatsApp conversation: PSP (only `mock` for now) and the HMAC-SHA256
# secret (min 16 chars) that signs POST /api/whatsapp/pix/webhook/<provider>.
# BOLETO_PROVIDER=mock         # or `abacatepay`; BOLETO_WEBHOOK_SECRET (min 16) is the
# `webhookSecret` of .../api/boleto/webhook/<provider>?webhookSecret=<secret>
# PIX_PROVIDER=mock            # or `abacatepay` (uses ABACATE_PAY as API key)
# With `abacatepay`, PIX_WEBHOOK_SECRET is the `webhookSecret` query param of the
# webhook URL registered at AbacatePay:
#   https://<host>/api/whatsapp/webhook/pix/abacatepay?webhookSecret=<secret>
# PIX_WEBHOOK_SECRET=
# IVR voice attendant (ADR 0046): TCP port where the worker listens for the
# Asterisk AudioSocket. Unset = the attendant is not served. Allow only the
# PABX address in the firewall.
# VOICE_AGENT_AUDIOSOCKET_PORT=8090
# VOICE_AGENT_AUDIOSOCKET_HOST=0.0.0.0
# Host IP the compose publishes the port on (default 127.0.0.1 = closed). Set it
# to the private IP the PABX reaches and allow only the PABX in the firewall.
# VOICE_AGENT_AUDIOSOCKET_BIND=127.0.0.1
# Realtime model of the attendant (default: gpt-realtime). Uses OPENAI_API_KEY.
# VOICE_AGENT_REALTIME_MODEL=gpt-realtime

# Novidades por e-mail a partir da última release do GitHub (admin → Changelog).
# Opcional: token fine-grained com "Contents: read" no repositório. Sem token só
# funciona com repositório público; colar as notas à mão funciona sempre.
# GITHUB_RELEASES_TOKEN=
# GITHUB_RELEASES_REPO=steel-so/steel

# ServiceDesk · integração com o Slack (opcional)
# App do Slack (api.slack.com/apps) usado por todos os workspaces: cada
# workspace conecta o próprio Slack por OAuth e o token fica cifrado no banco
# com CONNECTION_SECRETS. Sem estas três vars a aba Integrações avisa que o
# Slack não está configurado — nada é enviado nem recebido.
# Basic Information > App Credentials
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# Assina todo request que o Slack manda (eventos, atalhos, slash commands).
# SLACK_SIGNING_SECRET=
# Redirect URL a cadastrar em OAuth & Permissions:
#   <BETTER_AUTH_URL>/api/servicedesk/integrations/oauth/slack
# Request URL de Event Subscriptions e de Interactivity & Shortcuts:
#   <BETTER_AUTH_URL>/api/servicedesk/integrations/slack
# Escopos de bot: chat:write, chat:write.public, channels:read, groups:read,
# channels:history, groups:history, commands, users:read, users:read.email
#
# ServiceDesk · integração com o GitHub: não usa variável de ambiente — cada
# workspace cadastra o repositório, o token (PAT fine-grained) e o segredo do
# webhook na aba Integrações; o webhook do repositório aponta para
#   <BETTER_AUTH_URL>/api/servicedesk/integrations/github
#
# -----------------------------------------------------------------------------
# Observabilidade de produto e de erro (Sentry + PostHog)
# -----------------------------------------------------------------------------
# As duas são OPCIONAIS e inertes quando não configuradas: sem chave, o SDK
# nunca é carregado, nenhum chunk é buscado e nada vai para a rede — o app sobe
# igual, sem erro e sem log de pânico (mesmo contrato de
# src/lib/storage/offsite-backup.ts). O Axiom (log, auditoria LGPD, painel de
# analytics do admin) e o Google Analytics continuam valendo em paralelo.
#
# ATENÇÃO, DEPLOY: as cinco NEXT_PUBLIC_* abaixo são de BUILD TIME. Conferido
# no navegador com build de produção: um DSN posto só neste arquivo, no
# servidor, chega ao servidor, ao edge e à CSP do proxy.ts, mas NÃO ao
# navegador (`window.__SENTRY__` indefinido, nenhuma ingestão depois de um erro
# não tratado). A chave do PostHog é lida pelo próprio next.config.ts para
# montar o rewrite de /ingest, o que é build time por definição. Por isso elas
# entram como build-args no Dockerfile e vêm de GitHub Secrets no cd.yml —
# mudar só o .env do servidor não habilita o lado do navegador.
#
# PostHog (analytics de produto). Entra atrás do banner de cookies: sem
# consentimento, nada carrega (app/_components/user/cookie-consent).
# O navegador fala com /ingest na nossa própria origem, que o next.config.ts
# reescreve para NEXT_PUBLIC_POSTHOG_HOST — assim a CSP não ganha origem nova
# (ADR 0011). Project Settings > Project API Key.
# NEXT_PUBLIC_POSTHOG_KEY=phc_
# Região do projeto (a chave só funciona na dela). Default: us.i.posthog.com.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Sentry (rastreamento de erro no servidor, no edge e no cliente). Só o DSN é
# necessário em runtime; o proxy.ts deriva dele a origem de ingestão que entra
# no connect-src da CSP. Settings > Projects > <projeto> > Client Keys (DSN).
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o0.ingest.de.sentry.io/0
# Release que a issue vai apontar (o CD passa o SHA do git).
# NEXT_PUBLIC_SENTRY_RELEASE=
# Nome do ambiente no Sentry; sem isto, vale NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
#
# Credenciais de BUILD do Sentry — só servem para subir source maps, o que
# acontece apenas no build de imagem do CD. Sem as três o plugin fica inerte e
# o build segue. SENTRY_AUTH_TOKEN é credencial: fica no SOPS, nunca aqui.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Server Actions encryption key — BUILD time (Dockerfile BuildKit secret, from
# the GitHub secret of the same name): every replica and every deploy decrypt
# the same Server Action closures. Unset = Next generates one per build.
# Generate: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Budget (ms) of each Redis call of the shared-tag 'use cache' handler
# (lib/next-cache). Default 150.
# NEXT_CACHE_TAGS_TIMEOUT_MS=150

# Web search of the CRM prospecting agent (Brave Search API key). Without it the
# agent can still read pages by URL, but cannot search. The feature itself is
# off per workspace until an admin turns it on in CRM > Prospecção.
# WEB_SEARCH_API_KEY=
