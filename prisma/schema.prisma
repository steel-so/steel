  icsUrlEnc    String?   @map("ics_url_enc")
  icsCheckedAt DateTime? @map("ics_checked_at")
  icsLastError String?   @map("ics_last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("crm_meeting_availabilities")
}

model CrmMeetingBooking {
  id                 String                  @id @default(cuid())
  workspaceId        String                  @map("workspace_id")
  pageId             String                  @map("page_id")
  hostUserId         String                  @map("host_user_id")
  startsAt           DateTime                @map("starts_at")
  endsAt             DateTime                @map("ends_at")
  status             CrmMeetingBookingStatus @default(CONFIRMED)
  guestName          String                  @map("guest_name")
  guestEmail         String                  @map("guest_email")
  guestPhone         String?                 @map("guest_phone")
  guestNotes         String?                 @map("guest_notes")
  guestTimezone      String                  @map("guest_timezone")
  leadId             String?                 @map("lead_id")
