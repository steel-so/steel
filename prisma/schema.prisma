  sdKbComments              SdKbComment[]              @relation("SdKbCommentAuthor")
  sdKbCommentsResolved      SdKbComment[]              @relation("SdKbCommentResolver")
  sdAiConversations         SdAiConversation[]         @relation("SdAiConversationUser")
  sdMailboxesCreated        SdMailbox[]                @relation("SdMailboxCreatedBy")
  sdMonitorSourcesCreated   SdMonitorSource[]          @relation("SdMonitorSourceCreatedBy")
  sdPortalAccessesSent      SdPortalAccess[]           @relation("SdPortalAccessRequestedBy")
  sdNotificationPreferences SdNotificationPreference[] @relation("SdNotificationPreferenceUser")
  sdTicketsFollowed         SdTicketFollower[]         @relation("SdTicketFollowerUser")
  sdContractsCreated        SdContract[]               @relation("SdContractCreatedBy")
  sdContractPeriodsClosed   SdContractPeriod[]         @relation("SdContractPeriodClosedBy")
  sdTimeEntries             SdTimeEntry[]              @relation("SdTimeEntryUser")
  sdChangeWindowsCreated    SdChangeWindow[]           @relation("SdChangeWindowCreatedBy")
  sdCabBoardsCreated        SdCabBoard[]               @relation("SdCabBoardCreatedBy")
  sdCabMemberships          SdCabMember[]              @relation("SdCabMemberUser")
  sdApprovalRoundsRequested SdApprovalRound[]          @relation("SdApprovalRoundRequestedBy")
  sdOnCallSchedulesCreated  SdOnCallSchedule[]         @relation("SdOnCallScheduleCreatedBy")
  sdOnCallParticipations    SdOnCallParticipant[]      @relation("SdOnCallParticipantUser")
  sdOnCallOverridesTaken    SdOnCallOverride[]         @relation("SdOnCallOverrideUser")
  sdOnCallOverridesCreated  SdOnCallOverride[]         @relation("SdOnCallOverrideCreatedBy")
  sdRecurringTicketsCreated SdRecurringTicket[]        @relation("SdRecurringTicketCreatedBy")
  sdScheduledReportsCreated SdScheduledReport[]        @relation("SdScheduledReportCreatedBy")
