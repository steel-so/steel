// nov: health-scores ───────────────────────────────────────────────────────

/// Risk band of a health score. Same cuts as the ServiceDesk predictive risk
/// (`SD_RISK_THRESHOLDS`, ADR 0016): MEDIUM >= 40, HIGH >= 70.
enum CrmHealthLevel {
  LOW
  MEDIUM
  HIGH
}

/// Explainable churn-risk index of a CRM company (T4). One row per company,
/// recomputed by the `crm-health` worker queue and on demand.
model CrmCustomerHealth {
  id            String          @id @default(cuid())
  workspaceId   String          @map("workspace_id")
  companyId     String          @unique @map("company_id")
  /// 0-100, higher = more risk. The UI shows `100 - riskScore` as "saúde".
  riskScore     Int             @map("risk_score")
  level         CrmHealthLevel
  /// [{"key","label","points","max","detail"}] of the factors that scored.
  factors       Json            @default("[]")
  /// Labels of the factors skipped for lack of data (no zap, no ServiceDesk).
  missing       Json            @default("[]")
  /// {"key","label","detail"}.
  nextAction    Json            @map("next_action")
  /// Raw counters the factors were computed from (audit trail).
  signals       Json            @default("{}")
  previousScore Int?            @map("previous_score")
  previousLevel CrmHealthLevel? @map("previous_level")
  computedAt    DateTime        @default(now()) @map("computed_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, level, riskScore])
  @@index([workspaceId, computedAt])
  @@map("crm_customer_health")
}

/// Per-deal version of the health index (C4): only open deals have a row.
model CrmOpportunityHealth {
  id            String          @id @default(cuid())
  workspaceId   String          @map("workspace_id")
  opportunityId String          @unique @map("opportunity_id")
  riskScore     Int             @map("risk_score")
  level         CrmHealthLevel
  factors       Json            @default("[]")
  nextAction    Json            @map("next_action")
  signals       Json            @default("{}")
  previousScore Int?            @map("previous_score")
  previousLevel CrmHealthLevel? @map("previous_level")
  computedAt    DateTime        @default(now()) @map("computed_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([workspaceId, level, riskScore])
  @@index([workspaceId, computedAt])
  @@map("crm_opportunity_health")
}

// nov: crm-ops

enum CrmDuplicateEntity {
  PERSON
  COMPANY
}

enum CrmDuplicateStatus {
  PENDING
  MERGED
  DISMISSED
}

/// A pair of CRM records the detector believes are the same entity. The pair
/// is stored once, ordered (`leftId` < `rightId`), so a rescan only refreshes
/// it; a DISMISSED pair is never proposed again.
model CrmDuplicateCandidate {
  id           String             @id @default(cuid())
  workspaceId  String             @map("workspace_id")
  entity       CrmDuplicateEntity
  leftId       String             @map("left_id")
  rightId      String             @map("right_id")
  /// 0-100. 100 = same CNPJ / e-mail, lower for fuzzy name only.
  score        Int
  /// Machine reasons: `email`, `phone`, `name`, `cnpj`, `domain`.
  reasons      String[]           @default([])
  status       CrmDuplicateStatus @default(PENDING)
  detectedAt   DateTime           @default(now()) @map("detected_at")
  lastSeenAt   DateTime           @default(now()) @map("last_seen_at")
  /// Set once the owners were told about the pair (one notice per scan).
  notifiedAt   DateTime?          @map("notified_at")
  resolvedAt   DateTime?          @map("resolved_at")
  resolvedById String?            @map("resolved_by_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entity, leftId, rightId])
  @@index([workspaceId, entity, status, score])
  @@map("crm_duplicate_candidates")
}

/// One merge, with everything needed to undo it inside the window: the
/// archived record, what the survivor looked like and which child rows moved.
model CrmMergeLog {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  entity        CrmDuplicateEntity
  survivorId    String             @map("survivor_id")
  mergedId      String             @map("merged_id")
  candidateId   String?            @map("candidate_id")
  performedById String             @map("performed_by_id")
  snapshot      Json
  createdAt     DateTime           @default(now()) @map("created_at")
  undoUntil     DateTime           @map("undo_until")
  undoneAt      DateTime?          @map("undone_at")
  undoneById    String?            @map("undone_by_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([survivorId])
  @@index([mergedId])
  @@map("crm_merge_logs")
}

enum CrmMeetingBookingStatus {
  CONFIRMED
  CANCELED
}

/// Public booking page (`/m/<slug>`): who can be booked, for how long and how
/// far ahead. With more than one host the page does round-robin.
model CrmMeetingPage {
  id               String               @id @default(cuid())
  workspaceId      String               @map("workspace_id")
  slug             String               @unique
  title            String
  description      String?
  durationMinutes  Int                  @default(30) @map("duration_minutes")
  bufferMinutes    Int                  @default(0) @map("buffer_minutes")
  minNoticeMinutes Int                  @default(120) @map("min_notice_minutes")
  maxDaysAhead     Int                  @default(30) @map("max_days_ahead")
  slotStepMinutes  Int                  @default(30) @map("slot_step_minutes")
  /// IANA zone the page is shown in by default.
  timezone         String               @default("America/Sao_Paulo")
  format           CrmLeadMeetingFormat @default(ONLINE)
  /// Video-call link or address, sent in the confirmation.
  location         String?
  /// Minutes before the start the reminder e-mail goes out (0 = no reminder).
  reminderMinutes  Int                  @default(60) @map("reminder_minutes")
  /// Source stamped on the lead created by a booking.
  leadSource       String               @default("Agendamento de reunião") @map("lead_source")
  active           Boolean              @default(true)
  createdById      String               @map("created_by_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  hosts     CrmMeetingHost[]
  bookings  CrmMeetingBooking[]

  @@index([workspaceId, deletedAt])
  @@map("crm_meeting_pages")
}

model CrmMeetingHost {
  id             String    @id @default(cuid())
  pageId         String    @map("page_id")
  userId         String    @map("user_id")
  position       Int       @default(0)
  /// Round-robin cursor: the host booked longest ago goes first.
  lastAssignedAt DateTime? @map("last_assigned_at")

  page CrmMeetingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
  @@map("crm_meeting_hosts")
}

/// Weekly working hours of a seller (and the optional secret iCal feed of
/// their Google/Outlook calendar, encrypted) in the seller's own time zone.
model CrmMeetingAvailability {
