/// Uma seção da página, escolhida e ordenada pelo usuário a partir do
/// vocabulário fixo de tipos. Sem unique em (landingPageId, type): o mesmo
/// tipo pode se repetir (o kit de referência tem templates com 2 blocos de
/// Testimonial). `content` segue um shape estruturado por `type`
/// (discriminated union no Zod), nunca HTML livre.
model CrmLandingPageSection {
  id            String                    @id @default(cuid())
  landingPageId String                    @map("landing_page_id")
