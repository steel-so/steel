  maintenance SdStatusMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  page        SdStatusPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([maintenanceId, pageId])
  @@index([pageId])
  @@index([workspaceId])
  @@map("sd_status_maintenance_pages")
}

// nov: ai-governance

/// A6 + A8: governance of the Steel Agents of a workspace. One row per
/// workspace, created on demand. `killedAt` is the emergency switch (no agent
/// runs while it is set); the restrict flags turn on who may create agents and
/// which tools each role may run in AUTO mode (off = RBAC only, as before).
model SteelAgentPolicy {
  id               String    @id @default(cuid())
  workspaceId      String    @unique @map("workspace_id")
  killedAt         DateTime? @map("killed_at")
  killedById       String?   @map("killed_by_id")
  killReason       String?   @map("kill_reason") @db.Text
  restrictCreators Boolean   @default(false) @map("restrict_creators")
  creatorRoles     Role[]    @map("creator_roles")
  restrictAuto     Boolean   @default(false) @map("restrict_auto")
  /// `{ [role]: { mode: 'ALL' | 'NONE' | 'LIST', tools: string[] } }`
  autoRules        Json?     @map("auto_rules")
  updatedById      String?   @map("updated_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("steel_agent_policies")
}

/// A7: an agent may call `targetAgentId` as a tool.
model SteelAgentDelegate {
  id            String   @id @default(cuid())
  agentId       String   @map("agent_id")
  targetAgentId String   @map("target_agent_id")
  createdAt     DateTime @default(now()) @map("created_at")

  agent  SteelAgent @relation("SteelAgentDelegator", fields: [agentId], references: [id], onDelete: Cascade)
  target SteelAgent @relation("SteelAgentDelegateTarget", fields: [targetAgentId], references: [id], onDelete: Cascade)

  @@unique([agentId, targetAgentId])
  @@index([targetAgentId])
  @@map("steel_agent_delegates")
}

/// A8: external MCP server (Streamable HTTP) the workspace's agents may call.
/// The auth header value is encrypted with CONNECTION_SECRETS and never
/// returned. `toolsCache` is what the last discovery found; `allowedTools`
/// is the allow-list (an empty list exposes nothing).
model SteelMcpServer {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  name               String
  /// Prefix of the tool names (`mcp_<slug>__<tool>`), unique per workspace.
  slug               String
  url                String
  authHeaderName     String    @default("Authorization") @map("auth_header_name")
  encryptedAuthValue String?   @map("encrypted_auth_value") @db.Text
  enabled            Boolean   @default(true)
  allowedTools       String[]  @map("allowed_tools")
  toolsCache         Json?     @map("tools_cache")
  discoveredAt       DateTime? @map("discovered_at")
  lastError          String?   @map("last_error") @db.Text
  createdById        String?   @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("steel_mcp_servers")
}

