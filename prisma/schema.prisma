generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  username             String               @unique
  emailVerified        Boolean              @default(false) @map("email_verified")
  image                String?
  coverImage           String?              @map("cover_image")
  twoFactorEnabled     Boolean              @default(false) @map("two_factor_enabled")
  /// Aplicativo autenticador (TOTP) confirmado por esta conta. O
  /// `twoFactorEnabled` acima é o interruptor único do plugin do better-auth
  /// e vale para os dois métodos; este campo registra que o usuário realmente
  /// escaneou o QR e digitou um código que o app gerou. Sem ele a interface
  /// não tem como distinguir "tem 2FA por e-mail" de "tem aplicativo", e
  /// ofereceria a etapa do autenticador a quem nunca escaneou nada.
  twoFactorTotpEnabled Boolean              @default(false) @map("two_factor_totp_enabled")
  isPlatformAdmin      Boolean              @default(false) @map("is_platform_admin")
  /// PABX extension used by click-to-call from a WhatsApp conversation. Set by
  /// the user in the profile modal, together with `pabxDeviceId`.
  pabxExtension        String?              @map("pabx_extension") @db.VarChar(20)
  /// PABX device (`iddevice` of the dialer endpoint) bound to the extension.
  pabxDeviceId         String?              @map("pabx_device_id") @db.VarChar(20)
  /// Browser calling (WebRTC) is allowed for this extension/device. Only an
  /// administrator sets it (SQL/admin); editing the extension or the device
  /// resets it, because the call hands the extension's SIP secret to the browser.
  pabxWebphoneEnabled  Boolean              @default(false) @map("pabx_webphone_enabled")
  deletionScheduledAt  DateTime?            @map("deletion_scheduled_at")
  acceptedTermsAt      DateTime?            @map("accepted_terms_at")
  acceptedPrivacyAt    DateTime?            @map("accepted_privacy_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  onboardingStep       OnboardingStep?      @default(PROFILE) @map("onboarding_step")
  role                 UserRole?            @map("role")
  goals                UserGoal[]           @map("goals")
  preference           UserPreference?
  notificationSetting  NotificationSetting?

  memberships              Membership[]
  sessions                 Session[]
  accounts                 Account[]
  twoFactors               TwoFactor[]
  shortLinks               ShortLink[]
  stickyNotes              StickyNote[]
  createdWikiPages         WikiPage[]                  @relation("WikiPageAuthor")
  updatedWikiPages         WikiPage[]                  @relation("WikiPageEditor")
  lockedWikiPages          WikiPage[]                  @relation("WikiPageLocker")
  wikiPageFavorites        WikiPageFavorite[]
  wikiComments             WikiComment[]               @relation("WikiCommentAuthor")
  resolvedWikiComments     WikiComment[]               @relation("WikiCommentResolver")
  createdWhiteboards       Whiteboard[]                @relation("WhiteboardAuthor")
  updatedWhiteboards       Whiteboard[]                @relation("WhiteboardEditor")
  lockedWhiteboards        Whiteboard[]                @relation("WhiteboardLockHolder")
  whiteboardVersions       WhiteboardVersion[]         @relation("WhiteboardVersionAuthor")
  consentEvents            ConsentEvent[]
  projectsLed              Project[]                   @relation("ProjectLead")
  projectMemberships       ProjectMember[]
  projectFavourites        ProjectFavorite[]
  sentInvitations          WorkspaceInvitation[]       @relation("SentInvitations")
  moduleConnectionsCreated WorkspaceModuleConnection[]
  moduleAccessGranted      WorkspaceModuleAccess[]
  featureOverridesSet      WorkspaceFeatureOverride[]

  changelogsCreated  Changelog[]
  changelogRecipient ChangelogRecipient[]

  whatsappConnectionsCreated          WhatsAppConnection[]          @relation("WhatsAppConnectionCreatedBy")
  whatsappConversationsAssigned       WhatsAppConversation[]        @relation("WhatsAppConversationAssignee")
  whatsappTeamMemberships             WhatsAppTeamMember[]
  whatsappMessagesSent                WhatsAppMessage[]             @relation("WhatsAppMessageSender")
  whatsappBroadcastsCreated           WhatsAppBroadcastList[]       @relation("WhatsAppBroadcastCreatedBy")
  whatsappGroupMessagesSent           WhatsAppGroupMessage[]        @relation("WhatsAppGroupMessageSender")
  whatsappAiKnowledgeDocumentsCreated WhatsAppAiKnowledgeDocument[] @relation("WhatsAppAiKnowledgeDocumentCreatedBy")
  whatsappConversationEventsActed     WhatsAppConversationEvent[]   @relation("WhatsAppConversationEventActor")
