  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS

  @@map("workspace_company_size")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  workspaceId String   @map("workspace_id")
  role        Role     @default(MEMBER)
  profileId   String?  @map("profile_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([profileId])
  @@map("memberships")
}

/// Perfil de acesso (RBAC) — mapa recurso→ações. Perfis de sistema
/// (OWNER/ADMIN/MEMBER) são semeados por workspace (lazy) e preservam o
/// comportamento anterior aos perfis customizados.
model Profile {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  isSystem    Boolean  @default(false) @map("is_system")
  systemKey   String?  @map("system_key")
  permissions Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("profiles")
}

model Subscription {
  id          String             @id @default(cuid())
  billId      String             @unique @map("bill_id")
  plan        Plan
  status      SubscriptionStatus @default(PENDING)
  amount      Int
  seats       Int                @default(1)
  interval    BillingInterval    @default(MONTHLY)
  coupon      String?
  paymentUrl  String             @map("payment_url")
  workspaceId String             @map("workspace_id")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("subscriptions")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model WorkspaceInvitation {
  id          String       @id @default(cuid())
  email       String
  role        Role         @default(MEMBER)
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime     @map("expiresa_at")
  invitedById String       @map("invited_by_id")
  workspaceId String       @map("workspace_id")
  projectId   String?      @map("project_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invitations")
}

