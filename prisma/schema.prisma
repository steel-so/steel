/// Entitlement de módulo por workspace, controlado pelo painel admin
/// global. Sem registro para um módulo, ele fica indisponível — é opt-in,
/// não opt-out (evita expor CRM/WhatsApp/ServiceDesk por omissão).
model WorkspaceModuleAccess {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  module      ModuleKind
  enabled     Boolean    @default(true)
  grantedById String     @map("granted_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy User      @relation(fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, module])
  @@index([workspaceId])
  @@map("workspace_module_access")
}

/// Override de feature flag por workspace (catálogo em src/config/features.ts),
/// definido pelo admin global. Sem registro, vale o default do plano. `key`
/// é texto livre de propósito: chaves aposentadas do catálogo ficam órfãs e
/// são ignoradas, sem precisar de migration.
model WorkspaceFeatureOverride {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  key         String
  enabled     Boolean
  note        String?
  expiresAt   DateTime? @map("expires_at")
  /// Admin que fez a última alteração. SetNull: a customização do cliente
  /// sobrevive à exclusão da conta do admin.
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("workspace_feature_overrides")
}

/// Agregado diário de uso por workspace × módulo, para o painel de métricas
/// do admin global. Alimentado sem tocar nos services: o wrapper `withAxiom`
/// conta cada resposta de sucesso das rotas `/api/workspaces/:id/{crm,whatsapp}`
/// num hash do Redis e o job `usage-rollup` do worker grava aqui os totais do
/// dia (valor absoluto, idempotente). `day` é a data em America/Sao_Paulo.
model ModuleUsageDaily {
  id          String     @id @default(cuid())
  day         DateTime   @db.Date
  workspaceId String     @map("workspace_id")
  module      ModuleKind
  /// Requisições bem-sucedidas (leitura + escrita).
  requests    Int        @default(0)
  /// Só as de escrita (POST/PUT/PATCH/DELETE) — as "ações" no módulo.
  mutations   Int        @default(0)
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([day, workspaceId, module])
  @@index([workspaceId])
  @@index([day])
  @@map("module_usage_daily")
}

// ─── Backups ────────────────────────────────────────────────────────────────

enum BackupScope {
  FULL
  WORKSPACE

  @@map("backup_scope")
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("backup_status")
}

model Backup {
  id              String       @id @default(cuid())
  scope           BackupScope
  /// Sem FK de propósito: o registro (e o objeto no MinIO) precisa sobreviver
  /// à exclusão do workspace — é justamente o ponto de restauração dela.
  workspaceId     String?      @map("workspace_id")
  /// Snapshot do slug na hora do backup (o workspace pode não existir mais).
  workspaceSlug   String?      @map("workspace_slug")
  /// Admin que disparou pelo painel (`null` = cron/CLI/sistema).
  triggeredById   String?      @map("triggered_by_id")
  status          BackupStatus @default(RUNNING)
  storageKey      String?      @map("storage_key")
  sizeBytes       Int?         @map("size_bytes")
  checksum        String?
  /// Backup WORKSPACE: manifesto (cifrado) dos arquivos do MinIO copiados
  /// junto com as linhas. `null` = backup só de banco (antes de 19/09/2026).
  filesKey        String?      @map("files_key")
  fileCount       Int?         @map("file_count")
  /// Soma dos bytes em claro dos arquivos — `BigInt` porque a mídia de um
  /// workspace passa fácil dos 2 GB.
  fileBytes       BigInt?      @map("file_bytes")
  errorMessage    String?      @map("error_message")
  /// Chave da cópia offsite, gravada quando o `copy-to-offsite` confirma.
  offsiteKey      String?      @map("offsite_key")
  offsiteCopiedAt DateTime?    @map("offsite_copied_at")
  startedAt       DateTime     @default(now()) @map("started_at")
  completedAt     DateTime?    @map("completed_at")
  expiresAt       DateTime?    @map("expires_at")

  @@index([scope, startedAt])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("backups")
}

// ─── Painel admin global ────────────────────────────────────────────────────

/// Registro append-only das ações do admin global. Sem FK para workspace ou
/// usuário: precisa sobreviver à exclusão do alvo (trilha LGPD). Espelha o
/// `auditMutation` (Axiom) para o painel poder listar sem depender do Axiom.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  actorEmail  String   @map("actor_email")
  /// `<alvo>.<ação>`, ex.: `workspace.suspend`, `backup.restore_requested`.
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  /// Nome/slug legível do alvo na hora da ação.
  targetLabel String?  @map("target_label")
  reason      String?
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("admin_audit_logs")
}

enum AdminOperationKind {
  WORKSPACE_DELETE
  WORKSPACE_RESTORE

  @@map("admin_operation_kind")
}

enum AdminOperationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED

  @@map("admin_operation_status")
}

/// Operação longa disparada pelo admin e executada pelo worker (exclusão e
/// restauração de workspace). Guarda o progresso (`step`) para a UI e
/// sobrevive ao workspace (sem FK).
model AdminOperation {
  id               String               @id @default(cuid())
  kind             AdminOperationKind
  status           AdminOperationStatus @default(QUEUED)
  /// Passo atual: `queued` → `backup` → `purge_database` → `purge_files` → `done`
  /// (exclusão) ou `queued` → `safety_backup` → `restore` → `done` (restore).
  step             String               @default("queued")
  workspaceId      String               @map("workspace_id")
  workspaceSlug    String               @map("workspace_slug")
  workspaceName    String               @map("workspace_name")
  backupId         String?              @map("backup_id")
  requestedById    String               @map("requested_by_id")
  requestedByEmail String               @map("requested_by_email")
  reason           String
  error            String?
  meta             Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  completedAt      DateTime?            @map("completed_at")

  @@index([workspaceId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("admin_operations")
}

// ─── WhatsApp domain ───────────────────────────────────────────────────────

enum WhatsAppProvider {
  ZAPI
  META
}

enum WhatsAppConnectionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  ERROR
}

model WhatsAppConnection {
  id                       String                   @id @default(cuid())
  workspaceId              String                   @map("workspace_id")
  provider                 WhatsAppProvider
  /// Módulo dono da conexão: COMMUNICATION (zap) ou SERVICE_DESK (chamados).
  module                   ModuleKind               @default(COMMUNICATION)
  label                    String
  phoneNumber              String                   @map("phone_number")
  status                   WhatsAppConnectionStatus @default(CONNECTING)
  statusError              String?                  @map("status_error")
  webhookSecret            String                   @unique @default(cuid()) @map("webhook_secret")
  zapiInstanceId           String?                  @map("zapi_instance_id")
  encryptedZapiToken       String?                  @map("encrypted_zapi_token")
  encryptedZapiClientToken String?                  @map("encrypted_zapi_client_token")
  metaPhoneNumberId        String?                  @map("meta_phone_number_id")
  metaWabaId               String?                  @map("meta_waba_id")
  encryptedMetaAccessToken String?                  @map("encrypted_meta_access_token")
  /// PIN de 6 dígitos usado no registro Embedded Signup (cifrado), para o suporte.
  encryptedMetaPin         String?                  @map("encrypted_meta_pin")
  /// Flat monthly fee of the line (BRL) — the Z-API instance subscription or
  /// a BSP fee. Used only by the cost analysis (ADR 0050). Null = none.
  monthlyFee               Decimal?                 @map("monthly_fee") @db.Decimal(12, 2)
  createdById              String                   @map("created_by_id")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation("WhatsAppConnectionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  conversations  WhatsAppConversation[]
  broadcastLists WhatsAppBroadcastList[]
  templates      WhatsAppTemplate[]
  groups         WhatsAppGroup[]
  aiCampaigns    WhatsAppAiCampaign[]
  costEntries    WhatsAppCostEntry[]

  @@unique([workspaceId, provider, phoneNumber])
  @@index([workspaceId])
  @@index([zapiInstanceId])
  @@index([metaPhoneNumberId])
  @@map("whatsapp_connections")
}

model WhatsAppContact {
  id                    String                @id @default(cuid())
  workspaceId           String                @map("workspace_id")
  waId                  String                @map("wa_id")
  name                  String?
  avatarUrl             String?               @map("avatar_url")
  // Freeform "about"/bio text — manually entered, no provider API exposes this.
  description           String?
  // Descadastro LGPD de transmissões (opt-out). Preenchido quando o contato
  // responde uma palavra-chave (SAIR/PARAR/STOP/CANCELAR) ou quando um admin
  // registra o pedido; nulo = recebe transmissões.
  broadcastOptedOutAt   DateTime?             @map("broadcast_opted_out_at")
  broadcastOptOutSource WhatsAppOptOutSource? @map("broadcast_opt_out_source")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  workspace            Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations        WhatsAppConversation[]
  broadcastRecipients  WhatsAppBroadcastRecipient[]
  aiCampaignRecipients WhatsAppAiCampaignRecipient[]

  @@unique([workspaceId, waId])
  @@index([workspaceId])
  @@map("whatsapp_contacts")
}

enum WhatsAppOptOutSource {
  KEYWORD
  ADMIN
  /// A IA de uma campanha registrou o pedido do contato.
  AI
}

enum WhatsAppConversationStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model WhatsAppConversation {
  id                 String                     @id @default(cuid())
  workspaceId        String                     @map("workspace_id")
  connectionId       String                     @map("connection_id")
  contactId          String                     @map("contact_id")
  status             WhatsAppConversationStatus @default(NEW)
  assignedUserId     String?                    @map("assigned_user_id")
  /// Equipe da conversa (roteamento por botão ou manual). Conversa sem
  /// responsável com equipe só aparece na fila dos membros dessa equipe.
  teamId             String?                    @map("team_id")
  aiActive           Boolean                    @default(false) @map("ai_active")
  aiHandoff          Boolean                    @default(false) @map("ai_handoff")
  unreadCount        Int                        @default(0) @map("unread_count")
  /// Média das últimas mensagens classificadas (IN) da conversa, de -1
  /// (negativo) a 1 (positivo). Nulo até a primeira classificação.
  avgSentimentScore  Float?                     @map("avg_sentiment_score")
  lastMessageAt      DateTime?                  @map("last_message_at")
  pinnedAt           DateTime?                  @map("pinned_at")
  archivedAt         DateTime?                  @map("archived_at")
  deletedAt          DateTime?                  @map("deleted_at")
  clearedAt          DateTime?                  @map("cleared_at")
  /// Quando a conversa foi fechada (status CLOSED) e o motivo opcional
  /// informado pelo atendente. Limpos ao reabrir.
  closedAt           DateTime?                  @map("closed_at")
  closeReason        String?                    @map("close_reason")
  /// Classificação do fechamento: status escolhidos pelo atendente
  /// (`WhatsAppCloseStatus`), com cópia dos rótulos para o histórico, e o
  /// resultado (FAILURE se algum status escolhido é de insucesso). Limpos ao
  /// reabrir.
  closeOutcome       WhatsAppCloseOutcome?      @map("close_outcome")
  closeStatusIds     String[]                   @default([]) @map("close_status_ids")
  closeStatusLabels  String[]                   @default([]) @map("close_status_labels")
  /// Último alerta de sentimento negativo enviado aos supervisores — base do
  /// intervalo mínimo entre alertas da mesma conversa (anti-spam).
  sentimentAlertedAt DateTime?                  @map("sentiment_alerted_at")
  /// Campanha de IA que abriu (ou reenviou para) esta conversa: a IA segue
  /// as instruções e ações dela ao responder.
  aiCampaignId       String?                    @map("ai_campaign_id")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  workspace    Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection          @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact      WhatsAppContact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?                       @relation("WhatsAppConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  team         WhatsAppTeam?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  aiCampaign   WhatsAppAiCampaign?         @relation(fields: [aiCampaignId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]
  events       WhatsAppConversationEvent[]
  phoneCalls   WhatsAppPhoneCall[]
  sdTickets    SdTicket[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, deletedAt, archivedAt, pinnedAt])
  @@index([connectionId])
  @@index([contactId])
  @@index([assignedUserId])
  @@index([teamId])
  @@index([workspaceId, closeOutcome])
  @@index([aiCampaignId])
  @@map("whatsapp_conversations")
}

/// Resultado de uma conversa fechada: deu certo (SUCCESS) ou não (FAILURE).
enum WhatsAppCloseOutcome {
  SUCCESS
  FAILURE
}

/// Opção de classificação oferecida ao fechar uma conversa (ex.: "Venda
/// realizada", "Sem interesse"). Configurada por OWNER/ADMIN; removida =
/// arquivada (`archivedAt`), para o histórico continuar legível.
model WhatsAppCloseStatus {
  id          String               @id @default(cuid())
  workspaceId String               @map("workspace_id")
  label       String               @db.VarChar(80)
  outcome     WhatsAppCloseOutcome
  position    Int                  @default(0)
  archivedAt  DateTime?            @map("archived_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, archivedAt, position])
  @@map("whatsapp_close_statuses")
}

/// Lifecycle of a click-to-call placed through the user's PABX device.
enum WhatsAppPhoneCallStatus {
  /// Queued on the PABX; the user's extension is ringing.
  QUEUED
  /// The user answered the extension; the PABX is dialing the contact.
  DIALING
  /// The contact answered.
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  /// The user hung up before the contact answered.
  CANCELED
  /// The user's extension did not answer.
  EXTENSION_NO_ANSWER
  FAILED
}

/// Click-to-call from a WhatsApp conversation. The PABX dialplan reports each
/// step to the webhook, authenticated by the per-call callback token (only its
/// SHA-256 is stored).
model WhatsAppPhoneCall {
  id                String                  @id @default(cuid())
  workspaceId       String                  @map("workspace_id")
  /// Null for a browser phone call whose number matches no conversation
  /// (ADR 0044 addendum); it still reaches the ticket/CRM timelines.
  conversationId    String?                 @map("conversation_id")
  userId            String?                 @map("user_id")
  deviceId          String                  @map("device_id") @db.VarChar(20)
  extension         String                  @db.VarChar(20)
  destination       String                  @db.VarChar(20)
  /// Call-file job id returned by the PABX.
  job               String?                 @db.VarChar(80)
  callbackTokenHash String                  @unique @map("callback_token_hash") @db.Char(64)
  status            WhatsAppPhoneCallStatus @default(QUEUED)
  /// Raw Asterisk DIALSTATUS of the final report.
  dialStatus        String?                 @map("dial_status") @db.VarChar(20)
  answeredAt        DateTime?               @map("answered_at")
  endedAt           DateTime?               @map("ended_at")
  durationSeconds   Int?                    @map("duration_seconds")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  /// Who placed the call and from where (ADR 0044 addendum). Click-to-call
  /// rows are always outbound; the browser phone reports both directions.
  direction         WhatsAppPhoneCallDirection @default(OUTBOUND)
  source            WhatsAppPhoneCallSource    @default(CLICK_TO_CALL)
  /// Asterisk unique id, when the PABX reports it: the key that keeps one
  /// call from becoming two rows (status webhook + browser report).
  pabxUniqueId      String?                 @map("pabx_unique_id") @db.VarChar(40)
  /// Remote party name from the SIP caller id (browser phone calls).
  remoteName        String?                 @map("remote_name") @db.VarChar(120)

  /// Recording asked to the PABX when the call was placed (workspace
  /// setting at that moment) and the notice the agent was shown to read to
  /// the contact — kept as evidence of the consent notice (LGPD, ADR 0043).
  recordingRequested Boolean                   @default(false) @map("recording_requested")
  recordingNotice    String?                   @map("recording_notice") @db.VarChar(500)
  /// MinIO object (`phone-call-recordings`, `<workspaceId>/<callId>.<ext>`).
  recordingKey       String?                   @map("recording_key") @db.VarChar(255)
  recordingMimeType  String?                   @map("recording_mime_type") @db.VarChar(40)
  recordingSizeBytes Int?                      @map("recording_size_bytes")
  recordedAt         DateTime?                 @map("recorded_at")
  /// The retention job deletes the audio after this (workspace retention
  /// days frozen at upload). Transcript and summary stay with the call.
  recordingExpiresAt DateTime?                 @map("recording_expires_at")
  aiStatus           WhatsAppPhoneCallAiStatus @default(NONE) @map("ai_status")
  /// Why the AI step did not run or failed (machine code, not user text).
  aiSkipReason       String?                   @map("ai_skip_reason") @db.VarChar(60)
  transcript         String?
  summary            String?
  sentiment          WhatsAppSentiment?
  sentimentScore     Float?                    @map("sentiment_score")
  nextSteps          String[]                  @default([]) @map("next_steps")
  /// Catalog key of the model that wrote the summary.
  aiModel            String?                   @map("ai_model") @db.VarChar(80)
  aiProcessedAt      DateTime?                 @map("ai_processed_at")
  /// Records the call is attached to besides the conversation, resolved
  /// when the recording is processed (open ticket of the conversation, CRM
  /// person with the same phone and their open opportunity).
  sdTicketId         String?                   @map("sd_ticket_id")
  crmPersonId        String?                   @map("crm_person_id")
  crmOpportunityId   String?                   @map("crm_opportunity_id")

  /// IVR voice attendant (ADR 0046): the call was answered by the AI. The
  /// transcript comes from the realtime session (no audio is stored).
  voiceAgent          Boolean @default(false) @map("voice_agent")
  /// Why the attendant ended: caller_hangup, transferred, silence,
  /// max_duration, provider_error, minutes_cap, ...
  voiceEndReason      String? @map("voice_end_reason") @db.VarChar(40)
  /// Extension/queue the call was handed to, and the context (summary +
  /// ticket) the human receives.
  voiceTransferTarget String? @map("voice_transfer_target") @db.VarChar(40)
  voiceHandoff        String? @map("voice_handoff") @db.VarChar(2000)

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   WhatsAppConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  sdTicket       SdTicket?            @relation(fields: [sdTicketId], references: [id], onDelete: SetNull)
  crmPerson      CrmPerson?           @relation(fields: [crmPersonId], references: [id], onDelete: SetNull)
  crmOpportunity CrmOpportunity?      @relation(fields: [crmOpportunityId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@index([sdTicketId])
  @@index([crmPersonId])
  @@index([crmOpportunityId])
  @@index([recordingExpiresAt])
  @@index([workspaceId, extension, createdAt])
  @@unique([workspaceId, pabxUniqueId])
  @@map("whatsapp_phone_calls")
}

enum WhatsAppPhoneCallDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppPhoneCallSource {
  /// The PABX rang the user's extension and bridged it to the contact.
  CLICK_TO_CALL
  /// Placed or answered in the browser phone (ADR 0044).
  WEBPHONE
}

/// Transcription + summary of a call recording (ADR 0043).
enum WhatsAppPhoneCallAiStatus {
  /// No recording (yet).
  NONE
  /// Recording stored, waiting for the worker.
  PENDING
  PROCESSING
  DONE
  /// Not processed: transcription off, Steel AI off, quota, no provider.
  SKIPPED
  FAILED
}

enum WhatsAppConversationEventKind {
  CLOSED
  REOPENED
  SENTIMENT_ALERT
  /// Contato clicou num botão de resposta; `reason` guarda o rótulo.
  BUTTON_CLICKED
  /// Ações automáticas do botão (atribuir, equipe, status...).
  ASSIGNED
  TEAM_CHANGED
  /// The auto-reply hit a guardrail (forbidden topic, authority limit,
  /// prompt injection) and handed off; `reason` carries the note.
  AI_GUARDRAIL_HANDOFF
  /// A IA da campanha executou uma ação; `reason` = "rótulo: motivo".
  AI_ACTION
}

/// Quem disparou o evento: um atendente (AGENT), uma nova mensagem do
/// contato (CONTACT) ou o fechamento automático por inatividade (INACTIVITY).
enum WhatsAppConversationEventSource {
  AGENT
  CONTACT
  INACTIVITY
  SENTIMENT
  /// Ação configurada num botão de template/mensagem pronta.
  BUTTON_ACTION
  /// Steel AI guardrails (ADR 0041).
  AI_GUARDRAIL
  /// Legado: disparo automático (substituído pelas campanhas de IA).
  AUTO_OUTREACH
  /// Campanha de IA (envio do template ou ação da IA).
  AI_CAMPAIGN
}

/// Linha do tempo da conversa (fechada/reaberta...), exibida entre as
/// mensagens. Não é mensagem do WhatsApp — nunca vai para o contato.
model WhatsAppConversationEvent {
  id                String                          @id @default(cuid())
  workspaceId       String                          @map("workspace_id")
  conversationId    String                          @map("conversation_id")
  kind              WhatsAppConversationEventKind
  source            WhatsAppConversationEventSource
  actorUserId       String?                         @map("actor_user_id")
  reason            String?
  /// Só em CLOSED: classificação escolhida no fechamento (cópia).
  closeOutcome      WhatsAppCloseOutcome?           @map("close_outcome")
  closeStatusLabels String[]                        @default([]) @map("close_status_labels")
  createdAt         DateTime                        @default(now()) @map("created_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorUser    User?                @relation("WhatsAppConversationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@map("whatsapp_conversation_events")
}

/// Monthly Communication (WhatsApp) usage counters per workspace. A dedicated
/// ledger because broadcasts and campaigns send without writing
/// `WhatsAppMessage` rows. `period` is the `YYYY-MM` month in America/Sao_Paulo.
model WhatsAppUsageMonthly {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  period           String
  /// Conversations opened or reopened (inbound and agent-started).
  conversations    Int      @default(0)
  /// Outbound messages accepted by the provider (reactions excluded).
  outboundMessages Int      @default(0) @map("outbound_messages")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period])
  @@map("whatsapp_usage_monthly")
}

enum WhatsAppCostCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  /// Free-form message inside the 24 h service window (no Meta charge).
  SERVICE
}

enum WhatsAppCostKind {
  TEMPLATE
  SERVICE
}

enum WhatsAppCostSource {
  BROADCAST
  AI_CAMPAIGN
  CRM_CAMPAIGN
  AGENT
  AI_REPLY
  BUTTON
  OTHER
}

/// Meta price per template message, per workspace (ADR 0050). Prices change
/// over time, so rows are never hard-coded in the code path: each row is
/// valid from `validFrom` until a later row of the same category/country
/// replaces it. `reference` marks the editable default seeded on first use.
model WhatsAppPrice {
  id          String               @id @default(cuid())
  workspaceId String               @map("workspace_id")
  category    WhatsAppCostCategory
  country     String               @default("BR") @db.VarChar(2)
  currency    String               @default("BRL") @db.VarChar(3)
  unitPrice   Decimal              @map("unit_price") @db.Decimal(12, 6)
  validFrom   DateTime             @map("valid_from")
  reference   Boolean              @default(false)
  createdById String?              @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, category, country, validFrom])
  @@index([workspaceId])
  @@map("whatsapp_prices")
}

/// One billable (or volume-only) outbound message, written at send time.
/// `estimatedCost` is quantity x the unit price snapshot, in `currency`.
/// Refs are plain ids (no FK) so history survives deletes.
model WhatsAppCostEntry {
  id             String               @id @default(cuid())
  workspaceId    String               @map("workspace_id")
  connectionId   String               @map("connection_id")
  provider       WhatsAppProvider
  occurredAt     DateTime             @default(now()) @map("occurred_at")
  category       WhatsAppCostCategory
  kind           WhatsAppCostKind
  source         WhatsAppCostSource
  country        String               @default("BR") @db.VarChar(2)
  currency       String               @default("BRL") @db.VarChar(3)
  broadcastId    String?              @map("broadcast_id")
  aiCampaignId   String?              @map("ai_campaign_id")
  conversationId String?              @map("conversation_id")
  userId         String?              @map("user_id")
  quantity       Int                  @default(1)
  unitPrice      Decimal              @map("unit_price") @db.Decimal(12, 6)
  estimatedCost  Decimal              @map("estimated_cost") @db.Decimal(14, 6)

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([connectionId, occurredAt])
  @@map("whatsapp_cost_entries")
}

/// Configurações de atendimento do WhatsApp por workspace (admin).
model WhatsAppSettings {
  id                  String @id @default(cuid())
  workspaceId         String @unique @map("workspace_id")
  /// Fecha conversas sem mensagem há N horas (0 = desligado).
  autoCloseAfterHours Int    @default(24) @map("auto_close_after_hours")

  /// Alerta de sentimento negativo: quando a média da conversa cai até o
  /// limite, avisa os supervisores (no app e/ou e-mail), no máximo uma vez
  /// por conversa a cada `sentimentAlertCooldownHours`.
  sentimentAlertEnabled       Boolean  @default(true) @map("sentiment_alert_enabled")
  sentimentAlertThreshold     Float    @default(-0.3) @map("sentiment_alert_threshold")
  sentimentAlertNotifyInApp   Boolean  @default(true) @map("sentiment_alert_notify_in_app")
  sentimentAlertNotifyEmail   Boolean  @default(false) @map("sentiment_alert_notify_email")
  /// Membros avisados; vazio = todos os OWNER/ADMIN do workspace.
  sentimentAlertRecipientIds  String[] @default([]) @map("sentiment_alert_recipient_ids")
  /// Supervisor que assume a conversa sem atendente ao disparar o alerta.
  sentimentAlertAssignToId    String?  @map("sentiment_alert_assign_to_id")
  sentimentAlertCooldownHours Int      @default(6) @map("sentiment_alert_cooldown_hours")
  /// Monthly caps for the Communication module (null = unlimited). At 100%
  /// outbound sends and agent-started conversations are refused; inbound
  /// keeps flowing. Set by OWNER/ADMIN in Ajustes › Comunicação.
  monthlyConversationLimit    Int?     @map("monthly_conversation_limit")
  monthlyMessageLimit         Int?     @map("monthly_message_limit")
  /// Click-to-call recording (ADR 0043): off by default. When on, the PABX
  /// records the call and the agent sees `callRecordingNotice` to read to
  /// the contact; audio is deleted after `callRecordingRetentionDays`.
  callRecordingEnabled        Boolean  @default(false) @map("call_recording_enabled")
  callRecordingNotice         String?  @map("call_recording_notice") @db.VarChar(500)
  callRecordingRetentionDays  Int      @default(90) @map("call_recording_retention_days")
  /// Transcribe and summarize recorded calls with Steel AI.
  callTranscriptionEnabled    Boolean  @default(true) @map("call_transcription_enabled")
  /// Quantos status de fechamento o atendente escolhe ao fechar a conversa:
  /// mínimo (0 = opcional) e máximo. Só valem com status cadastrados.
  closeStatusMinSelections    Int      @default(0) @map("close_status_min_selections")
  closeStatusMaxSelections    Int      @default(1) @map("close_status_max_selections")
  /// Horário de atendimento (America/Sao_Paulo): fora dele os envios de
  /// atendentes, da IA e do disparo automático ficam travados. `HH:mm`;
  /// fim antes do início = janela que vira a noite. Dias: 0 = domingo.
  businessHoursEnabled        Boolean  @default(false) @map("business_hours_enabled")
  businessHoursStart          String   @default("08:00") @map("business_hours_start") @db.VarChar(5)
  businessHoursEnd            String   @default("18:00") @map("business_hours_end") @db.VarChar(5)
  businessHoursDays           Int[]    @default([1, 2, 3, 4, 5]) @map("business_hours_days")
  /// Monthly cost budget (BRL) of the Comunicação module (ADR 0050). Only
  /// warns admins at 80% and 100%; never blocks a send. Null = no budget.
  monthlyCostBudget           Decimal? @map("monthly_cost_budget") @db.Decimal(12, 2)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

enum WhatsAppMessageDirection {
  IN
  OUT
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  TEMPLATE
  BUTTON
  CONTACT
}

enum WhatsAppMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppSentiment {
  NEGATIVE
  NEUTRAL
  POSITIVE
}

model WhatsAppMessage {
  id                String                   @id @default(cuid())
  workspaceId       String                   @map("workspace_id")
  conversationId    String                   @map("conversation_id")
  direction         WhatsAppMessageDirection
  type              WhatsAppMessageType
  text              String?
  mediaUrl          String?                  @map("media_url")
  providerMessageId String?                  @unique @map("provider_message_id")
  status            WhatsAppMessageStatus    @default(PENDING)
  senderUserId      String?                  @map("sender_user_id")
  sentByAi          Boolean                  @default(false) @map("sent_by_ai")
  replyToMessageId  String?                  @map("reply_to_message_id")
  reactionEmoji     String?                  @map("reaction_emoji")
  // Who set reactionEmoji: true = the contact reacted, false = an agent
  // reacted. Meaningless while reactionEmoji is null.
  reactedByContact  Boolean?                 @map("reacted_by_contact")
  contactPayload    Json?                    @map("contact_payload")
  /// Botões enviados com a mensagem (OUT) — `WhatsAppButton[]` sem as ações.
  buttons           Json?
  /// Clique recebido (IN): id do botão (`WhatsAppButton.id`) ou payload cru.
  buttonPayload     String?                  @map("button_payload")
  /// Classificação de humor — só preenchido em mensagens recebidas (IN),
  /// pelo job de análise de sentimento (não bloqueia o envio/recebimento).
  sentiment         WhatsAppSentiment?
  sentimentScore    Float?                   @map("sentiment_score")
  deletedAt         DateTime?                @map("deleted_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User?                @relation("WhatsAppMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyToMessage WhatsAppMessage?     @relation("WhatsAppMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        WhatsAppMessage[]    @relation("WhatsAppMessageReply")

  @@index([workspaceId])
  @@index([conversationId, createdAt])
  @@index([replyToMessageId])
  @@map("whatsapp_messages")
}

model WhatsAppQuickReply {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  shortcut    String
  title       String
  body        String
  mediaUrl    String?  @map("media_url")
  /// Até 2 botões (`WhatsAppButton[]`, com ações no clique). Nulo = sem botões.
  buttons     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortcut])
  @@index([workspaceId])
  @@map("whatsapp_quick_replies")
}

enum WhatsAppBroadcastMediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum WhatsAppBroadcastStatus {
  DRAFT
  QUEUED
  RUNNING
  DONE
  FAILED
}

model WhatsAppBroadcastList {
  id            String                      @id @default(cuid())
  workspaceId   String                      @map("workspace_id")
  connectionId  String                      @map("connection_id")
  templateId    String?                     @map("template_id")
  name          String
  messageBody   String                      @map("message_body")
  mediaUrl      String?                     @map("media_url")
  /// Tipo da mídia (define imagem/vídeo/áudio/documento no envio), mime e
  /// nome original do arquivo (nome exibido no documento). Nulos em listas
  /// antigas: o envio deduz o tipo pela extensão da URL.
  mediaType     WhatsAppBroadcastMediaType? @map("media_type")
  mediaMimeType String?                     @map("media_mime_type")
  mediaFileName String?                     @map("media_file_name")
  status        WhatsAppBroadcastStatus     @default(DRAFT)
  scheduledAt   DateTime?                   @map("scheduled_at")
  createdById   String                      @map("created_by_id")
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  workspace  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection           @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  template   WhatsAppTemplate?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy  User                         @relation("WhatsAppBroadcastCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  recipients WhatsAppBroadcastRecipient[]

  @@index([workspaceId])
  @@index([templateId])
  @@map("whatsapp_broadcast_lists")
}

enum WhatsAppBroadcastRecipientStatus {
  PENDING
  SENT
  FAILED
  // Contato descadastrado (opt-out LGPD) antes do disparo — não enviado.
  SKIPPED
}

model WhatsAppBroadcastRecipient {
  id                String                           @id @default(cuid())
  broadcastListId   String                           @map("broadcast_list_id")
  contactId         String                           @map("contact_id")
  status            WhatsAppBroadcastRecipientStatus @default(PENDING)
  // Valores para preencher as variáveis do template Meta, na forma
  // TemplateFillValues (header/body/buttons) de template-variables.ts.
  // Nulo para broadcasts de texto simples (sem template).
  variableValues    Json?                            @map("variable_values")
  // Horário de disparo individual — cada linha da planilha importada tem
  // sua própria data de referência (ex: consulta agendada), então o
  // agendamento é por destinatário, não pela lista inteira.
  scheduledAt       DateTime?                        @map("scheduled_at")
  // Data/hora real do compromisso (ex: exame), distinta de `scheduledAt`
  // (horário de disparo do lembrete = appointmentAt - sendOffsetHours).
  // Consultada pela IA via tool calling quando o cliente pergunta sobre
  // agendamentos.
  appointmentAt     DateTime?                        @map("appointment_at")
  providerMessageId String?                          @map("provider_message_id")
  errorMessage      String?                          @map("error_message")
  sentAt            DateTime?                        @map("sent_at")
  createdAt         DateTime                         @default(now()) @map("created_at")

  broadcastList WhatsAppBroadcastList @relation(fields: [broadcastListId], references: [id], onDelete: Cascade)
  contact       WhatsAppContact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastListId, contactId])
  @@index([broadcastListId, status])
  @@index([status, scheduledAt])
  @@index([contactId, appointmentAt])
  @@map("whatsapp_broadcast_recipients")
}

/// Campanha de IA: a IA envia um template aprovado da Meta a um grupo de
/// contatos, com as variáveis preenchidas pela campanha, no ritmo escolhido
/// (`intervalSeconds`), e responde quem voltar a escrever seguindo as
/// instruções da campanha — podendo executar as ações que o admin habilitou
/// (`actions`). `runToken` identifica a cadeia de jobs do envio: um play novo
/// invalida a anterior (sem envio em dobro).
model WhatsAppAiCampaign {
  id              String                   @id @default(cuid())
  workspaceId     String                   @map("workspace_id")
  name            String                   @db.VarChar(120)
  objective       String?                  @db.VarChar(500)
  connectionId    String?                  @map("connection_id")
  templateId      String?                  @map("template_id")
  /// De onde vem cada variável do template (`AiCampaignVariables`).
  variables       Json                     @default("{}")
  /// Mídia do cabeçalho só desta campanha (nulo = a do template).
  headerMediaUrl  String?                  @map("header_media_url")
  /// Instruções da IA para as respostas desta campanha.
  instructions    String                   @default("")
  /// Ações que a IA pode executar (`AiCampaignAction[]`).
  actions         Json                     @default("[]")
  /// Nível de agressividade: segundos entre dois envios (20 a 60).
  intervalSeconds Int                      @default(30) @map("interval_seconds")
  /// A IA responde quem voltar a escrever (desligado = só envia).
  aiReplies       Boolean                  @default(true) @map("ai_replies")
  status          WhatsAppAiCampaignStatus @default(DRAFT)
  runToken        String?                  @map("run_token")
  lastSentAt      DateTime?                @map("last_sent_at")
  /// Motivo da última pausa automática (limite mensal, template removido...).
  lastError       String?                  @map("last_error")
  startedAt       DateTime?                @map("started_at")
  finishedAt      DateTime?                @map("finished_at")
  createdById     String?                  @map("created_by_id")
  updatedById     String?                  @map("updated_by_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  workspace     Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection    WhatsAppConnection?           @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  template      WhatsAppTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients    WhatsAppAiCampaignRecipient[]
  actionRuns    WhatsAppAiCampaignActionRun[]
  conversations WhatsAppConversation[]

  @@index([workspaceId, status])
  @@map("whatsapp_ai_campaigns")
}

enum WhatsAppAiCampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  /// Fila esvaziou com a campanha ligada.
  DONE
  /// Removida pelo admin (fica para o histórico das conversas).
  ARCHIVED
}

enum WhatsAppAiCampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  /// Não enviado: descadastrado (opt-out) ou sem valor para uma variável.
  SKIPPED
}

model WhatsAppAiCampaignRecipient {
  id                String                            @id @default(cuid())
  campaignId        String                            @map("campaign_id")
  contactId         String                            @map("contact_id")
  status            WhatsAppAiCampaignRecipientStatus @default(PENDING)
  /// Valores da planilha importada (coluna → valor), para as variáveis.
  values            Json?
  conversationId    String?                           @map("conversation_id")
  providerMessageId String?                           @map("provider_message_id")
  errorMessage      String?                           @map("error_message")
  sentAt            DateTime?                         @map("sent_at")
  /// Primeira resposta do contato depois do envio.
  repliedAt         DateTime?                         @map("replied_at")
  createdAt         DateTime                          @default(now()) @map("created_at")

  campaign WhatsAppAiCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  WhatsAppContact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status, createdAt])
  @@index([conversationId])
  @@index([contactId])
  @@map("whatsapp_ai_campaign_recipients")
}

enum WhatsAppAiCampaignActionRunStatus {
  SUCCESS
  FAILED
}

/// Ação executada pela IA numa conversa da campanha (histórico + auditoria).
model WhatsAppAiCampaignActionRun {
  id             String                            @id @default(cuid())
  workspaceId    String                            @map("workspace_id")
  campaignId     String                            @map("campaign_id")
  conversationId String?                           @map("conversation_id")
  contactId      String?                           @map("contact_id")
  /// `AiCampaignAction.id` + cópia do tipo/rótulo no momento da execução.
  actionId       String                            @map("action_id")
  kind           String
  label          String
  /// Por que a IA executou (escrito por ela).
  reason         String?
  payload        Json?
  status         WhatsAppAiCampaignActionRunStatus
  error          String?
  createdAt      DateTime                          @default(now()) @map("created_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  WhatsAppAiCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([workspaceId])
  @@map("whatsapp_ai_campaign_action_runs")
}

enum WhatsAppTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  /// Meta pausou o template por qualidade baixa (volta sozinho ou é desativado).
  PAUSED
  DISABLED
}

/// Classificação de qualidade da Meta (quality_score). UNKNOWN = ainda sem
/// envios suficientes para avaliar.
enum WhatsAppTemplateQuality {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum WhatsAppTemplateHeaderFormat {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

model WhatsAppTemplate {
  id               String                        @id @default(cuid())
  workspaceId      String                        @map("workspace_id")
  connectionId     String                        @map("connection_id")
  name             String
  language         String
  category         String
  status           WhatsAppTemplateStatus        @default(PENDING)
  components       Json
  quality          WhatsAppTemplateQuality       @default(UNKNOWN)
  qualityUpdatedAt DateTime?                     @map("quality_updated_at")
  /// Motivo da rejeição/pausa informado pela Meta.
  statusReason     String?                       @map("status_reason")
  headerFormat     WhatsAppTemplateHeaderFormat? @map("header_format")
  /// Cópia no MinIO da mídia do cabeçalho — reenviada a cada disparo.
  headerMediaUrl   String?                       @map("header_media_url")
  /// Botões com as ações no clique (`WhatsAppButton[]`). Nulo em templates
  /// vindos da Meta ainda sem ações configuradas — derive de `components`.
  buttons          Json?
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")

  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection     WhatsAppConnection      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  broadcastLists WhatsAppBroadcastList[]
  aiCampaigns    WhatsAppAiCampaign[]

  @@unique([connectionId, name, language])
  @@index([workspaceId])
  @@map("whatsapp_templates")
}

enum WhatsAppTeamRole {
  LEADER
  AGENT
}

/// Equipe de atendimento do zap. O líder vê as conversas dos agentes da
/// equipe; o agente vê só as suas (e a fila sem responsável).
model WhatsAppTeam {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       WhatsAppTeamMember[]
  conversations WhatsAppConversation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("whatsapp_teams")
}

model WhatsAppTeamMember {
  id        String           @id @default(cuid())
  teamId    String           @map("team_id")
  userId    String           @map("user_id")
  role      WhatsAppTeamRole @default(AGENT)
  createdAt DateTime         @default(now()) @map("created_at")

  team WhatsAppTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("whatsapp_team_members")
}

model WhatsAppAiConfig {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique @map("workspace_id")
  // Legado: a IA agora usa as chaves da plataforma (env) e o provedor/modelo
  // de WorkspaceAiSettings. `encryptedOpenaiApiKey` e `model` não são mais
  // lidos; ficam só para não descartar dados já salvos.
  encryptedOpenaiApiKey String?  @map("encrypted_openai_api_key")
  model                 String   @default("gpt-4o-mini")
  systemPrompt          String   @map("system_prompt")
  active                Boolean  @default(false)
  // Opt-in: lets the AI look at received images (Vision) and transcribe
  // received audio (Whisper) instead of a static "[imagem]"/"[áudio]"
  // placeholder. Off by default — extra OpenAI cost/latency per media message.
  readMedia             Boolean  @default(false) @map("read_media")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_ai_configs")
}

enum WhatsAppAiKnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

/// Base de conhecimento da IA do WhatsApp. O arquivo original fica no MinIO
/// (storageKey); o texto extraído é injetado direto no systemPrompt do
/// processor de resposta (sem embeddings/busca — poucos documentos por
/// workspace no caso de uso real, não uma base grande).
model WhatsAppAiKnowledgeDocument {
  id            String                            @id @default(cuid())
  workspaceId   String                            @map("workspace_id")
  filename      String
  contentType   String                            @map("content_type")
  sizeBytes     Int                               @map("size_bytes")
  storageKey    String                            @map("storage_key")
  status        WhatsAppAiKnowledgeDocumentStatus @default(PROCESSING)
  extractedText String?                           @map("extracted_text")
  errorMessage  String?                           @map("error_message")
  createdById   String                            @map("created_by_id")
  createdAt     DateTime                          @default(now()) @map("created_at")
  updatedAt     DateTime                          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WhatsAppAiKnowledgeDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("whatsapp_ai_knowledge_documents")
}

// ─── WhatsApp groups (Z-API only — the Meta Cloud API has no group endpoints) ──

enum WhatsAppGroupParticipantRole {
  MEMBER
  ADMIN
}

model WhatsAppGroup {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  connectionId  String    @map("connection_id")
  groupJid      String    @map("group_jid")
  name          String
  imageUrl      String?   @map("image_url")
  description   String?
  inviteLink    String?   @map("invite_link")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  participants WhatsAppGroupParticipant[]
  messages     WhatsAppGroupMessage[]

  @@unique([workspaceId, groupJid])
  @@index([workspaceId, archivedAt, lastMessageAt])
  @@index([connectionId])
  @@map("whatsapp_groups")
}

model WhatsAppGroupParticipant {
  id        String                       @id @default(cuid())
  groupId   String                       @map("group_id")
  waId      String                       @map("wa_id")
  name      String?
  role      WhatsAppGroupParticipantRole @default(MEMBER)
  createdAt DateTime                     @default(now()) @map("created_at")

  group WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, waId])
  @@index([groupId])
  @@map("whatsapp_group_participants")
}

enum WhatsAppGroupMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppGroupMessage {
  id                String                     @id @default(cuid())
  workspaceId       String                     @map("workspace_id")
  groupId           String                     @map("group_id")
  direction         WhatsAppMessageDirection
  type              WhatsAppMessageType
  text              String?
  mediaUrl          String?                    @map("media_url")
  providerMessageId String?                    @unique @map("provider_message_id")
  status            WhatsAppGroupMessageStatus @default(PENDING)
  senderUserId      String?                    @map("sender_user_id")
  // Inbound only: which participant actually sent it, since group messages
  // arrive addressed to the group JID, not an individual contact.
  senderWaId        String?                    @map("sender_wa_id")
  senderName        String?                    @map("sender_name")
  deletedAt         DateTime?                  @map("deleted_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group      WhatsAppGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("WhatsAppGroupMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([groupId, createdAt])
  @@map("whatsapp_group_messages")
}

// ─── CRM domain ─────────────────────────────────────────────────────────────

/// Empresa/conta do CRM, escopada por workspace.
model CrmCompany {
  id             String    @id @default(cuid())
  name           String    @default("")
  cnpj           String?
  domain         String?
  employees      Int?
  linkedin       String?
  address        Json?
  arr            Decimal?  @db.Decimal(14, 2)
  icp            Boolean   @default(false)
  workspaceId    String    @map("workspace_id")
  createdById    String    @map("created_by_id")
  accountOwnerId String?   @map("account_owner_id")
  updatedById    String?   @map("updated_by_id")
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("CrmCompanyCreatedBy", fields: [createdById], references: [id])
  accountOwner User?     @relation("CrmCompanyAccountOwner", fields: [accountOwnerId], references: [id])
  updatedBy    User?     @relation("CrmCompanyUpdatedBy", fields: [updatedById], references: [id])

  people        CrmPerson[]
  opportunities CrmOpportunity[]
  tasks         CrmTask[]
  notes         CrmNote[]
  proposals     CrmProposal[]

  @@unique([workspaceId, domain])
  @@unique([workspaceId, cnpj])
  @@index([workspaceId])
  @@index([accountOwnerId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_companies")
}

/// Pessoa/contato do CRM, escopada por workspace e opcionalmente ligada a uma CrmCompany.
model CrmPerson {
  id          String    @id @default(cuid())
  name        String
  emails      String[]  @default([])
  phones      String[]  @default([])
  city        String?
  jobTitle    String?   @map("job_title")
  linkedin    String?
  avatar      String?
  companyId   String?   @map("company_id")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CrmCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User        @relation("CrmPersonCreatedBy", fields: [createdById], references: [id])
  updatedBy User?       @relation("CrmPersonUpdatedBy", fields: [updatedById], references: [id])

  opportunitiesAsPointOfContact CrmOpportunity[]    @relation("CrmOpportunityPointOfContact")
  convertedFromLeads            CrmLead[]
  leadMeetings                  CrmLeadMeeting[]    @relation("CrmLeadMeetingContactPerson")
  tasks                         CrmTask[]
  notes                         CrmNote[]
  emailMessages                 CrmEmailMessage[]
  calendarEvents                CrmCalendarEvent[]
  proposalsAsContact            CrmProposal[]       @relation("CrmProposalContact")
  phoneCalls                    WhatsAppPhoneCall[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_people")
}

enum CrmBillingType {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum CrmStageCategory {
  OPEN
  WON
  LOST
}

/// Funil de vendas configurável por workspace.
model CrmPipeline {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  position    Int       @default(0)
  isDefault   Boolean   @default(false) @map("is_default")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmPipelineCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmPipelineUpdatedBy", fields: [updatedById], references: [id])

  stages        CrmPipelineStage[]
  opportunities CrmOpportunity[]

  @@index([workspaceId])
  @@index([workspaceId, position])
  @@index([deletedAt])
  @@map("crm_pipelines")
}

/// Etapa de um pipeline. `probability` (0-100) e `category` alimentam o forecast.
model CrmPipelineStage {
  id          String           @id @default(cuid())
  pipelineId  String           @map("pipeline_id")
  name        String
  position    Int              @default(0)
  probability Int              @default(0)
  category    CrmStageCategory @default(OPEN)
  color       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  pipeline      CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@index([pipelineId])
  @@index([pipelineId, position])
  @@map("crm_pipeline_stages")
}

/// Produto/serviço do catálogo da workspace.
model CrmProduct {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  name        String
  sku         String?
  description String?
  unitPrice   Decimal        @default(0) @map("unit_price") @db.Decimal(14, 2)
  currency    String         @default("BRL")
  billingType CrmBillingType @default(ONE_TIME) @map("billing_type")
  active      Boolean        @default(true)
  position    Int            @default(0)
  createdById String         @map("created_by_id")
  updatedById String?        @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmProductCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmProductUpdatedBy", fields: [updatedById], references: [id])

  lineItems     CrmOpportunityLineItem[]
  leadInterests CrmLeadInterestProduct[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([workspaceId, position])
  @@index([deletedAt])
  @@map("crm_products")
}

/// Oportunidade de venda vinculada a um pipeline/etapa.
model CrmOpportunity {
  id               String    @id @default(cuid())
  name             String
  amount           Decimal?  @db.Decimal(14, 2)
  /// Override de probabilidade (0-100) por negócio; quando nulo, o forecast
  /// usa o padrão da etapa (CrmPipelineStage.probability).
  probability      Int?
  closeDate        DateTime? @map("close_date")
  pipelineId       String    @map("pipeline_id")
  stageId          String    @map("stage_id")
  companyId        String?   @map("company_id")
  pointOfContactId String?   @map("point_of_contact_id")
  ownerId          String?   @map("owner_id")
  source           String?
  workspaceId      String    @map("workspace_id")
  createdById      String    @map("created_by_id")
  updatedById      String?   @map("updated_by_id")
  position         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  /// When the deal entered a WON stage (cleared when it leaves one). The
  /// sales kit attributes a win to the period of this date (ADR 0031).
  wonAt            DateTime? @map("won_at")

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline       CrmPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage          CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company        CrmCompany?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pointOfContact CrmPerson?       @relation("CrmOpportunityPointOfContact", fields: [pointOfContactId], references: [id], onDelete: SetNull)
  owner          User?            @relation("CrmOpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("CrmOpportunityCreatedBy", fields: [createdById], references: [id])
  updatedBy      User?            @relation("CrmOpportunityUpdatedBy", fields: [updatedById], references: [id])

  lineItems      CrmOpportunityLineItem[]
  tasks          CrmTask[]
  notes          CrmNote[]
  emailMessages  CrmEmailMessage[]
  calendarEvents CrmCalendarEvent[]
  proposals      CrmProposal[]
  phoneCalls     WhatsAppPhoneCall[]

  @@index([workspaceId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([companyId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@index([workspaceId, wonAt])
  @@map("crm_opportunities")
}

/// Item de uma oportunidade. Faz snapshot do produto (nome/preço) no momento da inclusão.
model CrmOpportunityLineItem {
  id            String         @id @default(cuid())
  opportunityId String         @map("opportunity_id")
  productId     String?        @map("product_id")
  name          String
  quantity      Int            @default(1)
  unitPrice     Decimal        @default(0) @map("unit_price") @db.Decimal(14, 2)
  discountPct   Decimal        @default(0) @map("discount_pct") @db.Decimal(5, 2)
  billingType   CrmBillingType @default(ONE_TIME) @map("billing_type")
  total         Decimal        @default(0) @db.Decimal(14, 2)
  position      Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product     CrmProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([opportunityId, position])
  @@index([productId])
  @@map("crm_opportunity_line_items")
}

enum CrmLeadStage {
  RECEIVED
  IN_CONTACT
  QUALIFIED
  OPPORTUNITY
  PROPOSAL
  CLOSED
}

enum CrmLeadContactChannel {
  PHONE
  WHATSAPP
  EMAIL
  MEETING
  OTHER
}

enum CrmLeadContactOutcome {
  ATTEMPTED
  REACHED
}

enum CrmLeadMeetingFormat {
  IN_PERSON
  ONLINE
}

enum CrmLeadProposalFormat {
  IN_PERSON
  ONLINE
  EMAIL
  OTHER
}

enum CrmLeadInterestLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum CrmLeadCloseResult {
  WON
  LOST
}

enum CrmLeadRuleField {
  name
  email
  phone
  company
  jobTitle
  source
  city
}

enum CrmLeadRuleOperator {
  equals
  not_equals
  contains
  is_empty
  is_not_empty
}

/// Lead (contato bruto de marketing) antes de virar Pessoa. Pontuado e roteado
/// automaticamente via CrmLeadScoringRule/CrmLeadRoutingRule; convertido manualmente.
model CrmLead {
  id                String       @id @default(cuid())
  workspaceId       String       @map("workspace_id")
  name              String
  emails            String[]     @default([])
  phones            String[]     @default([])
  company           String?
  jobTitle          String?      @map("job_title")
  city              String?
  linkedin          String?
  source            String?
  /// Canal de entrada (WhatsApp, Instagram, Site, Indicação etc.) — separado
  /// de `source`, que é texto livre para detalhe/campanha específica.
  channel           String?
  /// Etapa fixa do painel de leads (01 Recebido -> 06 Fechado). Avanço é
  /// sempre gated por um registro obrigatório da etapa — ver CrmLeadService.
  stage             CrmLeadStage @default(RECEIVED)
  score             Int          @default(0)
  ownerId           String?      @map("owner_id")
  convertedPersonId String?      @map("converted_person_id")

  // Preenchidos apenas quando stage = CLOSED.
  closeResult      CrmLeadCloseResult? @map("close_result")
  closedAt         DateTime?           @map("closed_at")
  contractSignedAt DateTime?           @map("contract_signed_at")
  billingType      CrmBillingType?     @map("billing_type")
  closedAmount     Decimal?            @map("closed_amount") @db.Decimal(14, 2)
  lostReason       String?             @map("lost_reason")
  lostNote         String?             @map("lost_note")
  retryAt          DateTime?           @map("retry_at")

  /// Origin system of an imported lead (`apollo`) and its id there; the pair
  /// is unique per workspace so a re-import never duplicates (deleted rows
  /// keep their key on purpose: a removed lead is not re-imported).
  externalSource String? @map("external_source")
  externalId     String? @map("external_id")

  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User?      @relation("CrmLeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User       @relation("CrmLeadCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?      @relation("CrmLeadUpdatedBy", fields: [updatedById], references: [id])
  convertedPerson CrmPerson? @relation(fields: [convertedPersonId], references: [id], onDelete: SetNull)

  contactAttempts       CrmLeadContactAttempt[]
  interestProducts      CrmLeadInterestProduct[]
  qualification         CrmLeadQualification?
  meetings              CrmLeadMeeting[]
  proposals             CrmProposal[]
  proposalPresentations CrmLeadProposalPresentation[]
  reopenings            CrmLeadReopening[]
  notes                 CrmNote[]

  @@unique([workspaceId, externalSource, externalId])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([stage])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_leads")
}

/// Tentativa (ou contato efetivo) registrada nas etapas 01/02 do painel de
/// leads. `outcome = REACHED` é o gate de IN_CONTACT -> QUALIFIED.
model CrmLeadContactAttempt {
  id            String                @id @default(cuid())
  leadId        String                @map("lead_id")
  workspaceId   String                @map("workspace_id")
  contactedWith String                @map("contacted_with")
  channel       CrmLeadContactChannel
  outcome       CrmLeadContactOutcome @default(ATTEMPTED)
  occurredAt    DateTime              @map("occurred_at")
  note          String?
  createdById   String                @map("created_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  lead      CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmLeadContactAttemptCreatedBy", fields: [createdById], references: [id])

  @@index([leadId, occurredAt])
  @@index([workspaceId])
  @@map("crm_lead_contact_attempts")
}

/// Produto/serviço de interesse do lead, do catálogo existente (CrmProduct).
model CrmLeadInterestProduct {
  leadId    String   @map("lead_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  lead    CrmLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product CrmProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([leadId, productId])
  @@index([productId])
  @@map("crm_lead_interest_products")
}

/// Snapshot de qualificação (único por lead) — gate de QUALIFIED -> OPPORTUNITY.
model CrmLeadQualification {
  id                String    @id @default(cuid())
  leadId            String    @unique @map("lead_id")
  expectedCloseAt   DateTime? @map("expected_close_at")
  decisionMakerName String    @map("decision_maker_name")
  decisionMakerRole String    @map("decision_maker_role")
  qualifiedById     String    @map("qualified_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  lead        CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  qualifiedBy User    @relation("CrmLeadQualificationQualifiedBy", fields: [qualifiedById], references: [id])

  @@map("crm_lead_qualifications")
}

/// Reunião registrada na etapa OPPORTUNITY — gate (junto com a criação da
/// CrmProposal) de OPPORTUNITY -> PROPOSAL.
model CrmLeadMeeting {
  id                String               @id @default(cuid())
  leadId            String               @map("lead_id")
  workspaceId       String               @map("workspace_id")
  scheduledAt       DateTime             @map("scheduled_at")
  format            CrmLeadMeetingFormat
  contactPersonId   String?              @map("contact_person_id")
  contactPersonName String?              @map("contact_person_name")
  interestDetails   String               @map("interest_details")
  identifiedNeed    String               @map("identified_need")
  createdById       String               @map("created_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")

  lead          CrmLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactPerson CrmPerson? @relation("CrmLeadMeetingContactPerson", fields: [contactPersonId], references: [id], onDelete: SetNull)
  createdBy     User       @relation("CrmLeadMeetingCreatedBy", fields: [createdById], references: [id])

  @@index([leadId, scheduledAt])
  @@index([workspaceId])
  @@map("crm_lead_meetings")
}

/// Apresentação de proposta na etapa PROPOSAL — carrega o Termômetro de
/// Interesse (`interestLevel`) exibido na barra inferior do painel.
model CrmLeadProposalPresentation {
  id                String                @id @default(cuid())
  leadId            String                @map("lead_id")
  proposalId        String                @map("proposal_id")
  presentedAt       DateTime              @map("presented_at")
  format            CrmLeadProposalFormat
  amount            Decimal               @db.Decimal(14, 2)
  interestLevel     CrmLeadInterestLevel  @map("interest_level")
  interactionsCount Int                   @default(0) @map("interactions_count")
  createdById       String                @map("created_by_id")
  createdAt         DateTime              @default(now()) @map("created_at")

  lead      CrmLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  proposal  CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdBy User        @relation("CrmLeadProposalPresentationCreatedBy", fields: [createdById], references: [id])

  @@index([leadId, presentedAt])
  @@index([proposalId])
  @@map("crm_lead_proposal_presentations")
}

/// Reabertura de um lead perdido (CLOSED/LOST -> etapa aberta). Guarda o
/// snapshot do fechamento desfeito para o histórico: o lead em si volta ao
/// funil com os campos de perda limpos, mas nada da perda anterior se perde.
model CrmLeadReopening {
  id                 String       @id @default(cuid())
  leadId             String       @map("lead_id")
  workspaceId        String       @map("workspace_id")
  toStage            CrmLeadStage @map("to_stage")
  reason             String
  previousLostReason String?      @map("previous_lost_reason")
  previousLostNote   String?      @map("previous_lost_note")
  previousClosedAt   DateTime?    @map("previous_closed_at")
  previousRetryAt    DateTime?    @map("previous_retry_at")
  reopenedById       String       @map("reopened_by_id")
  createdAt          DateTime     @default(now()) @map("created_at")

  lead       CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reopenedBy User      @relation("CrmLeadReopeningReopenedBy", fields: [reopenedById], references: [id])

  @@index([leadId, createdAt])
  @@index([workspaceId])
  @@map("crm_lead_reopenings")
}

/// Configurações do CRM por workspace, editáveis por OWNER/ADMIN. No máximo
/// uma linha por workspace; sem linha valem os padrões (`CRM_SETTINGS_DEFAULTS`
/// em src/schemas/crm-settings.schema.ts, espelhados nos @default abaixo).
model CrmSettings {
  id                   String       @id @default(cuid())
  workspaceId          String       @unique @map("workspace_id")
  /// Etapa para onde um lead perdido volta ao ser reaberto.
  leadReopenStage      CrmLeadStage @default(RECEIVED) @map("lead_reopen_stage")
  /// Validade padrão (dias) aplicada às propostas novas.
  proposalValidityDays Int          @default(15) @map("proposal_validity_days")
  /// Avisar o responsável por e-mail quando a proposta expira.
  notifyProposalExpiry Boolean      @default(true) @map("notify_proposal_expiry")
  updatedById          String?      @map("updated_by_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation("CrmSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("crm_settings")
}

/// Regra de pontuação de leads: condição → pontos somados ao score.
model CrmLeadScoringRule {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  field       CrmLeadRuleField
  operator    CrmLeadRuleOperator
  value       String?
  points      Int                 @default(0)
  active      Boolean             @default(true)
  position    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, position])
  @@map("crm_lead_scoring_rules")
}

/// Regra de roteamento de leads: condição → responsável. Sem match → sem dono.
model CrmLeadRoutingRule {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  field       CrmLeadRuleField
  operator    CrmLeadRuleOperator
  value       String?
  ownerId     String              @map("owner_id")
  active      Boolean             @default(true)
  position    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("CrmLeadRoutingOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, position])
  @@map("crm_lead_routing_rules")
}

enum CrmCustomFieldEntity {
  COMPANY
  PERSON
  OPPORTUNITY
}

enum CrmCustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

/// Definição de um campo customizado (no-code) por workspace e entidade.
model CrmCustomFieldDefinition {
  id          String               @id @default(cuid())
  workspaceId String               @map("workspace_id")
  entity      CrmCustomFieldEntity
  key         String
  label       String
  type        CrmCustomFieldType   @default(TEXT)
  options     String[]             @default([])
  required    Boolean              @default(false)
  position    Int                  @default(0)
  createdById String               @map("created_by_id")
  updatedById String?              @map("updated_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmCustomFieldCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmCustomFieldUpdatedBy", fields: [updatedById], references: [id])

  values CrmCustomFieldValue[]

  @@unique([workspaceId, entity, key])
  @@index([workspaceId, entity])
  @@index([deletedAt])
  @@map("crm_custom_field_definitions")
}

/// Valor de um campo customizado para um registro (Company/Person/Opportunity).
/// `recordId` é o id do registro da entidade da definição. `value` é JSON tipado.
model CrmCustomFieldValue {
  id           String   @id @default(cuid())
  definitionId String   @map("definition_id")
  recordId     String   @map("record_id")
  value        Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  definition CrmCustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, recordId])
  @@index([recordId])
  @@index([definitionId])
  @@map("crm_custom_field_values")
}

enum CrmTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Tarefa vinculada opcionalmente a Company/Person/Opportunity.
model CrmTask {
  id            String        @id @default(cuid())
  title         String
  status        CrmTaskStatus @default(TODO)
  body          String?
  dueDate       DateTime?     @map("due_date")
  assigneeId    String?       @map("assignee_id")
  companyId     String?       @map("company_id")
  personId      String?       @map("person_id")
  opportunityId String?       @map("opportunity_id")
  workspaceId   String        @map("workspace_id")
  createdById   String        @map("created_by_id")
  updatedById   String?       @map("updated_by_id")
  position      Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person      CrmPerson?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assignee    User?           @relation("CrmTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("CrmTaskCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?           @relation("CrmTaskUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@map("crm_tasks")
}

/// Nota vinculada opcionalmente a Company/Person/Opportunity.
model CrmNote {
  id            String    @id @default(cuid())
  title         String?
  body          String?
  companyId     String?   @map("company_id")
  personId      String?   @map("person_id")
  opportunityId String?   @map("opportunity_id")
  leadId        String?   @map("lead_id")
  workspaceId   String    @map("workspace_id")
  createdById   String    @map("created_by_id")
  updatedById   String?   @map("updated_by_id")
  position      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     CrmCompany?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person      CrmPerson?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  lead        CrmLead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("CrmNoteCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?           @relation("CrmNoteUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([deletedAt])
  @@map("crm_notes")
}

/// Log de atividade (timeline) append-only por registro.
model CrmActivity {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  actorUserId   String?  @map("actor_user_id")
  action        String
  entity        String
  entityId      String   @map("entity_id")
  companyId     String?  @map("company_id")
  personId      String?  @map("person_id")
  opportunityId String?  @map("opportunity_id")
  summary       String?
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("CrmActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([companyId, createdAt])
  @@index([personId, createdAt])
  @@index([opportunityId, createdAt])
  @@map("crm_activities")
}

enum CrmQuotaPeriod {
  MONTH
  QUARTER
}

/// Meta de receita por responsável e período (mês/trimestre), usada no forecast.
model CrmQuota {
  id           String         @id @default(cuid())
  workspaceId  String         @map("workspace_id")
  ownerId      String         @map("owner_id")
  period       CrmQuotaPeriod
  periodKey    String         @map("period_key")
  targetAmount Decimal        @default(0) @map("target_amount") @db.Decimal(14, 2)
  createdById  String         @map("created_by_id")
  updatedById  String?        @map("updated_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation("CrmQuotaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmQuotaCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmQuotaUpdatedBy", fields: [updatedById], references: [id])

  @@unique([workspaceId, ownerId, period, periodKey])
  @@index([workspaceId])
  @@index([workspaceId, period, periodKey])
  @@map("crm_quotas")
}

/// Relatório tabular salvo: fonte + colunas/filtros/agrupamento/ordenação (Json).
model CrmReport {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  /// Módulo dono do relatório (CRM ou COMMUNICATION/WhatsApp) — o motor é
  /// compartilhado, isto só filtra a listagem por área do produto.
  module      ModuleKind @default(CRM)
  name        String
  source      String
  columns     Json
  filters     Json
  groupBy     String?    @map("group_by")
  sort        Json?
  /// Mega-relatório: query normalizada (múltiplas fontes + JOIN/UNION +
  /// agregação). Quando nulo, os campos legados acima (source/columns/
  /// filters/groupBy/sort) sintetizam uma query de fonte única.
  query       Json?
  position    Int        @default(0)
  createdById String     @map("created_by_id")
  updatedById String?    @map("updated_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmReportCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmReportUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@index([workspaceId, module])
  @@map("crm_reports")
}

enum CrmWidgetType {
  CHART
  VIEW
  IFRAME
  RICH_TEXT
  /// "Vendas" kit (goal, ranking, pipeline…): metrics computed server-side.
  SALES
}

/// Dashboard customizável por workspace (grade de widgets).
model CrmDashboard {
  id          String     @id @default(cuid())
  title       String
  workspaceId String     @map("workspace_id")
  /// Módulo dono do dashboard (CRM ou COMMUNICATION/WhatsApp) — o motor é
  /// compartilhado, isto só filtra a listagem por área do produto.
  module      ModuleKind @default(CRM)
  createdById String     @map("created_by_id")
  updatedById String?    @map("updated_by_id")
  position    Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  /// Screens (pages) and TV rotation: {"pages":["Tela 1"],"rotateSeconds":0}.
  settings    Json       @default("{}")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("CrmDashboardCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                @relation("CrmDashboardUpdatedBy", fields: [updatedById], references: [id])
  widgets   CrmDashboardWidget[]
  tvLinks   CrmDashboardTvLink[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@index([workspaceId, module])
  @@map("crm_dashboards")
}

/// Widget de um dashboard (posição em grade x/y/w/h + config tipada por tipo).
model CrmDashboardWidget {
  id          String        @id @default(cuid())
  dashboardId String        @map("dashboard_id")
  type        CrmWidgetType
  x           Int           @default(0)
  y           Int           @default(0)
  w           Int           @default(4)
  h           Int           @default(6)
  /// Screen (page) of the dashboard the widget lives on, 0-based.
  page        Int           @default(0)
  config      Json
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  dashboard CrmDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("crm_dashboard_widgets")
}

/// Read-only TV link of a CRM dashboard (`/tv/<token>`): no login, the token
/// is the credential; revoking sets `revokedAt`. Data is read on behalf of
/// `createdById`, so the link dies when its creator leaves the workspace.
model CrmDashboardTvLink {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  dashboardId String    @map("dashboard_id")
  token       String    @unique
  name        String
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  dashboard CrmDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([dashboardId])
  @@map("crm_dashboard_tv_links")
}

enum CrmProposalSectionType {
  COVER
  COMPANY_PRESENTATION
  CLIENT_NEEDS
  SOLUTION
  SCOPE
  PRODUCTS_PRICING
  COMMERCIAL_TERMS
  TERMS_CONDITIONS
  SIGNATURE
}

enum CrmProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Template reutilizável de proposta: define quais das 9 seções de layout fixo
/// vêm habilitadas por padrão e o conteúdo boilerplate de cada uma. Uma
/// proposta pode ser gerada a partir de um template ou do zero.
model CrmProposalTemplate {
  id          String    @id @default(cuid())
  name        String
  description String?
  logoUrl     String?   @map("logo_url")
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                         @relation("CrmProposalTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                        @relation("CrmProposalTemplateUpdatedBy", fields: [updatedById], references: [id])
  sections  CrmProposalTemplateSection[]
  proposals CrmProposal[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_proposal_templates")
}

/// Uma das 9 seções de layout fixo dentro de um template. `defaultContent`
/// segue o mesmo shape (discriminado por `type`) validado por Zod na service.
model CrmProposalTemplateSection {
  id             String                 @id @default(cuid())
  templateId     String                 @map("template_id")
  type           CrmProposalSectionType
  order          Int                    @default(0)
  enabled        Boolean                @default(true)
  defaultContent Json?                  @map("default_content")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  template CrmProposalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, type])
  @@index([templateId])
  @@map("crm_proposal_template_sections")
}

/// Documento de proposta com layout fixo (seções travadas), escopado por
/// workspace e opcionalmente vinculado a cliente/contato/oportunidade.
/// `shareToken` opaco serve a página pública sem autenticação.
model CrmProposal {
  id             String            @id @default(cuid())
  name           String
  templateId     String?           @map("template_id")
  companyId      String?           @map("company_id")
  contactId      String?           @map("contact_id")
  opportunityId  String?           @map("opportunity_id")
  leadId         String?           @map("lead_id")
  responsibleId  String            @map("responsible_id")
  /// Fim da validade (vale até o fim desse dia, America/Sao_Paulo). `null` =
  /// sem validade — inclusive as propostas legadas, anteriores à validade padrão.
  validUntil     DateTime?         @map("valid_until")
  status         CrmProposalStatus @default(DRAFT)
  /// Aceite registrado pelo cliente na página pública.
  acceptedAt     DateTime?         @map("accepted_at")
  acceptedByName String?           @map("accepted_by_name")
  /// Quando o job diário marcou a proposta como EXPIRED.
  expiredAt      DateTime?         @map("expired_at")
  shareToken     String            @unique @map("share_token")
  workspaceId    String            @map("workspace_id")
  createdById    String            @map("created_by_id")
  updatedById    String?           @map("updated_by_id")
  position       Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")

  workspace         Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template          CrmProposalTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  company           CrmCompany?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact           CrmPerson?                    @relation("CrmProposalContact", fields: [contactId], references: [id], onDelete: SetNull)
  opportunity       CrmOpportunity?               @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  lead              CrmLead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  responsible       User                          @relation("CrmProposalResponsible", fields: [responsibleId], references: [id])
  createdBy         User                          @relation("CrmProposalCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                         @relation("CrmProposalUpdatedBy", fields: [updatedById], references: [id])
  sections          CrmProposalSection[]
  views             CrmProposalView[]
  leadPresentations CrmLeadProposalPresentation[]

  @@index([workspaceId])
  @@index([templateId])
  @@index([companyId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([status])
  @@index([status, validUntil])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_proposals")
}

/// Uma das 9 seções de layout fixo dentro de uma proposta. `content` segue um
/// shape estruturado por `type` (discriminated union no Zod), nunca HTML livre.
model CrmProposalSection {
  id         String                 @id @default(cuid())
  proposalId String                 @map("proposal_id")
  type       CrmProposalSectionType
  order      Int                    @default(0)
  enabled    Boolean                @default(true)
  content    Json
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, type])
  @@index([proposalId])
  @@map("crm_proposal_sections")
}

/// Beacon de visualização anônima de uma proposta pública (LGPD: IP com hash).
model CrmProposalView {
  id          String   @id @default(cuid())
  proposalId  String   @map("proposal_id")
  viewId      String   @map("view_id")
  ipHash      String   @map("ip_hash")
  durationMs  Int      @default(0) @map("duration_ms")
  reachedEnd  Boolean  @default(false) @map("reached_end")
  scrolledPct Int      @default(0) @map("scrolled_pct")
  referrer    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, viewId])
  @@index([proposalId])
  @@map("crm_proposal_views")
}

enum CrmFormStatus {
  DRAFT
  PUBLISHED
}

enum CrmFormAction {
  COMPANY
  PERSON
  LEAD
}

/// Formulário customizável de captação, escopado por workspace. `fields` é um
/// array de definições de campo (validado por Zod na camada de serviço).
model CrmForm {
  id              String        @id @default(cuid())
  name            String
  description     String?       @db.Text
  status          CrmFormStatus @default(DRAFT)
  publicToken     String        @unique @map("public_token")
  action          CrmFormAction @default(LEAD)
  fields          Json          @default("[]")
  phases          Json          @default("[]")
  successMessage  String?       @map("success_message")
  redirectUrl     String?       @map("redirect_url")
  submissionCount Int           @default(0) @map("submission_count")
  workspaceId     String        @map("workspace_id")
  createdById     String        @map("created_by_id")
  updatedById     String?       @map("updated_by_id")
  position        Int           @default(0)
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("CrmFormCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?               @relation("CrmFormUpdatedBy", fields: [updatedById], references: [id])
  submissions CrmFormSubmission[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_forms")
}

/// Envio de um formulário público. Cria Company/Person/Lead conforme `action`.
model CrmFormSubmission {
  id               String        @id @default(cuid())
  formId           String        @map("form_id")
  values           Json
  action           CrmFormAction
  createdPersonId  String?       @map("created_person_id")
  createdCompanyId String?       @map("created_company_id")
  createdLeadId    String?       @map("created_lead_id")
  ipHash           String?       @map("ip_hash")
  referrer         String?
  createdAt        DateTime      @default(now()) @map("created_at")

  form CrmForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("crm_form_submissions")
}

enum CrmAiMessageRole {
  USER
  ASSISTANT
}

/// Conversa do assistente de IA do workspace. Privada por usuário.
model CrmAiConversation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  title       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation("CrmAiConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  messages    CrmAiMessage[]
  usage       CrmAiUsage[]
  attachments CrmAiAttachment[]

  @@index([workspaceId, userId])
  @@map("crm_ai_conversations")
}

model CrmAiMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  role           CrmAiMessageRole
  content        String           @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation CrmAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  CrmAiAttachment[]

  @@index([conversationId])
  @@map("crm_ai_messages")
}

enum CrmAiAttachmentKind {
  IMAGE
  DOCUMENT
}

/// Anexo de uma mensagem do assistente de IA do CRM. `messageId` fica null
/// entre o upload e o envio da mensagem (o front sobe o arquivo antes de
/// digitar o texto); `POST .../messages` vincula os anexos pendentes à
/// mensagem criada. Anexos IMAGE viram um content-part de visão na chamada
/// à OpenAI (URL pré-assinada do MinIO); DOCUMENT só fica anexado como
/// referência hoje — extração de texto não está implementada.
model CrmAiAttachment {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  messageId      String?             @map("message_id")
  kind           CrmAiAttachmentKind
  filename       String
  contentType    String              @map("content_type")
  sizeBytes      Int                 @map("size_bytes")
  storageKey     String              @map("storage_key")
  createdAt      DateTime            @default(now()) @map("created_at")

  conversation CrmAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      CrmAiMessage?     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("crm_ai_attachments")
}

/// Contagem de tokens por chamada de modelo, para custeio/observabilidade.
model CrmAiUsage {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  conversationId String   @map("conversation_id")
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  model          String
  createdAt      DateTime @default(now()) @map("created_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation CrmAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("crm_ai_usage")
}

/// Chave de API para ingestão server-to-server (ex.: formulários externos
/// criando leads). Apenas o hash (SHA-256) é armazenado; o valor em claro é
/// mostrado uma única vez na criação.
model CrmIntegrationApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique @map("key_hash")
  prefix      String
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmIntegrationApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("crm_integration_api_keys")
}

model CrmEmailTemplate {
  id              String               @id @default(cuid())
  name            String
  subject         String
  contentHtml     String               @map("content_html") @db.Text
  contentJson     String?              @map("content_json") @db.Text
  /// Layout fixo de origem (ex.: "promo-announcement"), quando o template foi
  /// criado a partir de um modelo pronto em vez do editor de blocos livre.
  templateId      String?              @map("template_id")
  /// Valores dos campos editáveis (texto/imagem) desse layout fixo.
  templateProps   Json?                @map("template_props")
  /// LEGACY = HTML livre/layout antigo; BUILDER = editor visual (documento
  /// estruturado em `builderDocument`, ver docs/crm-email-builder.md).
  kind            CrmEmailTemplateKind @default(LEGACY)
  builderDocument Json?                @map("builder_document")
  /// Texto puro da última renderização (BUILDER), com variáveis intactas.
  contentText     String?              @map("content_text") @db.Text
  workspaceId     String               @map("workspace_id")
  createdById     String               @map("created_by_id")
  updatedById     String?              @map("updated_by_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                      @relation("CrmEmailTemplateCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                     @relation("CrmEmailTemplateUpdatedBy", fields: [updatedById], references: [id])
  campaigns CrmEmailCampaign[]
  versions  CrmEmailTemplateVersion[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("crm_email_templates")
}

enum CrmEmailTemplateKind {
  LEGACY
  BUILDER
}

/// Marca usada pelos templates do editor visual (uma por workspace). Sem
/// linha, vale o nome/logo do workspace e a cor padrão.
/// Why a version of a v2 e-mail template was recorded.
enum CrmEmailTemplateVersionReason {
  SAVE
  TEST_SEND
  CAMPAIGN
  RESTORE
}

/// Snapshot of a v2 (Steel Canvas) e-mail template: on "Salvar versão",
/// test sends, campaign use and restores. The newest 50 per template are kept.
model CrmEmailTemplateVersion {
  id             String                        @id @default(cuid())
  templateId     String                        @map("template_id")
  workspaceId    String                        @map("workspace_id")
  reason         CrmEmailTemplateVersionReason
  label          String?
  subject        String
  document       Json
  /// Hash of document + subject: an unchanged template records no new version.
  contentHash    String                        @map("content_hash")
  restoredFromId String?                       @map("restored_from_id")
  createdById    String?                       @map("created_by_id")
  createdAt      DateTime                      @default(now()) @map("created_at")

  template  CrmEmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("CrmEmailTemplateVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@map("crm_email_template_versions")
}

/// Reusable section or block of the e-mail editor ("Salvos"), shared by the
/// whole workspace. `fragment` is a Steel Canvas fragment validated by the
/// e-mail catalog.
model CrmEmailSavedBlock {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  category    String
  /// `section` or `block`: what the fragment's root is.
  kind        String
  fragment    Json
  nodeCount   Int      @map("node_count")
  /// Optional preview image URL (the editor renders a live preview otherwise).
  thumbnail   String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CrmEmailSavedBlockAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("crm_email_saved_blocks")
}

model CrmEmailBrand {
  id           String   @id @default(cuid())
  workspaceId  String   @unique @map("workspace_id")
  companyName  String   @map("company_name")
  logoUrl      String   @default("") @map("logo_url")
  primaryColor String   @map("primary_color")
  address      String   @default("")
  website      String   @default("")
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("crm_email_brands")
}

enum CrmCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum CrmCampaignRecipientScope {
  ALL
  SELECTED
}

enum CrmCampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  // Endereço descadastrado (opt-out LGPD) entre a criação e o envio.
  SKIPPED
}

model CrmEmailCampaign {
  id             String                    @id @default(cuid())
  subject        String
  contentHtml    String                    @map("content_html") @db.Text
  contentJson    String?                   @map("content_json") @db.Text
  /// Texto puro renderizado (template do editor visual), com variáveis.
  contentText    String?                   @map("content_text") @db.Text
  /// Template do editor visual de origem; o HTML/texto acima é o cache da
  /// renderização feita na criação da campanha.
  templateId     String?                   @map("template_id")
  /// URL rastreada que substitui `{{campaign_link}}` no envio.
  campaignLink   String?                   @map("campaign_link")
  fromAddress    String                    @map("from_address")
  status         CrmCampaignStatus         @default(DRAFT)
  recipientScope CrmCampaignRecipientScope @map("recipient_scope")
  scheduledAt    DateTime?                 @map("scheduled_at")
  sentAt         DateTime?                 @map("sent_at")
  workspaceId    String                    @map("workspace_id")
  createdById    String                    @map("created_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User                        @relation("CrmEmailCampaignCreatedBy", fields: [createdById], references: [id])
  template   CrmEmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients CrmEmailCampaignRecipient[]

  @@index([workspaceId])
  @@index([status])
  @@index([templateId])
  @@map("crm_email_campaigns")
}

/// Linha por destinatário da campanha; guarda snapshot de e-mail/nome no envio.
model CrmEmailCampaignRecipient {
  id                String                     @id @default(cuid())
  campaignId        String                     @map("campaign_id")
  personId          String?                    @map("person_id")
  email             String
  name              String?
  status            CrmCampaignRecipientStatus @default(PENDING)
  providerMessageId String?                    @map("provider_message_id")
  errorMessage      String?                    @map("error_message")
  sentAt            DateTime?                  @map("sent_at")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  campaign CrmEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([personId])
  @@index([status])
  @@map("crm_email_campaign_recipients")
}

enum CrmEmailOptOutSource {
  // Clique no link de descadastro do rodapé (página pública de confirmação)
  LINK
  // POST RFC 8058 disparado pelo provedor (List-Unsubscribe-Post)
  ONE_CLICK
}

/// Descadastro LGPD de campanhas de e-mail do CRM — por endereço e workspace.
/// Registra quando/como o titular saiu; campanhas futuras excluem o endereço
/// (e a pessoa vinculada). E-mails transacionais não consultam esta tabela.
model CrmEmailOptOut {
  id          String               @id @default(cuid())
  workspaceId String               @map("workspace_id")
  // Sempre minúsculo — chave de exclusão.
  email       String
  personId    String?              @map("person_id")
  campaignId  String?              @map("campaign_id")
  source      CrmEmailOptOutSource
  createdAt   DateTime             @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([personId])
  @@map("crm_email_opt_outs")
}

model CrmMailingList {
  id          String    @id @default(cuid())
  name        String
  description String?
  workspaceId String    @map("workspace_id")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
