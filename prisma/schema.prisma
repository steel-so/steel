// nov: z3-whatsapp-flows ───────────────────────────────────────────────────

enum WhatsAppFlowStatus {
  /// Never published to Meta (or saved there only as a draft).
  DRAFT
  /// Published at Meta: sendable to anyone.
  PUBLISHED
  /// Retired: kept for the answers it collected, no longer sendable.
  DEPRECATED
}

enum WhatsAppFlowCrmAction {
  NONE
  LEAD
  PERSON
  COMPANY
}

enum WhatsAppFlowResponseStatus {
  /// Sent, waiting for the contact to fill it in.
  SENT
  /// The contact submitted the form.
  COMPLETED
}

/// WhatsApp Flow (Z3): native Meta screens (sign-up, booking, survey) built
/// from `definition`, published to the WABA and sent by interactive message
/// or template. The answer is stored and mapped to the contact and the CRM.
model WhatsAppFlow {
  id                  String                @id @default(cuid())
  workspaceId         String                @map("workspace_id")
  /// Meta connection whose WABA owns the flow at Meta.
  connectionId        String                @map("connection_id")
  name                String
  description         String?
  /// Meta flow category (SIGN_UP, APPOINTMENT_BOOKING, SURVEY...).
  category            String                @default("OTHER")
  status              WhatsAppFlowStatus    @default(DRAFT)
  /// Screens and fields, edited freely.
  definition          Json
  /// Frozen copy of `definition` as last sent to Meta (null until then).
  publishedDefinition Json?                 @map("published_definition")
  publishedVersion    Int                   @default(0) @map("published_version")
  publishedAt         DateTime?             @map("published_at")
  metaFlowId          String?               @map("meta_flow_id")
  /// Status Meta reports for the flow (DRAFT, PUBLISHED, DEPRECATED...).
  metaStatus          String?               @map("meta_status")
  /// Last refusal from Meta, shown in the editor.
  publishError        String?               @map("publish_error") @db.Text
  /// Body of the interactive message that carries the flow.
  bodyText            String                @default("Preencha o formulário para continuar.") @map("body_text")
  /// Label of the button that opens the flow (max 30 chars at Meta).
  ctaLabel            String                @default("Preencher") @map("cta_label")
  /// Text sent right after the contact submits (inside the 24h window).
  confirmationText    String?               @map("confirmation_text")
  crmAction           WhatsAppFlowCrmAction @default(NONE) @map("crm_action")
  /// CRM form this flow was copied from, for reference only.
  sourceCrmFormId     String?               @map("source_crm_form_id")
  createdByUserId     String?               @map("created_by_user_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses WhatsAppFlowResponse[]

  @@index([workspaceId, status])
  @@index([connectionId])
  @@index([metaFlowId])
  @@map("whatsapp_flows")
}

/// One send of a flow to a contact and what came back. `flowToken` is the
/// opaque token Meta echoes in the answer, so the reply finds this row.
model WhatsAppFlowResponse {
  id                String                     @id @default(cuid())
  workspaceId       String                     @map("workspace_id")
  flowId            String                     @map("flow_id")
  contactId         String                     @map("contact_id")
  conversationId    String?                    @map("conversation_id")
  flowToken         String                     @unique @map("flow_token")
  status            WhatsAppFlowResponseStatus @default(SENT)
  sentByUserId      String?                    @map("sent_by_user_id")
  /// Outbound message that carried the flow.
  messageId         String?                    @map("message_id")
  /// Answers by field key (flow_token stripped).
  answers           Json?
  createdLeadId     String?                    @map("created_lead_id")
  createdPersonId   String?                    @map("created_person_id")
  createdCompanyId  String?                    @map("created_company_id")
  /// Why the CRM / contact mapping did not apply, when it did not.
  mappingNote       String?                    @map("mapping_note")
  sentAt            DateTime                   @default(now()) @map("sent_at")
  respondedAt       DateTime?                  @map("responded_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow      WhatsAppFlow    @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact   WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([flowId, status])
  @@index([workspaceId, sentAt])
  @@index([contactId])
  @@index([conversationId, status])
  @@map("whatsapp_flow_responses")
}

// nov: s2-major-incident

enum SdMajorIncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum SdMajorIncidentImpact {
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
}

/// How a child ticket got attached to a major incident (the linking API is
/// shared with the monitoring and automation slices).
enum SdIncidentLinkSource {
  MANUAL
  SUGGESTION
  MONITORING
  AUTOMATION
}

enum SdStatusChannel {
  EMAIL
  WHATSAPP
}

/// A major incident: declared from one INCIDENT ticket (the master), groups
/// the child tickets, may open a war room (swarm) and publishes updates on
/// customer-facing status pages. `title` and `summary` are customer-safe
/// text: they show on the public pages. User ids are plain strings (no FK) so
/// the User model stays untouched; the repository resolves the summaries.
model SdMajorIncident {
  id           String                @id @default(cuid())
  workspaceId  String                @map("workspace_id")
  ticketId     String                @map("ticket_id")
  title        String
  summary      String?
  impact       SdMajorIncidentImpact @default(PARTIAL_OUTAGE)
  status       SdMajorIncidentStatus @default(INVESTIGATING)
  commanderId  String?               @map("commander_id")
  /// War room: the swarm opened on the master ticket (no FK).
  swarmId      String?               @map("swarm_id")
  declaredById String?               @map("declared_by_id")
  resolvedById String?               @map("resolved_by_id")
  resolution   String?
  declaredAt   DateTime              @default(now()) @map("declared_at")
  resolvedAt   DateTime?             @map("resolved_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  ticket  SdTicket                @relation("SdMajorIncidentMaster", fields: [ticketId], references: [id], onDelete: Cascade)
  links   SdMajorIncidentTicket[]
  updates SdMajorIncidentUpdate[]
  pages   SdMajorIncidentPage[]

  @@index([workspaceId, status])
  @@index([ticketId, status])
  @@map("sd_major_incidents")
}

model SdMajorIncidentTicket {
  incidentId  String               @map("incident_id")
  ticketId    String               @map("ticket_id")
  workspaceId String               @map("workspace_id")
  source      SdIncidentLinkSource @default(MANUAL)
  linkedById  String?              @map("linked_by_id")
  linkedAt    DateTime             @default(now()) @map("linked_at")

  incident SdMajorIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ticket   SdTicket        @relation("SdMajorIncidentChild", fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([incidentId, ticketId])
  @@index([ticketId])
  @@index([workspaceId])
  @@map("sd_major_incident_tickets")
}

/// One entry of the incident timeline. `publish` puts it on the status pages
/// of the incident; the notify counters are filled by the delivery job.
model SdMajorIncidentUpdate {
  id           String                @id @default(cuid())
  incidentId   String                @map("incident_id")
  workspaceId  String                @map("workspace_id")
  status       SdMajorIncidentStatus
  message      String
  publish      Boolean               @default(false)
  authorId     String?               @map("author_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  /// Claimed by the delivery job before it sends (at-most-once).
  notifiedAt   DateTime?             @map("notified_at")
  notifyTotal  Int                   @default(0) @map("notify_total")
  notifySent   Int                   @default(0) @map("notify_sent")
  notifyFailed Int                   @default(0) @map("notify_failed")

  incident SdMajorIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@index([workspaceId])
  @@map("sd_major_incident_updates")
}

/// Public status page of a customer and/or a set of catalog services. The
/// slug is the public address (`/status-page/<slug>`), globally unique.
model SdStatusPage {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  name               String
  slug               String   @unique
  description        String?
  /// Customer the page is for (used to suggest the page when declaring).
  customerId         String?  @map("customer_id")
  /// Catalog services/categories the page covers (ids, no FK).
  serviceIds         String[] @default([]) @map("service_ids")
  published          Boolean  @default(true)
  allowSubscriptions Boolean  @default(true) @map("allow_subscriptions")
  /// Zone the public page formats dates in.
  timeZone           String   @default("America/Sao_Paulo") @map("time_zone")
  createdById        String?  @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  incidents    SdMajorIncidentPage[]
  subscribers  SdStatusSubscriber[]
  components   SdStatusComponent[]
  maintenances SdStatusMaintenancePage[]

  @@index([workspaceId])
  @@map("sd_status_pages")
}

model SdMajorIncidentPage {
  incidentId  String @map("incident_id")
  pageId      String @map("page_id")
  workspaceId String @map("workspace_id")

  incident SdMajorIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  page     SdStatusPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([incidentId, pageId])
  @@index([pageId])
  @@index([workspaceId])
  @@map("sd_major_incident_pages")
}

/// Who gets the e-mail/WhatsApp notices of a status page. Self-service
/// subscriptions (e-mail only) need the double opt-in (`confirmedAt`);
/// agent-added ones are confirmed on creation.
model SdStatusSubscriber {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  pageId      String          @map("page_id")
  channel     SdStatusChannel
  /// E-mail (lower case) or WhatsApp number (digits only, with country code).
  address     String
  name        String?
  token       String          @unique
  confirmedAt DateTime?       @map("confirmed_at")
  addedById   String?         @map("added_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  page SdStatusPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, channel, address])
  @@index([workspaceId])
  @@map("sd_status_subscribers")
}

// nov: a3-persona-simulation

enum SteelAgentSimulationStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  /// Not run: agent without owner, AI off, no owner, quota or model unavailable.
  SKIPPED
}

enum SteelAgentSimulationCaseStatus {
  QUEUED
  RUNNING
  /// Conversation ran and the judge scored it.
  DONE
  FAILED
}

enum SteelAgentSimulationVerdict {
  PASS
  FAIL
}

/// Whole-conversation simulation of an agent: every case is a scenario where
/// an AI plays a customer persona against the agent (reads real, writes
/// simulated) and an AI judge scores the transcript against the criteria.
model SteelAgentSimulation {
  id           String                     @id @default(cuid())
  workspaceId  String                     @map("workspace_id")
  agentId      String                     @map("agent_id")
  name         String
  status       SteelAgentSimulationStatus @default(QUEUED)
  startedById  String?                    @map("started_by_id")
  /// Minimum judge score (0-100) for a case to pass.
  passScore    Int                        @default(70) @map("pass_score")
  totalCases   Int                        @default(0) @map("total_cases")
  passedCases  Int                        @default(0) @map("passed_cases")
  failedCases  Int                        @default(0) @map("failed_cases")
  /// Average score of the judged cases (null until one is judged).
  avgScore     Int?                       @map("avg_score")
  inputTokens  Int                        @default(0) @map("input_tokens")
  outputTokens Int                        @default(0) @map("output_tokens")
  costUsd      Decimal                    @default(0) @map("cost_usd") @db.Decimal(14, 6)
  modelKey     String?                    @map("model_key")
  error        String?                    @db.Text
  /// Version under test when this run is the simulation gate of a version
  /// (the runner uses that version's instructions and tools).
  agentVersionId String?                  @map("agent_version_id")
  startedAt    DateTime?                  @map("started_at")
  finishedAt   DateTime?                  @map("finished_at")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  agent SteelAgent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  cases SteelAgentSimulationCase[]

  @@index([agentId, createdAt])
  @@index([workspaceId, status])
  @@map("steel_agent_simulations")
}

model SteelAgentSimulationCase {
  id              String                         @id @default(cuid())
  simulationId    String                         @map("simulation_id")
  position        Int
  label           String
  /// Preset key of the persona (null = custom persona).
  personaKey      String?                        @map("persona_key")
  /// Who the simulated customer is and how they behave.
  persona         String                         @db.Text
  /// The situation and what the customer wants.
  scenario        String                         @db.Text
  channel         String                         @default("WHATSAPP")
  openingMessage  String                         @map("opening_message") @db.Text
  /// string[]: what a good conversation must do.
  criteria        Json
  maxTurns        Int                            @default(6) @map("max_turns")
  status          SteelAgentSimulationCaseStatus @default(QUEUED)
  verdict         SteelAgentSimulationVerdict?
  score           Int?
  /// [{ role: 'customer' | 'agent', text }]
  transcript      Json?
  /// [{ turn, toolName, kind, status, title?, error? }]
  toolEvents      Json?                          @map("tool_events")
  /// [{ criterion, met, evidence }]
  criteriaResults Json?                          @map("criteria_results")
  judgeSummary    String?                        @map("judge_summary") @db.Text
  endReason       String?                        @map("end_reason")
  error           String?                        @db.Text
  inputTokens     Int                            @default(0) @map("input_tokens")
  outputTokens    Int                            @default(0) @map("output_tokens")
  costUsd         Decimal                        @default(0) @map("cost_usd") @db.Decimal(14, 6)
  startedAt       DateTime?                      @map("started_at")
  finishedAt      DateTime?                      @map("finished_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  simulation SteelAgentSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId, position])
  @@map("steel_agent_simulation_cases")
}

// nov: c1-sales-cadences ──────────────────────────────────────────────────

enum CrmCadenceStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CrmCadenceStepType {
  EMAIL
  WHATSAPP
  TASK
}

enum CrmCadenceDelayUnit {
  MINUTES
  HOURS
  DAYS
}

enum CrmCadenceEnrollmentStatus {
  ACTIVE
  PAUSED
  /// Stopped on its own because the lead answered.
  REPLIED
  COMPLETED
  STOPPED
}

enum CrmCadenceStopReason {
  REPLIED
  MANUAL
  LEAD_CLOSED
  LEAD_DELETED
  NO_CONTACT
  CADENCE_ARCHIVED
  CLICKED
}

enum CrmCadenceRunStatus {
  SENT
  SKIPPED
  FAILED
  /// Intent recorded before the send; settled by the same transaction that advances the enrollment.
  PENDING
}

/// Sales cadence: a sequence of steps (e-mail, WhatsApp, task) with delays,
/// run one lead at a time. Unlike a campaign (mass send) each enrollment
/// has its own clock and stops when the lead answers.
model CrmCadence {
  id                   String           @id @default(cuid())
  workspaceId          String           @map("workspace_id")
  name                 String
  description          String?
  status               CrmCadenceStatus @default(ACTIVE)
  /// From of the e-mail steps: a verified domain of the workspace or the platform address.
  emailFrom            String?          @map("email_from")
  emailReplyTo         String?          @map("email_reply_to")
  /// Connection used by the WhatsApp steps (COMMUNICATION module).
  whatsappConnectionId String?          @map("whatsapp_connection_id")
  stopOnReply          Boolean          @default(true) @map("stop_on_reply")
  /// A click on a tracked link of an e-mail step also ends the enrollment (off by default).
  stopOnClick          Boolean          @default(false) @map("stop_on_click")
  /// Send window, São Paulo time; both null = any hour.
  windowStartHour      Int?             @map("window_start_hour")
  windowEndHour        Int?             @map("window_end_hour")
  weekdaysOnly         Boolean          @default(true) @map("weekdays_only")
  createdById          String           @map("created_by_id")
  updatedById          String?          @map("updated_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       CrmCadenceStep[]
  enrollments CrmCadenceEnrollment[]
  runs        CrmCadenceRun[]

  @@index([workspaceId, status])
  @@index([deletedAt])
  @@map("crm_cadences")
}

/// One step; `delay*` counts from the previous step (the first one, from the enrollment).
model CrmCadenceStep {
  id                 String              @id @default(cuid())
  cadenceId          String              @map("cadence_id")
  workspaceId        String              @map("workspace_id")
  position           Int
  type               CrmCadenceStepType
  delayValue         Int                 @default(0) @map("delay_value")
  delayUnit          CrmCadenceDelayUnit @default(DAYS) @map("delay_unit")
  /// E-mail subject, or task title.
  subject            String?
  /// E-mail/WhatsApp text or task description, with {{nome}}, {{empresa}}… fields.
  body               String              @default("") @db.Text
  /// Meta WhatsApp template (required on Meta connections).
  whatsappTemplateId String?             @map("whatsapp_template_id")
  /// Body variables of the template, in order ({{1}}, {{2}}…), with merge fields.
  templateVariables  String[]            @default([]) @map("template_variables")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  cadence CrmCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  @@unique([cadenceId, position])
  @@map("crm_cadence_steps")
}

/// A lead running a cadence. `nextPosition` is the step to run at `nextRunAt`.
model CrmCadenceEnrollment {
  id           String                     @id @default(cuid())
  workspaceId  String                     @map("workspace_id")
  cadenceId    String                     @map("cadence_id")
  leadId       String                     @map("lead_id")
  status       CrmCadenceEnrollmentStatus @default(ACTIVE)
  nextPosition Int                        @default(0) @map("next_position")
  nextRunAt    DateTime?                  @map("next_run_at")
  /// Set while the worker holds the row; a stale claim is taken again.
  claimedAt    DateTime?                  @map("claimed_at")
  stopReason   CrmCadenceStopReason?      @map("stop_reason")
  /// EMAIL | WHATSAPP, when the lead answered.
  repliedVia   String?                    @map("replied_via")
  enrolledById String                     @map("enrolled_by_id")
  enrolledAt   DateTime                   @default(now()) @map("enrolled_at")
  finishedAt   DateTime?                  @map("finished_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  cadence CrmCadence      @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  lead    CrmLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  runs    CrmCadenceRun[]

  @@unique([cadenceId, leadId])
  @@index([status, nextRunAt])
  @@index([leadId])
  @@index([workspaceId])
  @@map("crm_cadence_enrollments")
}

/// What happened in each step execution (history of the enrollment).
model CrmCadenceRun {
  id                String              @id @default(cuid())
  workspaceId       String              @map("workspace_id")
  cadenceId         String              @map("cadence_id")
  enrollmentId      String              @map("enrollment_id")
  stepId            String?             @map("step_id")
  position          Int
  type              CrmCadenceStepType
  status            CrmCadenceRunStatus
  detail            String?
  providerMessageId String?             @map("provider_message_id")
  /// `<enrollmentId>:<position>` on steps that send a message: one row per step, ever.
  idempotencyKey    String?             @unique @map("idempotency_key")
  /// E-mail tracking (pixel + link redirect); first event and totals.
  openedAt          DateTime?           @map("opened_at")
  clickedAt         DateTime?           @map("clicked_at")
  openCount         Int                 @default(0) @map("open_count")
  clickCount        Int                 @default(0) @map("click_count")
  createdAt         DateTime            @default(now()) @map("created_at")

  cadence    CrmCadence           @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  enrollment CrmCadenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, createdAt])
  @@index([cadenceId, status])
  @@map("crm_cadence_runs")
}

