  sdChangeWindowsCreated    SdChangeWindow[]           @relation("SdChangeWindowCreatedBy")
  sdCabBoardsCreated        SdCabBoard[]               @relation("SdCabBoardCreatedBy")
  sdCabMemberships          SdCabMember[]              @relation("SdCabMemberUser")
  sdApprovalRoundsRequested SdApprovalRound[]          @relation("SdApprovalRoundRequestedBy")
  sdOnCallSchedulesCreated  SdOnCallSchedule[]         @relation("SdOnCallScheduleCreatedBy")
  sdOnCallParticipations    SdOnCallParticipant[]      @relation("SdOnCallParticipantUser")
  sdOnCallOverridesTaken    SdOnCallOverride[]         @relation("SdOnCallOverrideUser")
