// nov: z2-chatbot-builder

enum WhatsAppChatbotStatus {
  /// Never published, or unpublished: answers nothing.
  DRAFT
  /// Published and running on inbound conversations.
  ACTIVE
  /// Published but switched off; running sessions finish, no new ones start.
  PAUSED
}

enum WhatsAppChatbotTrigger {
  /// Every conversation that opens (new or reopened) without an assignee.
  NEW_CONVERSATION
  /// The first message contains one of the keywords.
  KEYWORD
  /// A conversation that opens outside the business hours of the workspace.
  OUTSIDE_BUSINESS_HOURS
}

enum WhatsAppChatbotSessionStatus {
  RUNNING
  HANDED_OFF_HUMAN
  HANDED_OFF_AI
  COMPLETED
  /// The contact stopped answering for longer than the bot's TTL.
  EXPIRED
  /// A person took the conversation over while the flow was running.
  CANCELLED
  /// The flow could not continue (loop guard, provider failure...).
  FAILED
}

/// Visual chatbot (Z2): a no-code flow that answers WhatsApp conversations
/// before a person or the AI does. `draft` is edited freely; `published` is
/// the frozen copy the runtime reads (null until the first publish).
model WhatsAppChatbot {
  id                String                 @id @default(cuid())
  workspaceId       String                 @map("workspace_id")
  /// Null = the bot answers on every connection of the workspace.
  connectionId      String?                @map("connection_id")
  name              String
  description       String?
  status            WhatsAppChatbotStatus  @default(DRAFT)
  triggerKind       WhatsAppChatbotTrigger @default(NEW_CONVERSATION) @map("trigger_kind")
  keywords          String[]               @default([])
  /// Minutes of silence after which a running session expires.
  sessionTtlMinutes Int                    @default(720) @map("session_ttl_minutes")
  draft             Json
  published         Json?
  publishedVersion  Int                    @default(0) @map("published_version")
  publishedAt       DateTime?              @map("published_at")
  createdByUserId   String?                @map("created_by_user_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  workspace  Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdBy  User?                    @relation("WhatsAppChatbotCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sessions   WhatsAppChatbotSession[]
  nodeStats  WhatsAppChatbotNodeStat[]

  @@index([workspaceId, status])
  @@index([connectionId])
  @@map("whatsapp_chatbots")
}

/// One run of a chatbot over a conversation. A conversation has at most one
/// RUNNING session (partial unique index created in the migration).
model WhatsAppChatbotSession {
  id             String                       @id @default(cuid())
  workspaceId    String                       @map("workspace_id")
  chatbotId      String                       @map("chatbot_id")
  conversationId String                       @map("conversation_id")
  status         WhatsAppChatbotSessionStatus @default(RUNNING)
  /// Version of the published flow this session runs (a republish does not
  /// change a session in flight).
  botVersion     Int                          @map("bot_version")
  /// Engine state: current node, what the bot waits for, variables.
  state          Json
  /// Frozen copy of the flow this session runs.
  definition     Json
  endReason      String?                      @map("end_reason")
  startedAt      DateTime                     @default(now()) @map("started_at")
  lastActivityAt DateTime                     @default(now()) @map("last_activity_at")
  endedAt        DateTime?                    @map("ended_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chatbot      WhatsAppChatbot      @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@index([chatbotId, status])
  @@index([workspaceId, startedAt])
  @@map("whatsapp_chatbot_sessions")
}

// nov: t1-nps-whatsapp ─────────────────────────────────────────────────────

enum SatisfactionSurveyKind {
  NPS
  CSAT
  CES
}

enum SatisfactionSurveyTrigger {
  CONVERSATION_CLOSED
  TICKET_RESOLVED
  MANUAL
}

enum SatisfactionSurveyChannel {
  WHATSAPP
  EMAIL
}

enum SatisfactionSurveyStatus {
  SCHEDULED
  SENT
  ANSWERED
  SKIPPED
  FAILED
}

/// Per-workspace rule that decides when a satisfaction survey goes out
/// (one per trigger). Off by default: nothing is sent until an admin enables it.
model SatisfactionSurveyConfig {
  id             String                    @id @default(cuid())
  workspaceId    String                    @map("workspace_id")
  trigger        SatisfactionSurveyTrigger
  kind           SatisfactionSurveyKind    @default(CSAT)
  enabled        Boolean                   @default(false)
  /// Minutes between the closing/resolution and the invitation.
  delayMinutes   Int                       @default(5) @map("delay_minutes")
  /// Hours the invitation stays answerable.
  expiresInHours Int                       @default(72) @map("expires_in_hours")
  /// Days before the same recipient is surveyed again.
  cooldownDays   Int                       @default(30) @map("cooldown_days")
  /// Falls back to e-mail when WhatsApp is not possible or fails.
  emailFallback  Boolean                   @default(true) @map("email_fallback")
  questionText   String?                   @map("question_text")
  thankYouText   String?                   @map("thank_you_text")
  /// Tells the workspace admins when a detractor answer arrives.
  alertDetractors Boolean                  @default(true) @map("alert_detractors")
  /// Highest score that counts as a detractor; null = the default of the kind.
  detractorMaxScore Int?                   @map("detractor_max_score")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  surveys   SatisfactionSurvey[]

  @@unique([workspaceId, trigger])
  @@map("satisfaction_survey_configs")
}

/// One invitation and (once answered) its response. Names are snapshots so
/// the reports survive renames and removals.
model SatisfactionSurvey {
  id                String                    @id @default(cuid())
  workspaceId       String                    @map("workspace_id")
  configId          String?                   @map("config_id")
  kind              SatisfactionSurveyKind
  trigger           SatisfactionSurveyTrigger
  channel           SatisfactionSurveyChannel
  status            SatisfactionSurveyStatus  @default(SCHEDULED)
  /// Opaque token of the public e-mail link.
  token             String                    @unique
  conversationId    String?                   @map("conversation_id")
  ticketId          String?                   @map("ticket_id")
  connectionId      String?                   @map("connection_id")
  recipientPhone    String?                   @map("recipient_phone")
  recipientEmail    String?                   @map("recipient_email")
  recipientName     String?                   @map("recipient_name")
  /// Grouping key of the customer (company id, contact id or phone).
  customerKey       String?                   @map("customer_key")
  customerName      String?                   @map("customer_name")
  /// Agent (conversation) or technician (ticket) who handled it.
  assigneeUserId    String?                   @map("assignee_user_id")
  assigneeName      String?                   @map("assignee_name")
  teamId            String?                   @map("team_id")
  teamName          String?                   @map("team_name")
  score             Int?
  comment           String?
  providerMessageId String?                   @map("provider_message_id")
  failureReason     String?                   @map("failure_reason")
  scheduledFor      DateTime                  @map("scheduled_for")
  sentAt            DateTime?                 @map("sent_at")
  answeredAt        DateTime?                 @map("answered_at")
  expiresAt         DateTime                  @map("expires_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  config    SatisfactionSurveyConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)

  @@index([workspaceId, answeredAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, recipientPhone, status])
  @@index([ticketId])
  @@index([conversationId])
  @@map("satisfaction_surveys")
}

// ─── nov: c2-cnpj-enrichment ──────────────────────────────────────────────

enum CrmCnpjRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  /// Cancelled by an admin (cooperative: checked between companies).
  CANCELED
}

/// Receita Federal profile of a CrmCompany (one row per company, refreshed in
/// place). The company's own columns (name, address) are only filled from it
/// by the enrichment service; this keeps the raw registry data (legal name,
/// CNAE, size, partners) next to them.
model CrmCompanyEnrichment {
  id                 String    @id @default(cuid())
  companyId          String    @unique @map("company_id")
  workspaceId        String    @map("workspace_id")
  cnpj               String
  legalName          String?   @map("legal_name")
  tradeName          String?   @map("trade_name")
  cnaeCode           String?   @map("cnae_code")
  cnaeDescription    String?   @map("cnae_description")
  secondaryCnaes     Json      @default("[]") @map("secondary_cnaes")
  size               String?
  legalNature        String?   @map("legal_nature")
  registrationStatus String?   @map("registration_status")
  openedAt           DateTime? @map("opened_at") @db.Date
  shareCapital       Decimal?  @map("share_capital") @db.Decimal(16, 2)
  partners           Json      @default("[]")
  source             String    @default("brasilapi")
  fetchedAt          DateTime  @default(now()) @map("fetched_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  company CrmCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("crm_company_enrichments")
}

/// One bulk "re-enrich the base" run, executed by the worker in pages.
model CrmCnpjEnrichmentRun {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  createdById String           @map("created_by_id")
  status      CrmCnpjRunStatus @default(QUEUED)
  onlyMissing Boolean          @default(true) @map("only_missing")
  overwrite   Boolean          @default(false)
  total       Int              @default(0)
  processed   Int              @default(0)
  enriched    Int              @default(0)
  notFound    Int              @default(0) @map("not_found")
  invalid     Int              @default(0)
  failed      Int              @default(0)
  error       String?
  /// Set when an admin asked to stop; the worker checks it between companies.
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  startedAt   DateTime?        @map("started_at")
  finishedAt  DateTime?        @map("finished_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@map("crm_cnpj_enrichment_runs")
}

// nov: s1-asset-inventory

enum SdInventorySource {
  AGENT
  SNMP
  /// nov: inventory-followups — achado por ping/ARP, ainda sem gestão.
  DISCOVERY
}

enum SdInventoryAlertKind {
  DISK
  RAM
}

enum SdInventoryAlertStatus {
  OPEN
  RESOLVED
}

enum SdInventoryScanStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// Limiares e política do inventário, uma linha por workspace (criada sob
/// demanda com os padrões abaixo).
model SdInventorySettings {
  workspaceId          String   @id @map("workspace_id")
  /// Alerta quando a ocupação de um volume chega a este percentual.
  diskThresholdPercent Int      @default(90) @map("disk_threshold_percent")
  ramThresholdPercent  Int      @default(90) @map("ram_threshold_percent")
  /// Sem contato há tantos dias = "sem sinal" na lista.
  staleAfterDays       Int      @default(7) @map("stale_after_days")
  /// Cria/atualiza o item na CMDB sozinho a cada relatório.
  syncConfigItems      Boolean  @default(true) @map("sync_config_items")
  /// Tipo da CMDB usado nos itens criados (nulo = "Computador"/"Rede").
  defaultTypeId        String?  @map("default_type_id")
  /// nov: inventory-followups — o agente pode se atualizar sozinho (desligado por padrão).
  agentAutoUpdate      Boolean  @default(false) @map("agent_auto_update")
  updatedAt            DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sd_inventory_settings")
}

/// Token por workspace usado pelo agente para enviar o relatório. Só o
/// SHA-256 é guardado; o valor em claro aparece uma vez, na criação.
model SdInventoryToken {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  tokenHash   String    @unique @map("token_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SdInventoryTokenCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("sd_inventory_tokens")
}

/// Máquina ou equipamento descoberto (agente ou SNMP). `externalKey` é a
/// identidade estável (id do agente, ou `snmp:<ip>`), única por workspace.
model SdInventoryDevice {
  id           String            @id @default(cuid())
  workspaceId  String            @map("workspace_id")
  configItemId String?           @unique @map("config_item_id")
  source       SdInventorySource
  externalKey  String            @map("external_key")
  hostname     String
  osName       String?           @map("os_name")
  osVersion    String?           @map("os_version")
  arch         String?
  manufacturer String?
  model        String?
  serialNumber String?           @map("serial_number")
  cpuModel     String?           @map("cpu_model")
  cpuCores     Int?              @map("cpu_cores")
  ramTotalMb   Int?              @map("ram_total_mb")
  ramUsedMb    Int?              @map("ram_used_mb")
  ipAddresses  String[]          @default([]) @map("ip_addresses")
  macAddresses String[]          @default([]) @map("mac_addresses")
  /// [{mount,label?,fs?,totalMb,usedMb}]
  disks        Json              @default("[]")
  agentVersion String?           @map("agent_version")
  snmpTargetId String?           @map("snmp_target_id")
  tokenId      String?           @map("token_id")
  /// nov: inventory-followups — `false` = descoberto por ping/ARP e ainda não adotado.
  managed      Boolean           @default(true)
  /// Descartado pelo admin: a descoberta não o mostra de novo.
  ignored      Boolean           @default(false)
  discoveryRangeId String?       @map("discovery_range_id")
  /// Equipamento principal quando esta ficha é a mesma máquina vista por outra origem.
  mergedIntoId String?           @map("merged_into_id")
  /// `true` depois de um "desfazer mescla": a mescla automática não repete.
  mergeLocked  Boolean           @default(false) @map("merge_locked")
  firstSeenAt  DateTime          @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime          @default(now()) @map("last_seen_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configItem SdConfigItem?          @relation(fields: [configItemId], references: [id], onDelete: SetNull)
  snmpTarget SdInventorySnmpTarget? @relation(fields: [snmpTargetId], references: [id], onDelete: SetNull)
  software   SdInventorySoftware[]
  alerts     SdInventoryAlert[]
  mergedInto SdInventoryDevice?     @relation("SdInventoryMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom SdInventoryDevice[]    @relation("SdInventoryMerge")

  @@unique([workspaceId, externalKey])
  @@index([workspaceId, lastSeenAt])
  @@index([workspaceId, mergedIntoId])
  @@map("sd_inventory_devices")
}

/// Software instalado, substituído por inteiro a cada relatório do agente.
model SdInventorySoftware {
  id        String  @id @default(cuid())
  deviceId  String  @map("device_id")
  name      String
  version   String  @default("")
  publisher String?

  device SdInventoryDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, name, version])
  @@index([name])
  @@map("sd_inventory_software")
}

/// Alerta de disco ou RAM. Uma linha por (equipamento, tipo, volume): abre
/// quando passa do limiar, resolve quando volta, reabre se repetir.
model SdInventoryAlert {
  id          String                 @id @default(cuid())
  workspaceId String                 @map("workspace_id")
  deviceId    String                 @map("device_id")
  kind        SdInventoryAlertKind
  /// Ponto de montagem / letra do volume; vazio para RAM.
  mount       String                 @default("")
  status      SdInventoryAlertStatus @default(OPEN)
  usedPercent Int                    @map("used_percent")
  threshold   Int
  openedAt    DateTime               @default(now()) @map("opened_at")
  resolvedAt  DateTime?              @map("resolved_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  device SdInventoryDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, kind, mount])
  @@index([workspaceId, status])
  @@map("sd_inventory_alerts")
}

/// Alvo de varredura SNMP (v2c): faixas CIDR/IPs varridas pelo worker.
model SdInventorySnmpTarget {
  id              String                 @id @default(cuid())
  workspaceId     String                 @map("workspace_id")
  name            String
  /// CIDR (`10.0.0.0/24`) ou IP avulso.
  ranges          String[]
  port            Int                    @default(161)
  /// Community cifrada com `CONNECTION_SECRETS`.
  communityEnc    String                 @map("community_enc")
  /// nov: inventory-followups — v3 usa usuário + chaves cifradas (a community fica vazia).
  snmpVersion     SdSnmpVersion          @default(V2C) @map("snmp_version")
  v3Username      String?                @map("v3_username")
  v3AuthProtocol  SdSnmpAuthProtocol?    @map("v3_auth_protocol")
  v3AuthKeyEnc    String?                @map("v3_auth_key_enc")
  v3PrivProtocol  SdSnmpPrivProtocol?    @map("v3_priv_protocol")
  v3PrivKeyEnc    String?                @map("v3_priv_key_enc")
  intervalMinutes Int                    @default(1440) @map("interval_minutes")
  active          Boolean                @default(true)
  customerId      String?                @map("customer_id")
  nextRunAt       DateTime?              @map("next_run_at")
  lastRunAt       DateTime?              @map("last_run_at")
  lastStatus      SdInventoryScanStatus? @map("last_status")
  lastFound       Int                    @default(0) @map("last_found")
  lastError       String?                @map("last_error")
  createdById     String                 @map("created_by_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                @relation("SdInventorySnmpTargetCreatedBy", fields: [createdById], references: [id])
  devices   SdInventoryDevice[]

  @@index([workspaceId])
  @@index([active, nextRunAt])
  @@map("sd_inventory_snmp_targets")
}

// nov: s6-swarming

enum SdSwarmStatus {
  OPEN
  CLOSED
}

enum SdSwarmMemberStatus {
  INVITED
  JOINED
  DECLINED
}

/// Swarming: specialists called straight into a ticket, bypassing the N1/N2/N3
/// escalation levels. Optionally mirrored by a temporary private Slack channel
/// that is archived when the swarm closes.
model SdSwarm {
  id               String        @id @default(cuid())
  workspaceId      String        @map("workspace_id")
  ticketId         String        @map("ticket_id")
  status           SdSwarmStatus @default(OPEN)
  /// Why the specialists are needed (shown to the invitees).
  reason           String
  /// What was decided when the swarm closed.
  outcome          String?
  /// Temporary Slack channel (private), when the starter asked for one.
  slackChannelId   String?       @map("slack_channel_id")
  slackChannelName String?       @map("slack_channel_name")
  /// Why the channel was not created (kept so the UI can explain it).
  slackError       String?       @map("slack_error")
  slackArchivedAt  DateTime?     @map("slack_archived_at")
  startedById      String?       @map("started_by_id")
  closedById       String?       @map("closed_by_id")
  startedAt        DateTime      @default(now()) @map("started_at")
  closedAt         DateTime?     @map("closed_at")

  ticket    SdTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  startedBy User?           @relation("SdSwarmStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  closedBy  User?           @relation("SdSwarmClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  members   SdSwarmMember[]

  @@index([ticketId, status])
  @@index([workspaceId, status])
  @@map("sd_swarms")
}

model SdSwarmMember {
  swarmId     String              @map("swarm_id")
  userId      String              @map("user_id")
  status      SdSwarmMemberStatus @default(INVITED)
  invitedById String?             @map("invited_by_id")
  invitedAt   DateTime            @default(now()) @map("invited_at")
  respondedAt DateTime?           @map("responded_at")

  swarm SdSwarm @relation(fields: [swarmId], references: [id], onDelete: Cascade)
  user  User    @relation("SdSwarmMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([swarmId, userId])
  @@index([userId, status])
  @@map("sd_swarm_members")
}

