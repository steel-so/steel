  /// CRM: opportunity assigned to a new owner.
  CRM_OPPORTUNITY_ASSIGNED
  /// CRM: lead closed as won or lost.
  CRM_DEAL_CLOSED
  /// CRM: task assigned.
  CRM_TASK_ASSIGNED
  /// CRM: task due within 1 h or overdue.
  CRM_TASK_DUE
  /// CRM: proposal opened by the client for the first time.
  CRM_PROPOSAL_VIEWED
  /// CRM: proposal accepted by the client.
  CRM_PROPOSAL_ACCEPTED
  /// CRM: Apollo.io lead import finished (summary for the creator).
  CRM_APOLLO_IMPORT_DONE
  /// CRM: proposal expired without an answer.
  CRM_PROPOSAL_EXPIRED
  /// CRM: public form submitted.
  CRM_FORM_SUBMITTED
  /// CRM: e-mail campaign finished (sent or failed).
  CRM_CAMPAIGN_FINISHED
  /// CRM: workflow run failed.
  CRM_WORKFLOW_FAILED
  /// CRM: workflow run waiting for a human action.
  CRM_WORKFLOW_WAITING
  /// CRM: scheduled social post failed.
  CRM_SOCIAL_POST_FAILED
  /// CRM: competitor sync failed.
  CRM_COMPETITOR_SYNC_FAILED
  /// Platform: invitation accepted, new workspace member.
