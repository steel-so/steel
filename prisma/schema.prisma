  SD_TICKET_CREATED
  SD_TICKET_MENTIONED
  SD_TICKET_PHASE_CHANGED
  SD_TICKET_RESOLVED
  SD_TICKET_REOPENED
  SD_APPROVAL_REQUESTED
  SD_TASK_ASSIGNED
  SD_TICKET_CSAT
  SD_DIGEST
  /// Risco preditivo: o chamado deve violar o SLA se nada mudar.
  SD_SLA_BREACH_PREDICTED
