  LOGOS
  PRODUCTS
}

model CrmLandingPage {
  id          String               @id @default(cuid())
  title       String
  templateKey String               @map("template_key")
  status      CrmLandingPageStatus @default(DRAFT)
  shareToken  String               @unique @map("share_token")
  publishedAt DateTime?            @map("published_at")
  workspaceId String               @map("workspace_id")
  createdById String               @map("created_by_id")
  updatedById String?              @map("updated_by_id")
  position    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                    @relation("CrmLandingPageCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                   @relation("CrmLandingPageUpdatedBy", fields: [updatedById], references: [id])
  views     CrmLandingPageView[]
  sections  CrmLandingPageSection[]

  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_landing_pages")
}

/// Uma seção da página, escolhida e ordenada pelo usuário a partir do
/// vocabulário fixo de tipos. Sem unique em (landingPageId, type): o mesmo
/// tipo pode se repetir (o kit de referência tem templates com 2 blocos de
/// Testimonial). `content` segue um shape estruturado por `type`
/// (discriminated union no Zod), nunca HTML livre.
model CrmLandingPageSection {
  id            String                    @id @default(cuid())
  landingPageId String                    @map("landing_page_id")
  type          CrmLandingPageSectionType
  order         Int                       @default(0)
  enabled       Boolean                   @default(true)
  content       Json
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  landingPage CrmLandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@index([landingPageId])
  @@map("crm_landing_page_sections")
}

/// Beacon de visualização anônima de uma landing page pública (LGPD: IP com hash).
model CrmLandingPageView {
  id            String   @id @default(cuid())
  landingPageId String   @map("landing_page_id")
  viewId        String   @map("view_id")
  ipHash        String   @map("ip_hash")
  durationMs    Int      @default(0) @map("duration_ms")
  ctaClicks     Int      @default(0) @map("cta_clicks")
  referrer      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  landingPage CrmLandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, viewId])
  @@index([landingPageId])
  @@map("crm_landing_page_views")
}

enum CrmSocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  GOOGLE_ANALYTICS
  TWITTER
  GOOGLE_ADS
  LINKEDIN
}

enum CrmSocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

/// Registro de uma conta social vinculada ao workspace via OAuth real
/// (Fase 13). Tokens ficam cifrados em repouso (AES-256-GCM, ver
/// src/lib/social/crypto.ts) — nunca expostos em DTO. `externalAccountId`/
/// `accountName` continuam preenchíveis manualmente para o fluxo legado
/// (conta já autorizada fora do Steel), mas o fluxo principal agora é o
/// handshake OAuth completo por plataforma.
model CrmSocialConnection {
  id                String                    @id @default(cuid())
  platform          CrmSocialPlatform
  externalAccountId String                    @map("external_account_id")
  accountName       String?                   @map("account_name")
  accessToken       String?                   @map("access_token")
  refreshToken      String?                   @map("refresh_token")
  tokenExpiresAt    DateTime?                 @map("token_expires_at")
  scope             String?
  isPrimary         Boolean                   @default(false) @map("is_primary")
  status            CrmSocialConnectionStatus @default(CONNECTED)
  workspaceId       String                    @map("workspace_id")
  createdById       String                    @map("created_by_id")
  updatedById       String?                   @map("updated_by_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  workspace       Workspace                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User                                @relation("CrmSocialConnectionCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?                               @relation("CrmSocialConnectionUpdatedBy", fields: [updatedById], references: [id])
  metricSnapshots CrmSocialConnectionMetricSnapshot[]
  posts           CrmSocialConnectionPost[]

  @@unique([workspaceId, platform, externalAccountId])
  @@index([workspaceId, platform])
  @@map("crm_social_connections")
}

/// Snapshot diário de métricas da própria conta conectada — contraparte de
/// `CrmCompetitorMetricSnapshot`, necessário para comparar "nós vs.
/// concorrente" na mesma escala de tempo. Gravado pelo mesmo job
/// `CrmCompetitorSync`.
model CrmSocialConnectionMetricSnapshot {
  id             String   @id @default(cuid())
  connectionId   String   @map("connection_id")
  followersCount Int      @map("followers_count")
  postsCount     Int?     @map("posts_count")
  capturedAt     DateTime @default(now()) @map("captured_at")

  connection CrmSocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, capturedAt])
  @@map("crm_social_connection_metric_snapshots")
}

/// Biblioteca reordenável de "hooks" (linhas de abertura/copy reaproveitável
/// para posts sociais).
model CrmHookVaultItem {
  id          String             @id @default(cuid())
  text        String
  platform    CrmSocialPlatform?
  usageCount  Int                @default(0) @map("usage_count")
  notes       String?
  workspaceId String             @map("workspace_id")
  createdById String             @map("created_by_id")
  updatedById String?            @map("updated_by_id")
  position    Int                @default(0)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmHookVaultItemCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("CrmHookVaultItemUpdatedBy", fields: [updatedById], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_hook_vault_items")
}

/// Status de sincronização automática de métricas de um concorrente.
/// `MANUAL`: cadastrado à mão, sem sync (plataforma não suportada ou nunca
/// sincronizado). `SYNCED`: último sync OK. `SYNC_FAILED`: última tentativa
/// falhou (perfil privado/inexistente ou sem conta conectada na plataforma).
enum CrmCompetitorSyncStatus {
  MANUAL
  SYNCED
  SYNC_FAILED
}

/// Perfil social de um concorrente rastreado. Pode ser cadastrado manualmente
/// ou via autofill (Instagram/YouTube), e sincronizado diariamente pelo job
/// `CrmCompetitorSync` — ver `CrmCompetitorMetricSnapshot` para o histórico.
model CrmTrackedCompetitor {
  id             String                  @id @default(cuid())
  platform       CrmSocialPlatform
  handle         String
  profileUrl     String?                 @map("profile_url")
  followersCount Int?                    @map("followers_count")
  avatarUrl      String?                 @map("avatar_url")
  displayName    String?                 @map("display_name")
  bio            String?
  syncStatus     CrmCompetitorSyncStatus @default(MANUAL) @map("sync_status")
  lastSyncedAt   DateTime?               @map("last_synced_at")
  notes          String?
  workspaceId    String                  @map("workspace_id")
  createdById    String                  @map("created_by_id")
  updatedById    String?                 @map("updated_by_id")
  position       Int                     @default(0)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  deletedAt      DateTime?               @map("deleted_at")

  workspace       Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User                          @relation("CrmTrackedCompetitorCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?                         @relation("CrmTrackedCompetitorUpdatedBy", fields: [updatedById], references: [id])
  metricSnapshots CrmCompetitorMetricSnapshot[]
  posts           CrmCompetitorPost[]
  ideaSets        CrmCompetitorIdeaSet[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([workspaceId, position])
  @@map("crm_tracked_competitors")
}

/// Normalized format of a collected post (Instagram and YouTube share one
/// vocabulary so competitor and own account compare side by side). SHORT is
/// a heuristic: the YouTube API does not flag Shorts, so videos up to 60 s
/// count as SHORT.
enum CrmSocialPostFormat {
  IMAGE
  CAROUSEL
  VIDEO
  REELS
  SHORT
}

/// Public post of a competitor, collected by the `CrmCompetitorSync` job
/// (upsert by `externalId`, so counts refresh on every run). Only the
/// company's public data — never comments or who commented. A null
/// `likeCount` means the profile owner hid likes.
model CrmCompetitorPost {
  id            String              @id @default(cuid())
  competitorId  String              @map("competitor_id")
  externalId    String              @map("external_id")
  format        CrmSocialPostFormat
  caption       String?
  permalink     String?
  likeCount     Int?                @map("like_count")
  commentsCount Int?                @map("comments_count")
  viewCount     Int?                @map("view_count")
  publishedAt   DateTime            @map("published_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  competitor CrmTrackedCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, externalId])
  @@index([competitorId, publishedAt])
  @@map("crm_competitor_posts")
}

/// Counterpart of `CrmCompetitorPost` for the workspace's own connected
/// account, so the analysis compares both on the same basis. Same job.
model CrmSocialConnectionPost {
  id            String              @id @default(cuid())
  connectionId  String              @map("connection_id")
  externalId    String              @map("external_id")
  format        CrmSocialPostFormat
  caption       String?
  permalink     String?
  likeCount     Int?                @map("like_count")
  commentsCount Int?                @map("comments_count")
  viewCount     Int?                @map("view_count")
  publishedAt   DateTime            @map("published_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  connection CrmSocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, publishedAt])
  @@map("crm_social_connection_posts")
}

/// Post ideas generated by the workspace AI (ADR 0007) from a competitor
/// analysis. One row per generation; the screen shows the latest so a visit
/// does not spend quota.
model CrmCompetitorIdeaSet {
  id           String   @id @default(cuid())
  competitorId String   @map("competitor_id")
  range        String
  ideas        Json
  modelKey     String   @map("model_key")
  createdById  String?  @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  competitor CrmTrackedCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  createdBy  User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([competitorId, createdAt])
  @@map("crm_competitor_idea_sets")
}

/// Snapshot diário de métricas públicas de um concorrente (série histórica
/// usada para calcular taxa de crescimento e variação de seguidores).
/// Gravado pelo job `CrmCompetitorSync`; sem `createdBy` porque é
/// system-generated, não uma ação de usuário.
model CrmCompetitorMetricSnapshot {
  id             String   @id @default(cuid())
  competitorId   String   @map("competitor_id")
  followersCount Int      @map("followers_count")
  postsCount     Int?     @map("posts_count")
  capturedAt     DateTime @default(now()) @map("captured_at")

  competitor CrmTrackedCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
  @@map("crm_competitor_metric_snapshots")
}

/// PARTIALLY_FAILED = ao menos um alvo publicou e ao menos um falhou (vide
/// CrmScheduledPostTarget para o detalhe). DRAFT é reservado para posts
/// legados criados sem `scheduledFor`.
enum CrmScheduledPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_FAILED
  FAILED
  CANCELED
}

enum CrmScheduledPostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

/// Tipo de mídia anexada a um CrmScheduledPost — determina para quais
/// plataformas o post é elegível (ex.: VIDEO habilita YouTube/TikTok).
enum CrmScheduledMediaKind {
  IMAGE
  VIDEO
}

model CrmScheduledPost {
  id           String                 @id @default(cuid())
  content      String                 @default("") @db.Text
  title        String?
  options      Json?
  status       CrmScheduledPostStatus @default(DRAFT)
  scheduledFor DateTime?              @map("scheduled_for")
  publishedAt  DateTime?              @map("published_at")
  lastError    String?                @map("last_error")
  workspaceId  String                 @map("workspace_id")
  createdById  String                 @map("created_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  deletedAt    DateTime?              @map("deleted_at")

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                     @relation("CrmScheduledPostCreatedBy", fields: [createdById], references: [id])
  targets   CrmScheduledPostTarget[]
  media     CrmScheduledPostMedia[]

  @@index([workspaceId])
  @@index([status, scheduledFor])
  @@index([deletedAt])
  @@map("crm_scheduled_posts")
}

/// `error` explica por que o alvo não foi publicado. `externalPostId` guarda
/// o id retornado pela rede após publicar; `attempts` conta tentativas do
/// cron/publish manual (idempotência/observabilidade).
model CrmScheduledPostTarget {
  id             String                       @id @default(cuid())
  postId         String                       @map("post_id")
  platform       CrmSocialPlatform
  status         CrmScheduledPostTargetStatus @default(PENDING)
  externalPostId String?                      @map("external_post_id")
  error          String?
  attempts       Int                          @default(0)
  publishedAt    DateTime?                    @map("published_at")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")

  post CrmScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
  @@index([postId])
  @@map("crm_scheduled_post_targets")
}

/// Mídia anexada a um CrmScheduledPost. Os bytes vivem no MinIO sob
/// `storageKey`; aqui só os metadados. `order` mantém a sequência.
model CrmScheduledPostMedia {
  id          String                @id @default(cuid())
  postId      String                @map("post_id")
  kind        CrmScheduledMediaKind
  storageKey  String                @map("storage_key")
  contentType String                @map("content_type")
  sizeBytes   Int                   @map("size_bytes")
  order       Int                   @default(0)
  createdAt   DateTime              @default(now()) @map("created_at")

  post CrmScheduledPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("crm_scheduled_post_media")
}

enum CrmEmailProvider {
  GMAIL
  OUTLOOK
}

enum CrmMailDirection {
  INBOUND
  OUTBOUND
}

/// Registro de conta de e-mail vinculada a um usuário do workspace. Este
/// módulo NÃO implementa o sync real contra Gmail/Outlook (exige client
/// OAuth por provedor, não fornecido) — `lastSyncedAt` permanece null;
/// CrmEmailMessage/CrmCalendarEvent são preenchidos manualmente pelo usuário
/// como registro de atividade, não por importação automática.
model CrmEmailAccount {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  userId       String           @map("user_id")
  provider     CrmEmailProvider
  email        String
  lastSyncedAt DateTime?        @map("last_synced_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User               @relation("CrmEmailAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  messages  CrmEmailMessage[]
  events    CrmCalendarEvent[]

  @@unique([workspaceId, userId, provider])
  @@index([workspaceId])
  @@map("crm_email_accounts")
}

/// E-mail registrado manualmente (não sincronizado), vinculado a um contato
/// e/ou oportunidade para dar contexto de histórico de comunicação.
model CrmEmailMessage {
  id            String           @id @default(cuid())
  workspaceId   String           @map("workspace_id")
  accountId     String?          @map("account_id")
  createdById   String           @map("created_by_id")
  direction     CrmMailDirection
  subject       String?
  snippet       String?          @db.Text
  fromEmail     String           @map("from_email")
  toEmails      String[]         @default([]) @map("to_emails")
  personId      String?          @map("person_id")
  opportunityId String?          @map("opportunity_id")
  sentAt        DateTime         @map("sent_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     CrmEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("CrmEmailMessageCreatedBy", fields: [createdById], references: [id])
  person      CrmPerson?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([personId, sentAt])
  @@index([opportunityId, sentAt])
  @@map("crm_email_messages")
}

/// Evento de agenda registrado manualmente, vinculado a um contato e/ou
/// oportunidade.
model CrmCalendarEvent {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  accountId     String?  @map("account_id")
  createdById   String   @map("created_by_id")
  title         String
  description   String?
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  attendees     String[] @default([])
  personId      String?  @map("person_id")
  opportunityId String?  @map("opportunity_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     CrmEmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("CrmCalendarEventCreatedBy", fields: [createdById], references: [id])
  person      CrmPerson?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunity CrmOpportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([personId, startsAt])
  @@index([opportunityId, startsAt])
  @@map("crm_calendar_events")
}

// ─── CRM multichannel campaigns (e-mail + optional WhatsApp) ─────────────
// One campaign = destination (landing page or form) + e-mail content +
// audience, with WhatsApp as an optional add-on. See ADR 0025.

enum CrmCampaignRunStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  CANCELED
  FAILED
}

enum CrmCampaignDestinationType {
  LANDING_PAGE
  FORM
  /// A page of a published site (Sites builder).
  SITE_PAGE
}

/// LGPD legal basis declared for a channel at launch.
enum CrmCampaignLegalBasis {
  CONSENT
  LEGITIMATE_INTEREST
  CONTRACT
}

/// Per-recipient, per-channel delivery state. NONE = channel not used for
/// this recipient (no address or channel off); SENDING = claimed by a job.
enum CrmCampaignDeliveryStatus {
  NONE
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum CrmCampaignChannel {
  EMAIL
  WHATSAPP
}

enum CrmCampaignConversionKind {
  LANDING_VIEW
  FORM_SUBMISSION
  /// Page view of a published site.
  SITE_VIEW
  /// CRM form sent from a published site page (`site.form`).
  SITE_FORM_SUBMISSION
}

model CrmCampaign {
  id                   String                      @id @default(cuid())
  workspaceId          String                      @map("workspace_id")
  name                 String
  /// utm_campaign value — unique per workspace.
  slug                 String
  status               CrmCampaignRunStatus        @default(DRAFT)
  destinationType      CrmCampaignDestinationType? @map("destination_type")
  landingPageId        String?                     @map("landing_page_id")
  formId               String?                     @map("form_id")
  /// Site + page of a SITE_PAGE destination.
  siteId               String?                     @map("site_id")
  sitePageId           String?                     @map("site_page_id")
  utmMedium            String                      @default("campanha") @map("utm_medium")
  emailFrom            String?                     @map("email_from")
  emailSubject         String?                     @map("email_subject")
  emailPreheader       String?                     @map("email_preheader")
  emailTemplateId      String?                     @map("email_template_id")
  emailLegalBasis      CrmCampaignLegalBasis?      @map("email_legal_basis")
  /// { mailingListIds, allPeople, leadStages } — see crm-campaign.schema.ts.
  audience             Json                        @default("{}")
  whatsappEnabled      Boolean                     @default(false) @map("whatsapp_enabled")
  whatsappConnectionId String?                     @map("whatsapp_connection_id")
  whatsappTemplateId   String?                     @map("whatsapp_template_id")
  /// Meta template variable mapping (header/body/buttons → source).
  whatsappVariables    Json?                       @map("whatsapp_variables")
  whatsappText         String?                     @map("whatsapp_text")
  whatsappMediaUrl     String?                     @map("whatsapp_media_url")
  /// Z-API: quick reply whose buttons (and media) go with the text.
  whatsappQuickReplyId String?                     @map("whatsapp_quick_reply_id")
  whatsappDelayHours   Int                         @default(0) @map("whatsapp_delay_hours")
  whatsappLegalBasis   CrmCampaignLegalBasis?      @map("whatsapp_legal_basis")
  scheduledAt          DateTime?                   @map("scheduled_at")
  /// Send window in America/Sao_Paulo hours [start, end); null = any time.
  sendWindowStartHour  Int?                        @map("send_window_start_hour")
  sendWindowEndHour    Int?                        @map("send_window_end_hour")
  sendWeekdaysOnly     Boolean                     @default(false) @map("send_weekdays_only")
  consentConfirmedAt   DateTime?                   @map("consent_confirmed_at")
  consentConfirmedById String?                     @map("consent_confirmed_by_id")
  launchedAt           DateTime?                   @map("launched_at")
  /// When sending starts (scheduledAt or the launch moment).
  startAt              DateTime?                   @map("start_at")
  completedAt          DateTime?                   @map("completed_at")
  createdById          String                      @map("created_by_id")
  updatedById          String?                     @map("updated_by_id")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  deletedAt            DateTime?                   @map("deleted_at")

  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients  CrmCampaignRecipient[]
  conversions CrmCampaignConversion[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, deletedAt])
  @@index([status, startAt])
  @@map("crm_campaigns")
}

/// Audience snapshot taken at launch — one row per contact, with the state
/// and funnel timestamps of each channel.
model CrmCampaignRecipient {
  id                        String                    @id @default(cuid())
  campaignId                String                    @map("campaign_id")
  workspaceId               String                    @map("workspace_id")
  personId                  String?                   @map("person_id")
  leadId                    String?                   @map("lead_id")
  name                      String
  email                     String?
  /// WhatsApp number, digits only (E.164 without "+").
  waId                      String?                   @map("wa_id")
  emailStatus               CrmCampaignDeliveryStatus @default(NONE) @map("email_status")
  emailSkipReason           String?                   @map("email_skip_reason")
  emailProviderMessageId    String?                   @unique @map("email_provider_message_id")
  emailError                String?                   @map("email_error")
  emailSentAt               DateTime?                 @map("email_sent_at")
  emailDeliveredAt          DateTime?                 @map("email_delivered_at")
  emailOpenedAt             DateTime?                 @map("email_opened_at")
  emailClickedAt            DateTime?                 @map("email_clicked_at")
  emailBouncedAt            DateTime?                 @map("email_bounced_at")
  unsubscribedAt            DateTime?                 @map("unsubscribed_at")
  whatsappStatus            CrmCampaignDeliveryStatus @default(NONE) @map("whatsapp_status")
  whatsappSkipReason        String?                   @map("whatsapp_skip_reason")
  whatsappProviderMessageId String?                   @unique @map("whatsapp_provider_message_id")
  whatsappError             String?                   @map("whatsapp_error")
  whatsappSentAt            DateTime?                 @map("whatsapp_sent_at")
  whatsappDeliveredAt       DateTime?                 @map("whatsapp_delivered_at")
  whatsappReadAt            DateTime?                 @map("whatsapp_read_at")
  whatsappClickedAt         DateTime?                 @map("whatsapp_clicked_at")
  whatsappRepliedAt         DateTime?                 @map("whatsapp_replied_at")
  /// Comunicação conversation opened by the contact's reply.
  conversationId            String?                   @map("conversation_id")
  convertedAt               DateTime?                 @map("converted_at")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")

  campaign    CrmCampaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversions CrmCampaignConversion[]

  @@index([campaignId, emailStatus])
  @@index([campaignId, whatsappStatus])
  @@index([workspaceId, waId])
  @@map("crm_campaign_recipients")
}

/// A visit or submission on the campaign destination, attributed through
/// the tracked link (recipient) or the utm_campaign slug (no recipient).
model CrmCampaignConversion {
  id          String                    @id @default(cuid())
  campaignId  String                    @map("campaign_id")
  recipientId String?                   @map("recipient_id")
  channel     CrmCampaignChannel?
  kind        CrmCampaignConversionKind
  /// Landing view id or form submission id — idempotency key.
  sourceRef   String                    @map("source_ref")
  leadId      String?                   @map("lead_id")
  personId    String?                   @map("person_id")
  /// Site, page and CRM form where it happened (site analytics).
  siteId      String?                   @map("site_id")
  sitePageId  String?                   @map("site_page_id")
  formId      String?                   @map("form_id")
  createdAt   DateTime                  @default(now()) @map("created_at")

  campaign  CrmCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CrmCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([campaignId, kind, sourceRef])
  @@index([campaignId, createdAt])
  @@index([siteId, createdAt])
  @@map("crm_campaign_conversions")
}

// ─── Changelog (admin, cross-workspace) ───────────────────────────────────

enum ChangelogStatus {
  DRAFT
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ChangelogRecipientStatus {
  PENDING
  SENT
  FAILED
}

/// E-mail de novidades disparado pelo admin global da plataforma (não é
/// por workspace) — cobre tanto avisos jurídicos (ex: mudança nos Termos)
/// quanto changelog de produto, através de uma lista de itens livre.
model Changelog {
  id          String          @id @default(cuid())
  subject     String
  status      ChangelogStatus @default(DRAFT)
  createdById String          @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items      ChangelogItem[]
  recipients ChangelogRecipient[]

  @@index([status])
  @@map("changelogs")
}

/// Um bloco de conteúdo dentro do e-mail (título + texto + imagem opcional
/// embutida no corpo, não anexo). Posição controla a ordem de exibição.
model ChangelogItem {
  id          String  @id @default(cuid())
  changelogId String  @map("changelog_id")
  title       String
  body        String
  imageUrl    String? @map("image_url")
  position    Int     @default(0)

  changelog Changelog @relation(fields: [changelogId], references: [id], onDelete: Cascade)

  @@index([changelogId, position])
  @@map("changelog_items")
}

/// Destinatário de um envio — `userId` nulo quando o e-mail foi colado
/// manualmente pelo admin em vez de selecionado de um usuário existente.
model ChangelogRecipient {
  id           String                   @id @default(cuid())
  changelogId  String                   @map("changelog_id")
  email        String
  userId       String?                  @map("user_id")
  status       ChangelogRecipientStatus @default(PENDING)
  errorMessage String?                  @map("error_message")
  sentAt       DateTime?                @map("sent_at")
  createdAt    DateTime                 @default(now()) @map("created_at")

  changelog Changelog @relation(fields: [changelogId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([changelogId, email])
  @@index([changelogId, status])
  @@map("changelog_recipients")
}

/// Ajustes de IA do workspace: modelos habilitados (chaves
/// `"<provider>:<model>"` do catálogo em `src/lib/ai/models.ts`), modelo
/// padrão por funcionalidade e cota mensal de consumo. Sem linha = padrões
/// da plataforma (tudo habilitado, `openai:gpt-4o-mini`, US$ 50/mês).
/// `usdPer1kTokens` está DEPRECIADO (ADR 0019): era a regra fixa de custo
/// (1000 tokens = US$ 4,00) e não é mais lido. O custo agora vem do preço
/// do modelo (`AI_MODEL_CATALOG`) × a margem da plataforma
/// (`PlatformAiSettings.costMargin`). A coluna fica pelo histórico.
model WorkspaceAiSettings {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique @map("workspace_id")
  enabledModels           String[] @map("enabled_models")
  crmAssistantModel       String   @map("crm_assistant_model")
  whatsappReplyModel      String   @map("whatsapp_reply_model")
  whatsappSentimentModel  String   @map("whatsapp_sentiment_model")
  monthlyQuotaUsd         Decimal  @default(50) @map("monthly_quota_usd") @db.Decimal(12, 2)
  /// Deprecated (ADR 0019) — not read anymore; kept for history.
  usdPer1kTokens          Decimal  @default(4) @map("usd_per_1k_tokens") @db.Decimal(12, 4)
  /// Kill switch for the Steel AI "agente" mode (write tools). Off = the
  /// assistant only explores, whatever the user picks.
  agentModeEnabled        Boolean  @default(true) @map("agent_mode_enabled")
  /// Master switch for every Steel AI feature in the workspace.
  aiEnabled               Boolean  @default(true) @map("ai_enabled")
  /// Steel Agents may run (schedule, events, manual).
  agentsEnabled           Boolean  @default(true) @map("agents_enabled")
  /// Steel AI may save and use memories (workspace + personal).
  memoryEnabled           Boolean  @default(true) @map("memory_enabled")
  /// AUTOPILOT mode allowed: writes run without per-action confirmation.
  autopilotEnabled        Boolean  @default(false) @map("autopilot_enabled")
  /// Weekly Steel AI usage summary e-mailed to the OWNERs (Mondays).
  usageWeeklyEmailEnabled Boolean  @default(true) @map("usage_weekly_email_enabled")
  /// External AI clients connected over MCP with `mcp:write` may create,
  /// update and run actions (DELETE is never exposed). Off by default.
  mcpWriteEnabled         Boolean  @default(false) @map("mcp_write_enabled")
  /// Model of the AGENT task class (Steel Agents, ADR 0042). Null = the
  /// platform default for agents, else the assistant model.
  agentModel              String?  @map("agent_model")
  /// Automatic failover to another provider/model when the chosen one fails
  /// or times out (ADR 0042). On by default.
  failoverEnabled         Boolean  @default(true) @map("failover_enabled")
  /// Proactive AI (ADR 0040): insights feed and daily digest. On by default.
  proactiveEnabled        Boolean  @default(true) @map("proactive_enabled")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_settings")
}

/// What the AI masks before a call leaves for the provider (ADR 0041).
enum AiPiiMaskingPolicy {
  OFF
  /// Only unattended replies to third parties: WhatsApp auto-reply and the
  /// ServiceDesk pre-service.
  AUTO_REPLIES
  EVERYWHERE
}

/// Steel AI guardrails of a workspace (ADR 0041). No row = defaults (mask in
/// auto-replies, no classifier, no topic or authority limit).
model WorkspaceAiGuardrails {
  id                         String             @id @default(cuid())
  workspaceId                String             @unique @map("workspace_id")
  piiMaskingPolicy           AiPiiMaskingPolicy @default(AUTO_REPLIES) @map("pii_masking_policy")
  /// Ambiguous third-party text goes to a cheap model that tells whether it
  /// is an instruction to the AI (cost counted as AI_GUARDRAIL).
  injectionClassifierEnabled Boolean            @default(false) @map("injection_classifier_enabled")
  /// Auto-replies hand off to a human when the customer or the draft
  /// touches one of these topics.
  forbiddenTopics            String[]           @default([]) @map("forbidden_topics")
  /// Authority limits of the auto-replies. Null = no limit configured;
  /// 0 = never promise it.
  maxDiscountPercent         Int?               @map("max_discount_percent")
  maxRefundAmount            Decimal?           @map("max_refund_amount") @db.Decimal(12, 2)
  maxDeadlineDays            Int?               @map("max_deadline_days")
  updatedById                String?            @map("updated_by_id")
  createdAt                  DateTime           @default(now()) @map("created_at")
  updatedAt                  DateTime           @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_guardrails")
}

/// Modelo de IA escolhido pelo usuário dentro de um workspace (assistente do
/// CRM). Só vale se continuar habilitado no workspace — senão cai no padrão.
model UserAiPreference {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  modelKey    String   @map("model_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("user_ai_preferences")
}

enum AiUsageFeature {
  CRM_ASSISTANT
  WHATSAPP_REPLY
  WHATSAPP_SENTIMENT
  SERVICEDESK_COPILOT
  SERVICEDESK_PRE_SERVICE
  SERVICEDESK_TRIAGE
  STEEL_ASSISTANT
  STEEL_AGENT
  WIKI_ASSISTANT
  /// Embeddings of the Steel AI knowledge index (indexing and queries).
  KNOWLEDGE_SEARCH
  /// Eval runs (ADR 0039): the evaluated answer and the LLM judge.
  AI_EVAL
  /// Prompt-injection classifier of the guardrails (ADR 0041).
  AI_GUARDRAIL
  /// Call recordings: transcription (per minute) and summary (ADR 0043).
  PHONE_CALL_AI
  /// Proactive AI (ADR 0040): phrasing of the daily digest intro.
  PROACTIVE_DIGEST
  /// IVR voice attendant (ADR 0046): realtime audio tokens of the call.
  VOICE_AGENT
  /// T2: automatic QA review of a conversation or ticket.
  QA_REVIEW
}

/// Livro-razão de consumo de IA de todas as funcionalidades — base da cota
/// mensal. `costUsd` é congelado no momento da chamada (tokens × preço do
/// modelo × margem da plataforma vigentes — ADR 0019; linhas anteriores
/// seguem a regra antiga de US$ 4/1000 tokens). `userId` nulo para jobs em
/// background.
model AiUsage {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  userId         String?        @map("user_id")
  feature        AiUsageFeature
  provider       String
  model          String
  inputTokens    Int            @default(0) @map("input_tokens")
  outputTokens   Int            @default(0) @map("output_tokens")
  costUsd        Decimal        @map("cost_usd") @db.Decimal(14, 6)
  /// Analytics scope: the module whose tools the call touched (null =
  /// platform or no tool), plus the conversation / agent run it came from.
  module         ModuleKind?
  conversationId String?        @map("conversation_id")
  agentRunId     String?        @map("agent_run_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@map("ai_usage")
}

// ─── Steel AI (cross-system assistant) ───────────────────────────────────────

/// EXPLORE = read-only tools; AGENT = write tools too, every write goes
/// through an AiPendingAction confirmed by a human.
enum AiConversationMode {
  /// "Ask" in the UI.
  EXPLORE
  /// "Build" in the UI.
  AGENT
  /// Writes run without per-action confirmation (still logged); requires
  /// WorkspaceAiSettings.autopilotEnabled.
  AUTOPILOT
  /// "Teste" in the UI: reads run for real, every write (memory included) is
  /// simulated server-side from its preview — nothing is written or sent.
  TEST
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// Steel AI conversation, private to its user.
model AiConversation {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  userId      String             @map("user_id")
  title       String?
  mode        AiConversationMode @default(EXPLORE)
  /// Model used by the last turn ("<provider>:<model>"), informational.
  modelKey    String?            @map("model_key")
  pinnedAt    DateTime?          @map("pinned_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AiMessage[]
  pendingActions AiPendingAction[]
  attachments    AiAttachment[]

  @@index([workspaceId, userId, updatedAt])
  @@map("ai_conversations")
}

/// One turn of the transcript. ASSISTANT rows may carry `toolCalls`
/// (AiToolCall[]) and `raw` (provider-native content re-sent on the next
/// tool round); TOOL rows carry `toolCallId`/`toolName` and the JSON result
/// in `content`. Persisting tool rounds lets a conversation resume exactly.
model AiMessage {
  id             String        @id @default(cuid())
  conversationId String        @map("conversation_id")
  role           AiMessageRole
  content        String        @db.Text
  toolCalls      Json?         @map("tool_calls")
  toolCallId     String?       @map("tool_call_id")
  toolName       String?       @map("tool_name")
  raw            Json?
  modelKey       String?       @map("model_key")
  inputTokens    Int           @default(0) @map("input_tokens")
  outputTokens   Int           @default(0) @map("output_tokens")
  createdAt      DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiActionKind {
  CREATE
  UPDATE
  DELETE
  /// Domain operation that is not plain CRUD (assign, move phase, send).
  ACTION
}

enum AiPendingActionStatus {
  PENDING
  EXECUTED
  FAILED
  CANCELED
  EXPIRED
}

/// A write proposed by the assistant (or by a Steel Agent) that only runs
/// after a human confirms it through its own endpoint — the model can never
/// confirm on its own. `args` is the validated tool input; `preview` is
/// what the UI shows (AiToolPreview). DELETE requires a double confirmation.
model AiPendingAction {
  id                    String                @id @default(cuid())
  workspaceId           String                @map("workspace_id")
  /// User who asked (assistant) — and the only one who may confirm there.
  /// Null when the action came from a Steel Agent run.
  requestedById         String?               @map("requested_by_id")
  conversationId        String?               @map("conversation_id")
  /// Steel Agent run that proposed it (relation added in the agents wave).
  agentRunId            String?               @map("agent_run_id")
  toolName              String                @map("tool_name")
  /// Provider tool_call id, to answer the model after the decision.
  toolCallId            String?               @map("tool_call_id")
  kind                  AiActionKind
  module                ModuleKind?
  args                  Json
  preview               Json
  status                AiPendingActionStatus @default(PENDING)
  requiresDoubleConfirm Boolean               @default(false) @map("requires_double_confirm")
  result                Json?
  error                 String?
  expiresAt             DateTime              @map("expires_at")
  decidedById           String?               @map("decided_by_id")
  decidedAt             DateTime?             @map("decided_at")
  executedAt            DateTime?             @map("executed_at")
  /// Executed straight away in AUTOPILOT mode (born claimed, never PENDING).
  autoExecuted          Boolean               @default(false) @map("auto_executed")
  /// MCP grant whose external AI client proposed it (ADR 0032); null for
  /// the in-app assistant and Steel Agents.
  integrationGrantId    String?               @map("integration_grant_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy      User?             @relation("AiPendingActionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy        User?             @relation("AiPendingActionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  conversation     AiConversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentRun         SteelAgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  integrationGrant IntegrationGrant? @relation(fields: [integrationGrantId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([conversationId])
  @@index([agentRunId])
  @@index([integrationGrantId])
  @@map("ai_pending_actions")
}

enum AiActionSource {
  ASSISTANT
  AGENT
  /// External AI client through the public MCP server (ADR 0032).
  MCP
  /// IVR voice attendant, acting as the workspace's configured identity (ADR 0046).
  VOICE
  /// WhatsApp auto-reply calling an allow-listed tool (nov: ai-actions).
  WHATSAPP
}

/// Durable trail of every write executed by AI (assistant or agent), on top
/// of the Axiom audit log — powers the "what did the AI change" history.
model AiActionLog {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  source          AiActionSource
  /// Human who confirmed (assistant) or approved (agent); null when an
  /// agent ran an automatic tool.
  actorId         String?        @map("actor_id")
  agentId         String?        @map("agent_id")
  pendingActionId String?        @unique @map("pending_action_id")
  toolName        String         @map("tool_name")
  kind            AiActionKind
  module          ModuleKind?
  targetType      String?        @map("target_type")
  targetId        String?        @map("target_id")
  args            Json
  /// `success` | `failure` | `simulated` (Teste mode: nothing was executed).
  outcome         String
  /// pt-BR summary of what the tool did (null on failure).
  summary         String?
  error           String?
  /// OAuth client of an MCP write (no relation: the trail outlives it).
  oauthClientId   String?        @map("oauth_client_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([targetType, targetId])
  @@map("ai_action_logs")
}

/// Platform-wide AI settings, edited by the global admin. Single row
/// (`id = "default"`); no row = defaults. `costMargin` multiplies the
/// provider price of every AI call before it is frozen in `AiUsage.costUsd`
/// (ADR 0019).
model PlatformAiSettings {
  id                  String   @id @default("default")
  costMargin          Decimal  @default(1) @map("cost_margin") @db.Decimal(8, 4)
  /// Semantic half of the Steel AI knowledge search (ADR 0037). Off = the
  /// index is text-only and nothing is sent to the embedding provider.
  embeddingsEnabled   Boolean  @default(true) @map("embeddings_enabled")
  /// Default model of each task class (ADR 0042) for workspaces that did
  /// not choose one. Null = the platform default model.
  classificationModel String?  @map("classification_model")
  conversationModel   String?  @map("conversation_model")
  assistantModel      String?  @map("assistant_model")
  agentModel          String?  @map("agent_model")
  /// Platform-wide switch of the provider failover (ADR 0042).
  failoverEnabled     Boolean  @default(true) @map("failover_enabled")
  updatedById         String?  @map("updated_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("platform_ai_settings")
}

enum AiAttachmentKind {
  IMAGE
  DOCUMENT
}

/// File or photo sent to Steel AI. Uploaded before the message is sent
/// (`messageId` null until then). IMAGE goes to the model as vision input;
/// DOCUMENT is sent as `extractedText` (bounded).
model AiAttachment {
  id             String           @id @default(cuid())
  workspaceId    String           @map("workspace_id")
  conversationId String           @map("conversation_id")
  messageId      String?          @map("message_id")
  uploadedById   String           @map("uploaded_by_id")
  kind           AiAttachmentKind
  filename       String
  contentType    String           @map("content_type")
  sizeBytes      Int              @map("size_bytes")
  storageKey     String           @map("storage_key")
  extractedText  String?          @map("extracted_text") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([messageId])
  @@map("ai_attachments")
}

enum AiScope {
  WORKSPACE
  PERSONAL
}

/// Reusable instruction invoked with "/<slug>" in the chat (or picked by
/// the model when the request matches its description), also usable by
/// Steel Agents. Built-in skills ship with the product (`builtIn`).
model AiSkill {
  id           String              @id @default(cuid())
  workspaceId  String              @map("workspace_id")
  scope        AiScope
  /// Owner of a PERSONAL skill; null for WORKSPACE scope.
  ownerId      String?             @map("owner_id")
  slug         String
  name         String
  description  String
  instructions String              @db.Text
  /// Suggested mode when invoked (null = keep the conversation mode).
  mode         AiConversationMode?
  /// Optional tool allowlist hint (empty = any available tool).
  toolNames    String[]            @map("tool_names")
  enabled      Boolean             @default(true)
  builtIn      Boolean             @default(false) @map("built_in")
  createdById  String?             @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
  @@index([workspaceId, ownerId])
  @@map("ai_skills")
}

enum AiMemorySource {
  AUTO
  MANUAL
}

/// A fact Steel AI keeps about the workspace (WORKSPACE scope, shared) or
/// about one user (PERSONAL). Saved automatically by the model or by hand;
/// always reviewable and deletable in the Memória tab.
model AiMemory {
  id                   String         @id @default(cuid())
  workspaceId          String         @map("workspace_id")
  scope                AiScope
  /// Owner of a PERSONAL memory; null for WORKSPACE scope.
  userId               String?        @map("user_id")
  content              String         @db.Text
  source               AiMemorySource
  sourceConversationId String?        @map("source_conversation_id")
  createdById          String?        @map("created_by_id")
  lastUsedAt           DateTime?      @map("last_used_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
  @@index([workspaceId, userId])
  @@map("ai_memories")
}

// ─── Steel AI — avaliação e feedback (ADR 0039) ──────────────────────────────

/// Where an AI answer was shown. `targetId` points at a different record
/// per surface: AiMessage (STEEL_AI_MESSAGE), SteelAgentRun
/// (STEEL_AGENT_RUN), SdTicket (SD_COPILOT, SD_TRIAGE), SdKbArticle
/// (SD_KCS_DRAFT), WhatsAppMessage sent by the AI (WHATSAPP_AUTO_REPLY).
enum AiFeedbackSurface {
  STEEL_AI_MESSAGE
  STEEL_AGENT_RUN
  SD_COPILOT
  SD_TRIAGE
  SD_KCS_DRAFT
  WHATSAPP_AUTO_REPLY
}

enum AiFeedbackRating {
  UP
  DOWN
}

/// One person's thumbs up/down on one AI answer (one row per user, surface,
/// target and variant; rating again replaces it). `reason`/`comment` may
/// carry personal data: the rows go with the user (cascade).
model AiFeedback {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  userId      String            @map("user_id")
  surface     AiFeedbackSurface
  targetId    String            @map("target_id")
  /// Sub-answer of the target (copilot `summary` | `reply` | `solution` |
  /// `classification`); empty when the target has a single answer.
  variant     String            @default("")
  rating      AiFeedbackRating
  /// Preset reason code (see AI_FEEDBACK_REASONS), optional.
  reason      String?
  comment     String?           @db.Text
  /// "<provider>:<model>" that produced the answer, resolved by the server.
  modelKey    String?           @map("model_key")
  module      ModuleKind?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("AiFeedbackUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surface, targetId, variant])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, surface, targetId])
  @@map("ai_feedback")
}

/// What an eval set exercises: the Steel AI assistant (optionally with a
/// skill) or the WhatsApp auto-reply prompt + knowledge documents.
enum AiEvalTarget {
  STEEL_ASSISTANT
  WHATSAPP_REPLY
  /// Steel Agent edits: the set gates the publication of a new version.
  STEEL_AGENT
}

/// A workspace's test set: questions with the expected answer/criteria.
model AiEvalSet {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  name        String
  description String?
  target      AiEvalTarget
  /// STEEL_ASSISTANT only: skill applied to every case (null = none).
  skillId     String?      @map("skill_id")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("AiEvalSetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cases     AiEvalCase[]
  runs      AiEvalRun[]

  @@index([workspaceId, target])
  @@map("ai_eval_sets")
}

/// One test case: the question and how to grade the answer (expected
/// answer and/or criteria for the LLM judge, plus simple text checks).
model AiEvalCase {
  id              String   @id @default(cuid())
  setId           String   @map("set_id")
  input           String   @db.Text
  expected        String?  @db.Text
  criteria        String?  @db.Text
  mustContain     String[] @map("must_contain")
  mustNotContain  String[] @map("must_not_contain")
  /// Steel AI message the case was saved from ("salvar como caso de teste").
  sourceMessageId String?  @map("source_message_id")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  set AiEvalSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId, position])
  @@map("ai_eval_cases")
}

enum AiEvalRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// One execution of a set against a model (and, optionally, a draft prompt
/// or skill) — run before changing the model, the prompt or a skill.
model AiEvalRun {
  id             String          @id @default(cuid())
  workspaceId    String          @map("workspace_id")
  setId          String          @map("set_id")
  status         AiEvalRunStatus @default(QUEUED)
  /// Model evaluated ("<provider>:<model>"); null = the current default.
  modelKey       String?         @map("model_key")
  judgeModelKey  String?         @map("judge_model_key")
  /// Draft overrides tried before saving them (null = current settings).
  skillId        String?         @map("skill_id")
  promptOverride String?         @map("prompt_override") @db.Text
  /// Why it ran (`manual` | `model_change` | `prompt_change` | `skill_change`).
  reason         String          @default("manual")
  /// Steel Agent version under evaluation (STEEL_AGENT sets); no FK on purpose.
  agentVersionId String?         @map("agent_version_id")
  startedById    String?         @map("started_by_id")
  caseCount      Int             @default(0) @map("case_count")
  passedCount    Int             @default(0) @map("passed_count")
  failedCount    Int             @default(0) @map("failed_count")
  avgScore       Float?          @map("avg_score")
  costUsd        Decimal         @default(0) @map("cost_usd") @db.Decimal(14, 6)
  error          String?         @db.Text
  startedAt      DateTime?       @map("started_at")
  finishedAt     DateTime?       @map("finished_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  set       AiEvalSet      @relation(fields: [setId], references: [id], onDelete: Cascade)
  startedBy User?          @relation("AiEvalRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  results   AiEvalResult[]

  @@index([setId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("ai_eval_runs")
}

/// Grade of one case in one run. The question is snapshotted: editing or
/// deleting the case later does not rewrite past runs.
model AiEvalResult {
  id             String   @id @default(cuid())
  runId          String   @map("run_id")
  caseId         String?  @map("case_id")
  input          String   @db.Text
  output         String   @db.Text
  passed         Boolean
  checksPassed   Boolean  @map("checks_passed")
  failedChecks   String[] @map("failed_checks")
  judgeScore     Float?   @map("judge_score")
  judgePassed    Boolean? @map("judge_passed")
  judgeRationale String?  @map("judge_rationale") @db.Text
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(14, 6)
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  run AiEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("ai_eval_results")
}

// ─── Notificações no app ─────────────────────────────────────────────────────

