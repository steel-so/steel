/// ID de acesso remoto de um ativo da CMDB (preenchido à mão ou pelo inventário).
model SdRemoteEndpoint {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  configItemId String           @map("config_item_id")
  provider     SdRemoteProvider
  remoteId     String           @map("remote_id")
  /// MANUAL ou INVENTORY (veio do relatório do agente).
  source       String           @default("MANUAL")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configItem SdConfigItem @relation(fields: [configItemId], references: [id], onDelete: Cascade)

  @@unique([configItemId, provider])
  @@index([workspaceId])
  @@map("sd_remote_endpoints")
}

/// Cada vez que alguém clicou em "Conectar" (rastro além da auditoria).
model SdRemoteSession {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  configItemId String           @map("config_item_id")
  ticketId     String?          @map("ticket_id")
  userId       String           @map("user_id")
  provider     SdRemoteProvider
  remoteId     String           @map("remote_id")
  startedAt    DateTime         @default(now()) @map("started_at")

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  configItem SdConfigItem @relation(fields: [configItemId], references: [id], onDelete: Cascade)
  ticket     SdTicket?    @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user       User         @relation("SdRemoteSessionUser", fields: [userId], references: [id])

  @@index([workspaceId, startedAt])
  @@index([configItemId, startedAt])
  @@index([ticketId])
  @@map("sd_remote_sessions")
}

/// S7 — licença de software. `matchPattern` casa com o nome do software no
/// catálogo do inventário (S1), sem diferenciar maiúsculas.
model SdSoftwareLicense {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  name              String
  vendor            String?
  matchPattern      String    @map("match_pattern")
  seats             Int
  unitCostCents     Int?      @map("unit_cost_cents")
  purchasedAt       DateTime? @map("purchased_at")
  expiresAt         DateTime? @map("expires_at")
  /// Avisar tantos dias antes de vencer.
  renewalNoticeDays Int       @default(30) @map("renewal_notice_days")
  /// Último aviso enviado (evita repetir): "NOTICE" ou "EXPIRED".
  lastNoticeKind    String?   @map("last_notice_kind")
  lastNoticeAt      DateTime? @map("last_notice_at")
  notes             String?
  archivedAt        DateTime? @map("archived_at")
  createdById       String    @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("SdSoftwareLicenseCreatedBy", fields: [createdById], references: [id])
  assignments SdSoftwareLicenseAsset[]

  @@index([workspaceId, expiresAt])
  @@map("sd_software_licenses")
}

/// Ativo da CMDB coberto por uma licença (direito de uso concedido).
model SdSoftwareLicenseAsset {
  id           String   @id @default(cuid())
  licenseId    String   @map("license_id")
  configItemId String   @map("config_item_id")
  createdAt    DateTime @default(now()) @map("created_at")

  license    SdSoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  configItem SdConfigItem      @relation(fields: [configItemId], references: [id], onDelete: Cascade)

  @@unique([licenseId, configItemId])
  @@index([configItemId])
  @@map("sd_software_license_assets")
}

/// S5 — previsão de demanda e dimensionamento. Uma linha por workspace.
model SdWfmSettings {
  workspaceId            String   @id @map("workspace_id")
  /// Semanas de histórico usadas na previsão.
  historyWeeks           Int      @default(8) @map("history_weeks")
  /// Chamados que um atendente resolve por hora de trabalho.
  ticketsPerAgentHour    Float    @default(2.5) @map("tickets_per_agent_hour")
  /// Ocupação alvo (0-100): o resto é folga para picos, pausas e reuniões.
  targetOccupancyPercent Int      @default(75) @map("target_occupancy_percent")
  minAgentsPerShift      Int      @default(1) @map("min_agents_per_shift")
  /// [{name,startHour,endHour}] — horas locais do workspace (endHour exclusivo).
  shifts                 Json     @default("[{\"name\":\"Manhã\",\"startHour\":6,\"endHour\":14},{\"name\":\"Tarde\",\"startHour\":14,\"endHour\":22}]")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sd_wfm_settings")
}

// nov: crm-deals

enum CrmPaymentMethod {
  PIX
  BOLETO
}

enum CrmProposalChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

enum CrmContractStatus {
  ACTIVE
  RENEWED
  EXPIRED
  CANCELED
}

enum CrmDealRoomActionOwner {
  SELLER
  CUSTOMER
}

enum CrmDealRoomAuthorKind {
  SELLER
  CUSTOMER
}

enum CrmDealRoomEventKind {
  ROOM_OPENED
  PROPOSAL_VIEWED
  MATERIAL_OPENED
  ACTION_COMPLETED
  MESSAGE_SENT
}

/// Per-workspace switches of the deal tools (C6, C8, C9). The proposal
/// payment is OFF by default: only a mock PSP exists (PixProvider).
model CrmDealsSettings {
  id                       String   @id @default(cuid())
  workspaceId              String   @unique @map("workspace_id")
  /// Pix/boleto charges on a proposal (mock PSP only).
  proposalPaymentEnabled   Boolean  @default(false) @map("proposal_payment_enabled")
  /// The public proposal is accepted with a drawn signature instead of a name.
  proposalSignatureEnabled Boolean  @default(false) @map("proposal_signature_enabled")
  /// Days before a contract ends that the owner is warned and the renewal deal is created.
  renewalLeadDays          Int      @default(60) @map("renewal_lead_days")
  renewalAutoCreate        Boolean  @default(true) @map("renewal_auto_create")
  updatedById              String?  @map("updated_by_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("crm_deals_settings")
}

/// Drawn signature of the customer on a public proposal (C6). The PNG sits in
/// MinIO; both hashes prove what was signed (reuses the ServiceDesk scheme).
model CrmProposalSignature {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  proposalId     String   @map("proposal_id")
  signerName     String   @map("signer_name")
  signerDocument String?  @map("signer_document")
  signerEmail    String?  @map("signer_email")
  storageKey     String   @map("storage_key")
  imageSha256    String   @map("image_sha256")
  /// SHA-256 of the canonical snapshot of the proposal at signing time.
  proposalSha256 String   @map("proposal_sha256")
  ipHash         String   @map("ip_hash")
  signedAt       DateTime @map("signed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  proposal CrmProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([workspaceId])
  @@map("crm_proposal_signatures")
}

/// Pix or boleto charge of a proposal (C6). Settled by the PSP webhook (or the
/// "simulate payment" action with a test provider); a paid charge wins the deal.
model CrmProposalCharge {
  id               String                  @id @default(cuid())
  workspaceId      String                  @map("workspace_id")
  proposalId       String                  @map("proposal_id")
  opportunityId    String?                 @map("opportunity_id")
  createdById      String?                 @map("created_by_id")
  method           CrmPaymentMethod
  provider         String
  providerChargeId String                  @map("provider_charge_id")
  amount           Decimal                 @db.Decimal(14, 2)
  description      String                  @db.VarChar(140)
  /// Pix "copia e cola" or the boleto digitable line.
  paymentCode      String                  @map("payment_code")
  status           CrmProposalChargeStatus @default(PENDING)
  expiresAt        DateTime                @map("expires_at")
  paidAt           DateTime?               @map("paid_at")
  paidAmount       Decimal?                @map("paid_amount") @db.Decimal(14, 2)
  endToEndId       String?                 @map("end_to_end_id")
  payerName        String?                 @map("payer_name")
  canceledAt       DateTime?               @map("canceled_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  proposal    CrmProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([provider, providerChargeId])
  @@index([proposalId, createdAt])
  @@index([workspaceId, status])
  @@map("crm_proposal_charges")
}

/// Customer contract tracked for renewal (C9).
model CrmContract {
  id                   String            @id @default(cuid())
  workspaceId          String            @map("workspace_id")
  companyId            String            @map("company_id")
  /// Deal that sold the contract (optional).
  opportunityId        String?           @map("opportunity_id")
  /// Deal created for the renewal.
  renewalOpportunityId String?           @map("renewal_opportunity_id")
  ownerId              String?           @map("owner_id")
  createdById          String            @map("created_by_id")
  name                 String
  value                Decimal?          @db.Decimal(14, 2)
  startDate            DateTime          @map("start_date")
  endDate              DateTime          @map("end_date")
  autoRenews           Boolean           @default(false) @map("auto_renews")
  status               CrmContractStatus @default(ACTIVE)
  notes                String?
  /// When the owner was warned about the expiry.
  alertedAt            DateTime?         @map("alerted_at")
  renewalCreatedAt     DateTime?         @map("renewal_created_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company            CrmCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunity        CrmOpportunity? @relation("CrmContractOrigin", fields: [opportunityId], references: [id], onDelete: SetNull)
  renewalOpportunity CrmOpportunity? @relation("CrmContractRenewal", fields: [renewalOpportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, endDate])
  @@index([companyId])
  @@map("crm_contracts")
}

/// Shared negotiation room of a deal (C8): one public page per opportunity,
/// reached by an opaque token.
model CrmDealRoom {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  opportunityId  String   @unique @map("opportunity_id")
  token          String   @unique
  enabled        Boolean  @default(true)
  title          String?
  welcomeMessage String?  @map("welcome_message")
  /// Proposal shown in the room.
  proposalId     String?  @map("proposal_id")
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity CrmOpportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proposal    CrmProposal?           @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  materials   CrmDealRoomMaterial[]
  actions     CrmDealRoomAction[]
  visitors    CrmDealRoomVisitor[]
  events      CrmDealRoomEvent[]
  messages    CrmDealRoomMessage[]

  @@index([workspaceId])
  @@map("crm_deal_rooms")
}

model CrmDealRoomMaterial {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  title     String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  room CrmDealRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, position])
  @@map("crm_deal_room_materials")
}

/// Joint action plan item: owned by the seller or by the customer.
model CrmDealRoomAction {
  id          String                 @id @default(cuid())
  roomId      String                 @map("room_id")
  title       String
  owner       CrmDealRoomActionOwner
  dueDate     DateTime?              @map("due_date")
  doneAt      DateTime?              @map("done_at")
  doneByLabel String?                @map("done_by_label")
  position    Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at")

  room CrmDealRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, position])
  @@map("crm_deal_room_actions")
}

/// A person who identified themselves on the public room page.
model CrmDealRoomVisitor {
  id          String   @id @default(cuid())
  roomId      String   @map("room_id")
  name        String
  email       String
  ipHash      String?  @map("ip_hash")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  room     CrmDealRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  events   CrmDealRoomEvent[]
  messages CrmDealRoomMessage[]

  @@unique([roomId, email])
  @@map("crm_deal_room_visitors")
}

/// Who opened what in the room.
model CrmDealRoomEvent {
  id          String               @id @default(cuid())
  roomId      String               @map("room_id")
  visitorId   String?              @map("visitor_id")
  kind        CrmDealRoomEventKind
  targetId    String?              @map("target_id")
  targetLabel String?              @map("target_label")
  createdAt   DateTime             @default(now()) @map("created_at")

  room    CrmDealRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  visitor CrmDealRoomVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@map("crm_deal_room_events")
}

model CrmDealRoomMessage {
  id           String                @id @default(cuid())
  roomId       String                @map("room_id")
  authorKind   CrmDealRoomAuthorKind @map("author_kind")
  authorUserId String?               @map("author_user_id")
  authorName   String                @map("author_name")
  visitorId    String?               @map("visitor_id")
  body         String                @db.Text
  createdAt    DateTime              @default(now()) @map("created_at")

  room    CrmDealRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  visitor CrmDealRoomVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@map("crm_deal_room_messages")
}

// nov: ai-actions
enum AiActionConnectorKind {
  /// Read-only lookup (an order, a customer): GET, no side effects.
  LOOKUP
  /// Write on the customer system (reset a password, grant access).
  ACTION
}

enum AiActionExecutionStatus {
  PENDING
  SUCCESS
  FAILURE
}

/// A customer system the AI may call through the generic HTTP action tool.
/// Registered by an OWNER/ADMIN: it is the workspace allow-list of what the
/// AI can reach. Headers (tokens) are encrypted with CONNECTION_SECRETS.
model AiActionConnector {
  id               String                @id @default(cuid())
  workspaceId      String                @map("workspace_id")
  /// snake_case handle the model uses (`consultar_pedido`).
  key              String
  name             String
  description      String                @db.Text
  kind             AiActionConnectorKind
  method           String
  /// https URL; `{param}` placeholders are allowed in the path and query.
  urlTemplate      String                @map("url_template")
  /// Encrypted JSON object of request headers (never returned).
  encryptedHeaders String?               @map("encrypted_headers") @db.Text
  /// [{ name, description, required }] — the arguments the model fills in.
  params           Json                  @default("[]")
  enabled          Boolean               @default(true)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("ai_action_connectors")
}

/// Per-workspace switches of the AI actions. No row = everything off.
model AiActionSettings {
  workspaceId String   @id @map("workspace_id")
  /// Master switch of connectors and of tools in the WhatsApp auto-reply.
  enabled     Boolean  @default(false)
  /// Allow-list of the WhatsApp auto-reply: [{ toolName, mode: AUTO|APPROVAL }].
  zapTools    Json     @default("[]") @map("zap_tools")
  /// User whose permissions the auto-reply tools run with (OWNER/ADMIN).
  zapActorId  String?  @map("zap_actor_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_action_settings")
}

/// Idempotency ledger of AI writes on customer systems: the same key within
/// the window replays the stored outcome instead of calling the system again.
model AiActionExecution {
  id             String                  @id @default(cuid())
  workspaceId    String                  @map("workspace_id")
  idempotencyKey String                  @map("idempotency_key")
  connectorKey   String                  @map("connector_key")
  status         AiActionExecutionStatus @default(PENDING)
  httpStatus     Int?                    @map("http_status")
  response       Json?
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([createdAt])
  @@map("ai_action_executions")
}

// nov: prospecting-agent

enum CrmProspectChannel {
  EMAIL
  WHATSAPP
}

enum CrmProspectDraftStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
}

/// T5: workspace switches of the prospecting agent. No row = everything off.
model CrmProspectingSettings {
  id                String               @id @default(cuid())
  workspaceId       String               @unique @map("workspace_id")
  enabled           Boolean              @default(false)
  /// Web searches + page fetches per month (UTC).
  monthlyWebLimit   Int                  @default(300) @map("monthly_web_limit")
  /// Drafts the agent may save per month (UTC).
  monthlyDraftLimit Int                  @default(100) @map("monthly_draft_limit")
  allowedChannels   CrmProspectChannel[] @map("allowed_channels")
  /// What the workspace sells, in the seller's words (context for the draft).
  valueProposition  String?              @map("value_proposition") @db.Text
  /// Extra phrases the signal detector looks for (besides the built-in ones).
  signalKeywords    String[]             @map("signal_keywords")
  updatedById       String?              @map("updated_by_id")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("crm_prospecting_settings")
}

/// T5: first-contact message written by the agent, waiting for a human. The
/// platform never sends it: a person approves (and sends) it.
model CrmProspectDraft {
  id          String                 @id @default(cuid())
  workspaceId String                 @map("workspace_id")
  /// The record the draft is about (ids are checked by the service; no FK so
  /// the draft survives the record being merged or deleted).
  leadId      String?                @map("lead_id")
  companyId   String?                @map("company_id")
  personId    String?                @map("person_id")
  targetName  String                 @map("target_name")
  channel     CrmProspectChannel
  subject     String?
  body        String                 @db.Text
  toEmail     String?                @map("to_email")
  toPhone     String?                @map("to_phone")
  /// Short research summary written by the agent.
  summary     String?                @db.Text
  /// `[{ type, label, evidence, sourceUrl? }]`
  signals     Json                   @default("[]")
  /// `[{ url, title? }]` pages the research read.
  sources     Json                   @default("[]")
  status      CrmProspectDraftStatus @default(PENDING)
  agentId     String?                @map("agent_id")
  createdById String                 @map("created_by_id")
  decidedById String?                @map("decided_by_id")
  decidedAt   DateTime?              @map("decided_at")
  rejectReason String?               @map("reject_reason") @db.Text
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, leadId])
  @@index([workspaceId, companyId])
  @@map("crm_prospect_drafts")
}

/// T5: monthly counters behind the quota (one row per workspace and month).
model CrmProspectUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// First day of the month, 00:00 UTC.
  period      DateTime
  searches    Int      @default(0)
  fetches     Int      @default(0)
  drafts      Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period])
  @@map("crm_prospect_usage")
}

// nov: site-widget
/// Site chat widget (E1): per-workspace switch (off by default), the public
/// key the pasted `<script>` carries, the origins allowed to use it and the
/// look and behaviour of the chat. Conversations land in the zap inbox
/// through a virtual connection (`provider = WIDGET`).
model WhatsAppWidgetSettings {
  id                String   @id @default(cuid())
  workspaceId       String   @unique @map("workspace_id")
  enabled           Boolean  @default(false)
  /// Public identifier in the snippet (`stw_...`); rotating it cuts old snippets.
  publicKey         String   @unique @map("public_key")
  /// Origins (`https://site.com.br`, `https://*.site.com.br`) allowed to open the chat.
  allowedOrigins    String[] @default([]) @map("allowed_origins")
  title             String   @default("Fale com a gente") @db.VarChar(60)
  welcomeMessage    String   @default("Olá! Como podemos ajudar?") @map("welcome_message") @db.VarChar(280)
  accentColor       String   @default("#2563eb") @map("accent_color") @db.VarChar(7)
  /// `RIGHT` or `LEFT` corner of the page.
  position          String   @default("RIGHT") @db.VarChar(5)
  preChatEnabled    Boolean  @default(false) @map("pre_chat_enabled")
  preChatAskEmail   Boolean  @default(true) @map("pre_chat_ask_email")
  preChatAskPhone   Boolean  @default(false) @map("pre_chat_ask_phone")
  /// Outside the Comunicação business hours the visitor gets `offlineMessage`.
  offlineEnabled    Boolean  @default(true) @map("offline_enabled")
  offlineMessage    String   @default("No momento estamos fora do horário de atendimento. Deixe sua mensagem que respondemos assim que possível.") @map("offline_message") @db.VarChar(280)
  /// Team that receives the new chats (null = the general queue).
  teamId            String?  @map("team_id")
  /// Virtual WIDGET connection, created on first enable.
  connectionId      String?  @map("connection_id")
  /// Shows the link to the ServiceDesk requester portal in the chat.
  showPortal        Boolean  @default(false) @map("show_portal")
  /// Asks the visitor the open NPS/CSAT/CES survey after the chat is closed.
  showSurvey        Boolean  @default(false) @map("show_survey")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_widget_settings")
}

/// A browser that opened the site chat. The raw token lives in the visitor's
/// first-party cookie; only its SHA-256 is stored.
model WhatsAppWidgetVisitor {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  contactId   String    @map("contact_id")
  tokenHash   String    @unique @map("token_hash")
  name        String?   @db.VarChar(120)
  email       String?   @db.VarChar(200)
  phone       String?   @db.VarChar(40)
  /// Origin of the site where the chat was first opened.
  origin      String?   @db.VarChar(200)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contactId])
  @@map("whatsapp_widget_visitors")
}

// nov: meta-channels (Z5 Instagram Direct and Messenger, Z6 Coexistence)

enum WhatsAppChannel {
  WHATSAPP
  INSTAGRAM
  MESSENGER
}

enum WhatsAppCoexistenceStatus {
  /// Connected; waiting for the customer to share the history.
  PENDING
  /// Meta is delivering history / contact chunks.
  SYNCING
  COMPLETED
  /// The customer declined to share the history in the app.
  DECLINED
  FAILED
}

/// Per-workspace switches of the Meta channels. Everything is OFF by default:
/// the Meta app review (permissions, Coexistence) belongs to the platform owner.
model WhatsAppMetaChannelSettings {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique @map("workspace_id")
  instagramEnabled    Boolean  @default(false) @map("instagram_enabled")
  messengerEnabled    Boolean  @default(false) @map("messenger_enabled")
  /// Public comments of Instagram posts / Page posts arrive in the inbox.
  commentsEnabled     Boolean  @default(false) @map("comments_enabled")
  coexistenceEnabled  Boolean  @default(false) @map("coexistence_enabled")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_meta_channel_settings")
}

/// Marks a message of a social conversation as a public comment on a post
/// (the message row carries the text; this row carries the post reference
/// needed to answer in public or by private reply).
model WhatsAppSocialComment {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  connectionId    String   @map("connection_id")
  messageId       String   @unique @map("message_id")
  commentId       String   @map("comment_id")
  postId          String?  @map("post_id")
  parentCommentId String?  @map("parent_comment_id")
  permalink       String?
  /// When an agent answered in public / by DM (null = not answered yet).
  repliedAt       DateTime? @map("replied_at")
  createdAt       DateTime @default(now()) @map("created_at")

  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, connectionId])
  @@index([commentId])
  @@map("whatsapp_social_comments")
}

/// Progress of the Coexistence history / contacts import of one connection.
model WhatsAppCoexistenceSync {
  id                   String                    @id @default(cuid())
  workspaceId          String                    @map("workspace_id")
  connectionId         String                    @unique @map("connection_id")
  status               WhatsAppCoexistenceStatus @default(PENDING)
  /// 0-100, as reported by Meta on the last history chunk.
  progress             Int                       @default(0)
  contactsImported     Int                       @default(0) @map("contacts_imported")
  messagesImported     Int                       @default(0) @map("messages_imported")
  conversationsTouched Int                       @default(0) @map("conversations_touched")
  error                String?
  startedAt            DateTime                  @default(now()) @map("started_at")
  finishedAt           DateTime?                 @map("finished_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("whatsapp_coexistence_syncs")
}

// nov: zap-ecom ──────────────────────────────────────────────────────────────
// Z8 catalog and cart, Z9 e-commerce triggers, Z10 native scheduling.

enum WhatsAppCatalogSource {
  CRM
  TRAY
  NUVEMSHOP
}

enum WhatsAppStoreProvider {
  TRAY
  NUVEMSHOP
  VTEX
}

enum WhatsAppEcomEventKind {
  CART_ABANDONED
  ORDER_CREATED
  ORDER_SHIPPED
  ORDER_DELIVERED
}

enum WhatsAppEcomTriggerKind {
  ABANDONED_CART
  ORDER_SHIPPED
  POST_PURCHASE
}

enum WhatsAppEcomEventStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum WhatsAppSchedAppointmentStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum WhatsAppSchedAppointmentSource {
  AGENT
  FLOW
  CONTACT
}

/// Commerce switches of a workspace (Z8 + Z9). Everything is off by default:
/// the catalog needs a Meta catalog linked to the WABA and the triggers need
/// approved templates, so nothing starts before an admin turns it on.
model WhatsAppCommerceSettings {
  id                      String                @id @default(cuid())
  workspaceId             String                @unique @map("workspace_id")
  /// Z8 product messages and order intake.
  catalogEnabled          Boolean               @default(false) @map("catalog_enabled")
  /// Catalog id at Meta Commerce Manager (linked to the WABA by the owner).
  metaCatalogId           String?               @map("meta_catalog_id")
  catalogSource           WhatsAppCatalogSource @default(CRM) @map("catalog_source")
  /// Store integration the TRAY / NUVEMSHOP source reads from.
  catalogIntegrationId    String?               @map("catalog_integration_id")
  /// Pulls products from the store adapter (off: only the CRM source runs).
  storeSyncEnabled        Boolean               @default(false) @map("store_sync_enabled")
  lastCatalogSyncAt       DateTime?             @map("last_catalog_sync_at")
  /// An order message creates a lead + opportunity.
  orderCreatesOpportunity Boolean               @default(true) @map("order_creates_opportunity")
  orderPipelineId         String?               @map("order_pipeline_id")
  /// Sends a Pix charge (mock provider only) when an order arrives.
  orderPixEnabled         Boolean               @default(false) @map("order_pix_enabled")
  /// Member that owns what the automation creates (leads, deals, notes).
  ownerUserId             String?               @map("owner_user_id")
  /// Z9 store triggers.
  triggersEnabled         Boolean               @default(false) @map("triggers_enabled")
  /// Minimum hours between two automatic messages to the same contact.
  throttleHours           Int                   @default(24) @map("throttle_hours")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_commerce_settings")
}

/// A product offered in the WhatsApp catalog (mirror of the CRM products or
/// of a store). `retailerId` is the id Meta's catalog knows it by.
model WhatsAppCatalogProduct {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  source      WhatsAppCatalogSource
  /// Id in the source (CRM product id or store product id).
  externalId  String                @map("external_id")
  retailerId  String                @map("retailer_id")
  name        String
  description String?
  price       Decimal               @db.Decimal(14, 2)
  currency    String                @default("BRL")
  imageUrl    String?               @map("image_url")
  url         String?
  available   Boolean               @default(true)
  syncedAt    DateTime              @default(now()) @map("synced_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, retailerId])
  @@index([workspaceId, available])
  @@map("whatsapp_catalog_products")
}

/// Cart the contact sent from the catalog (Meta `order` message).
model WhatsAppCatalogOrder {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  contactId         String   @map("contact_id")
  conversationId    String?  @map("conversation_id")
  providerMessageId String   @unique @map("provider_message_id")
  metaCatalogId     String?  @map("meta_catalog_id")
  note              String?
  /// `[{ retailerId, name, quantity, unitPrice }]`.
  items             Json
  total             Decimal  @db.Decimal(14, 2)
  currency          String   @default("BRL")
  leadId            String?  @map("lead_id")
  opportunityId     String?  @map("opportunity_id")
  pixChargeId       String?  @map("pix_charge_id")
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([conversationId])
  @@map("whatsapp_catalog_orders")
}

/// A connected store (Z9; Z8 reads the catalog from it). Secrets are
/// encrypted with `CONNECTION_SECRETS`; the webhook secret signs every call.
model WhatsAppStoreIntegration {
  id                     String                @id @default(cuid())
  workspaceId            String                @map("workspace_id")
  provider               WhatsAppStoreProvider
  name                   String
  /// WhatsApp connection the automatic messages leave through.
  connectionId           String                @map("connection_id")
  enabled                Boolean               @default(false)
  /// Public host of the store API (`https://loja.com.br`, VTEX account...).
  storeUrl               String?               @map("store_url")
  encryptedWebhookSecret String                @map("encrypted_webhook_secret")
  /// Store API credentials, only for the catalog adapters (optional).
  encryptedCredentials   String?               @map("encrypted_credentials")
  lastEventAt            DateTime?             @map("last_event_at")
  createdById            String?               @map("created_by_id")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    WhatsAppEcomEvent[]

  @@index([workspaceId])
  @@map("whatsapp_store_integrations")
}

/// One automatic template message per kind of store event (Z9).
model WhatsAppEcomTrigger {
  id           String                  @id @default(cuid())
  workspaceId  String                  @map("workspace_id")
  kind         WhatsAppEcomTriggerKind
  enabled      Boolean                 @default(false)
  /// Approved Meta template sent when the trigger fires.
  templateId   String?                 @map("template_id")
  /// Wait before sending: abandoned cart (minutes since the cart), post
  /// purchase (minutes after delivery). Shipped notices go out at once.
  delayMinutes Int                     @default(0) @map("delay_minutes")
  /// Body variables in order, tokens such as `{nome}` / `{pedido}`.
  variables    Json                    @default("[]")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind])
  @@map("whatsapp_ecom_triggers")
}

/// A store event waiting for (or already past) its automatic message. The
/// unique key makes the store's webhook retries harmless.
model WhatsAppEcomEvent {
  id                String                  @id @default(cuid())
  workspaceId       String                  @map("workspace_id")
  integrationId     String                  @map("integration_id")
  kind              WhatsAppEcomEventKind
  /// Cart / order id in the store.
  externalId        String                  @map("external_id")
  waId              String                  @map("wa_id")
  contactName       String?                 @map("contact_name")
  /// Normalized fields the template variables read.
  data              Json
  status            WhatsAppEcomEventStatus @default(PENDING)
  skipReason        String?                 @map("skip_reason")
  scheduledAt       DateTime                @map("scheduled_at")
  claimedAt         DateTime?               @map("claimed_at")
  processedAt       DateTime?               @map("processed_at")
  providerMessageId String?                 @map("provider_message_id")
  createdAt         DateTime                @default(now()) @map("created_at")

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration WhatsAppStoreIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, kind, externalId])
  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, waId])
  @@map("whatsapp_ecom_events")
}

/// Scheduling switches and defaults of a workspace (Z10), off by default.
model WhatsAppSchedulingSettings {
  id                     String   @id @default(cuid())
  workspaceId            String   @unique @map("workspace_id")
  enabled                Boolean  @default(false)
  /// Connection the confirmations and reminders leave through.
  connectionId           String?  @map("connection_id")
  /// IANA zone the agenda reads in.
  timezone               String   @default("America/Sao_Paulo")
  /// Grid the offered times step on.
  slotMinutes            Int      @default(30) @map("slot_minutes")
  minNoticeMinutes       Int      @default(60) @map("min_notice_minutes")
  maxDaysAhead           Int      @default(30) @map("max_days_ahead")
  /// Approved templates: `{{1}} name, {{2}} service, {{3}} date and time,
  /// {{4}} professional`. Outside the 24h window Meta only delivers these.
  confirmationTemplateId String?  @map("confirmation_template_id")
  reminderTemplateId     String?  @map("reminder_template_id")
  /// Minutes before the start a reminder is sent (each value sends once).
  reminderOffsets        Int[]    @default([1440]) @map("reminder_offsets")
  /// Z3 form that books by WhatsApp (fields `servico`, `data`, `periodo`).
  bookingFlowId          String?  @map("booking_flow_id")
  ownerUserId            String?  @map("owner_user_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_scheduling_settings")
}

/// Something that can be booked (haircut, consultation...).
model WhatsAppSchedService {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  name            String
  description     String?
  durationMinutes Int      @map("duration_minutes")
  /// Free minutes after each appointment.
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace     Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  professionals WhatsAppSchedProfessionalService[]
  appointments  WhatsAppSchedAppointment[]

  @@index([workspaceId])
  @@map("whatsapp_sched_services")
}

/// Person (or room) that attends, with weekly working windows.
model WhatsAppSchedProfessional {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  name         String
  /// Workspace member that sees the agenda as theirs (optional).
  userId       String?  @map("user_id")
  active       Boolean  @default(true)
  /// `{ "1": [{ "start": "09:00", "end": "12:00" }] }`, keys 0 = Sunday.
  workingHours Json     @default("{}") @map("working_hours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace    Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services     WhatsAppSchedProfessionalService[]
  appointments WhatsAppSchedAppointment[]

  @@index([workspaceId])
  @@map("whatsapp_sched_professionals")
}

model WhatsAppSchedProfessionalService {
  professionalId String @map("professional_id")
  serviceId      String @map("service_id")

  professional WhatsAppSchedProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      WhatsAppSchedService      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
  @@map("whatsapp_sched_professional_services")
}

/// A booking. The migration adds a partial unique index on
/// `(professional_id, starts_at)` for PENDING / CONFIRMED rows, so two
/// concurrent requests cannot take the same start.
model WhatsAppSchedAppointment {
  id                 String                         @id @default(cuid())
  workspaceId        String                         @map("workspace_id")
  serviceId          String                         @map("service_id")
  professionalId     String                         @map("professional_id")
  contactId          String                         @map("contact_id")
  conversationId     String?                        @map("conversation_id")
  startsAt           DateTime                       @map("starts_at")
  endsAt             DateTime                       @map("ends_at")
  status             WhatsAppSchedAppointmentStatus @default(PENDING)
  source             WhatsAppSchedAppointmentSource @default(AGENT)
  notes              String?
  createdById        String?                        @map("created_by_id")
  confirmationSentAt DateTime?                      @map("confirmation_sent_at")
  confirmedAt        DateTime?                      @map("confirmed_at")
  canceledAt         DateTime?                      @map("canceled_at")
  cancelReason       String?                        @map("cancel_reason")
  /// Reminder offsets (minutes) already sent.
  remindersSent      Int[]                          @default([]) @map("reminders_sent")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service      WhatsAppSchedService      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional WhatsAppSchedProfessional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  contact      WhatsAppContact           @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([professionalId, startsAt])
  @@index([contactId, status])
  @@index([status, startsAt])
  @@map("whatsapp_sched_appointments")
}

// nov: t2-qa-review ──────────────────────────────────────────────────────────

enum QaSubjectType {
  CONVERSATION
  TICKET
}

enum QaReviewStatus {
  PENDING
  COMPLETED
  SKIPPED
  FAILED
}

/// Who answered the customer: a person, the bot/AI, or both.
enum QaHandlerKind {
  HUMAN
  BOT
  MIXED
}

enum QaCriterionScope {
  BOTH
  CONVERSATION
  TICKET
}

/// Per-workspace switch and limits of the automatic QA. Off by default.
model QaReviewConfig {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique @map("workspace_id")
  enabled            Boolean  @default(false)
  reviewConversations Boolean @default(true) @map("review_conversations")
  reviewTickets      Boolean  @default(true) @map("review_tickets")
  /// Also scores attendances answered only by the bot / AI.
  includeBots        Boolean  @default(true) @map("include_bots")
  /// Attendances with fewer messages are not worth a review.
  minMessages        Int      @default(4) @map("min_messages")
  /// Scores below this value (0-100) are "low" and notify the managers.
  lowScoreThreshold  Int      @default(60) @map("low_score_threshold")
  alertLowScore      Boolean  @default(true) @map("alert_low_score")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("qa_review_configs")
}

/// One configurable scoring criterion (tone, resolution, compliance, empathy
/// are seeded). The weight is relative: the final score is the weighted mean.
model QaCriterion {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  key         String
  name        String
  /// What the reviewer must look for; goes into the AI prompt.
  description String
  weight      Int              @default(1)
  appliesTo   QaCriterionScope @default(BOTH) @map("applies_to")
  active      Boolean          @default(true)
  position    Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, active, position])
  @@map("qa_criteria")
}

/// The score of one conversation or ticket. Names are snapshots so the panel
/// survives renames. No FK to the subject (it may be purged).
model QaReview {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  subjectType    QaSubjectType  @map("subject_type")
  conversationId String?        @unique @map("conversation_id")
  ticketId       String?        @unique @map("ticket_id")
  subjectLabel   String?        @map("subject_label")
  status         QaReviewStatus @default(PENDING)
  handlerKind    QaHandlerKind? @map("handler_kind")
  agentUserId    String?        @map("agent_user_id")
  agentName      String?        @map("agent_name")
  customerName   String?        @map("customer_name")
  /// 0-100, weighted mean of the criteria.
  score          Int?
  summary        String?
  /// [{ key, name, weight, score, evidence }]
  criteriaResults Json          @default("[]") @map("criteria_results")
  /// Short pt-BR coaching suggestions for the agent.
  coachingTips   Json           @default("[]") @map("coaching_tips")
  lowScore       Boolean        @default(false) @map("low_score")
  skipReason     String?        @map("skip_reason")
  provider       String?
  model          String?
  inputTokens    Int            @default(0) @map("input_tokens")
  outputTokens   Int            @default(0) @map("output_tokens")
  costUsd        Decimal        @default(0) @map("cost_usd") @db.Decimal(14, 6)
  /// When the attendance ended (the review window anchor of the panel).
  subjectEndedAt DateTime?      @map("subject_ended_at")
  reviewedAt     DateTime?      @map("reviewed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, reviewedAt])
  @@index([workspaceId, agentUserId, reviewedAt])
  @@index([workspaceId, lowScore, reviewedAt])
  @@map("qa_reviews")
}

// nov: a5-procedures ──────────────────────────────────────────────────────

enum AiProcedureStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AiProcedureRunSubject {
  WHATSAPP_CONVERSATION
  STEEL_AGENT_RUN
  TEST
}

enum AiProcedureRunStatus {
  RUNNING
  COMPLETED
  FAILED
  HANDED_OFF
  CANCELED
}

enum AiProcedureRunStepStatus {
  OK
  FAILED
  SKIPPED
  REJECTED
}

/// Natural-language runbook with conditions and mandatory steps. The engine
/// (not the model) enforces order and required steps. Columns mirror the
/// latest version.
model AiProcedure {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  name           String
  description    String?           @db.Text
  /// When the procedure applies, in natural language (shown to the model).
  whenToUse      String            @map("when_to_use") @db.Text
  status         AiProcedureStatus @default(DRAFT)
  /// `[ProcedureStep]` (see src/lib/ai/procedures/types.ts).
  steps          Json
  /// Failed attempts of a COLLECT step before the human takes over.
  maxAttempts    Int               @default(3) @map("max_attempts")
  /// Sent to the customer when the run falls back to a human.
  handoffMessage String?           @map("handoff_message") @db.Text
  whatsappEnabled Boolean          @default(true) @map("whatsapp_enabled")
  /// Steel Agents allowed to start it.
  agentIds       String[]          @default([]) @map("agent_ids")
  /// Whose permissions the TOOL steps run with.
  ownerId        String?           @map("owner_id")
  currentVersion Int               @default(1) @map("current_version")
  createdById    String?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  AiProcedureVersion[]
  runs      AiProcedureRun[]

  @@index([workspaceId, status])
  @@map("ai_procedures")
}

/// Immutable snapshot taken on every definition edit.
model AiProcedureVersion {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  procedureId    String   @map("procedure_id")
  number         Int
  whenToUse      String   @map("when_to_use") @db.Text
  steps          Json
  maxAttempts    Int      @map("max_attempts")
  handoffMessage String?  @map("handoff_message") @db.Text
  changeNote     String?  @map("change_note") @db.Text
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  procedure AiProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, number])
  @@map("ai_procedure_versions")
}

/// One execution of a procedure; `state` is the engine state kept per
/// conversation (or agent run).
model AiProcedureRun {
  id            String                @id @default(cuid())
  workspaceId   String                @map("workspace_id")
  procedureId   String                @map("procedure_id")
  versionNumber Int                   @map("version_number")
  subjectType   AiProcedureRunSubject @map("subject_type")
  subjectId     String                @map("subject_id")
  status        AiProcedureRunStatus  @default(RUNNING)
  state         Json
  failureReason String?               @map("failure_reason") @db.Text
  startedAt     DateTime              @default(now()) @map("started_at")
  finishedAt    DateTime?             @map("finished_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  procedure AiProcedure          @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  steps     AiProcedureRunStep[]

  @@index([subjectType, subjectId, status])
  @@index([procedureId, startedAt])
  @@index([workspaceId, startedAt])
  @@map("ai_procedure_runs")
}

model AiProcedureRunStep {
  id        String                   @id @default(cuid())
  runId     String                   @map("run_id")
  position  Int
  stepKey   String                   @map("step_key")
  kind      String
  title     String
  status    AiProcedureRunStepStatus
  input     Json?
  output    Json?
  error     String?                  @db.Text
  createdAt DateTime                 @default(now()) @map("created_at")

  run AiProcedureRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@map("ai_procedure_run_steps")
}
