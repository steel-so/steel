  RESOLUTION_BREACHED
  NO_UPDATE
}

enum SdAutomationEvent {
  TICKET_CREATED
  TICKET_UPDATED
  PHASE_CHANGED
  MESSAGE_RECEIVED
  APPROVAL_RESPONDED
  SLA_AT_RISK
  SLA_BREACHED
}

enum SdKbArticleStatus {
  DRAFT
  /// Em revisão (KCS): escrito, aguardando um revisor aprovar.
  IN_REVIEW
  PUBLISHED
}

enum SdKbVisibility {
  INTERNAL
  PORTAL
}

enum SdViewMode {
  KANBAN
  LIST
  TABLE
}

/// Configuração geral do módulo por workspace (1:1).
model SdSettings {
  id                          String         @id @default(cuid())
  workspaceId                 String         @unique @map("workspace_id")
  /// Próximo número sequencial de chamado (incremento atômico no create).
  nextTicketNumber            Int            @default(1) @map("next_ticket_number")
  /// Prefixo de exibição por tipo: {"INCIDENT":"INC","SERVICE_REQUEST":"REQ",...}
  ticketPrefixes              Json           @map("ticket_prefixes")
  defaultDepartmentId         String?        @map("default_department_id")
  defaultSlaPolicyId          String?        @map("default_sla_policy_id")
  /// Conexão do WhatsApp usada pelo ServiceDesk (WhatsAppConnection.module = SERVICE_DESK).
  whatsappConnectionId        String?        @map("whatsapp_connection_id")
  /// Chamado aberto pelo WhatsApp: responde ao contato com o código. O
  /// equivalente do e-mail é por caixa (`SdMailbox.sendAcknowledgement`).
  whatsappSendAcknowledgement Boolean        @default(true) @map("whatsapp_send_acknowledgement")
  portalEnabled               Boolean        @default(true) @map("portal_enabled")
  /// Tipos que o solicitante pode abrir pelo portal.
  portalTicketTypes           SdTicketType[] @default([INCIDENT, SERVICE_REQUEST]) @map("portal_ticket_types")
  /// Portal externo (link mágico): o contato vê os chamados das empresas
  /// dele (`SdContactCustomer`), não só aqueles em que é o contato.
  portalCompanyScope          Boolean        @default(true) @map("portal_company_scope")
  requireSignatureOnClose     Boolean        @default(false) @map("require_signature_on_close")
  requireSolutionOnResolve    Boolean        @default(true) @map("require_solution_on_resolve")
  /// Fecha automaticamente chamados RESOLVED após N horas (0 = desligado).
  autoCloseResolvedAfterHours Int            @default(72) @map("auto_close_resolved_after_hours")
  /// % do prazo consumido a partir do qual o SLA vira "em risco".
  slaAtRiskPercent            Int            @default(80) @map("sla_at_risk_percent")
  /// Reabertura: nova mensagem do solicitante em chamado RESOLVED reabre.
  reopenOnRequesterReply      Boolean        @default(true) @map("reopen_on_requester_reply")
  /// KCS: validade padrão (em dias) da revisão de um artigo da base. O
  /// artigo pode ter a própria (`SdKbArticle.reviewIntervalDays`).
  kbReviewIntervalDays        Int            @default(180) @map("kb_review_interval_days")
  /// Atribuição automática dentro do departamento (round-robin).
  autoAssignRoundRobin        Boolean        @default(false) @map("auto_assign_round_robin")
  // Agente de IA
  aiEnabled                   Boolean        @default(false) @map("ai_enabled")
  /// Pré-atendimento: IA conversa com o solicitante (portal/WhatsApp) antes
  /// de abrir o chamado, sugere artigos e faz a triagem.
  aiPreServiceEnabled         Boolean        @default(false) @map("ai_pre_service_enabled")
  /// Triagem automática (categoria/prioridade/departamento) na abertura.
  aiAutoTriageEnabled         Boolean        @default(false) @map("ai_auto_triage_enabled")
  /// Resposta automática no WhatsApp enquanto não há atendente.
  aiWhatsappAutoReply         Boolean        @default(false) @map("ai_whatsapp_auto_reply")
  aiPersona                   String?        @map("ai_persona")
  aiInstructions              String?        @map("ai_instructions")
  aiHandoffKeywords           String[]       @default([]) @map("ai_handoff_keywords")
  updatedById                 String?        @map("updated_by_id")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sd_settings")
}

/// Departamento (time que atende). `parentId` = sub-departamento (um nível).
model SdDepartment {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  parentId    String?   @map("parent_id")
  name        String
  description String?
  email       String?
  color       String?
  /// Calendário de expediente do time (OLA/SLA quando o chamado está aqui).
  calendarId  String?   @map("calendar_id")
  active      Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent          SdDepartment?        @relation("SdDepartmentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        SdDepartment[]       @relation("SdDepartmentTree")
  calendar        SdBusinessCalendar?  @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  members         SdDepartmentMember[]
  tickets         SdTicket[]
  categories      SdCategory[]
  configItems     SdConfigItem[]
  onCallSchedules SdOnCallSchedule[]

  @@index([workspaceId])
  @@index([parentId])
  @@map("sd_departments")
}

/// Vínculo usuário ↔ departamento. Quem tem ao menos um vínculo é "agente";
/// sem vínculo, o membro usa o ServiceDesk como solicitante (portal).
model SdDepartmentMember {
  id             String    @id @default(cuid())
  departmentId   String    @map("department_id")
  userId         String    @map("user_id")
  /// Líder/supervisor do time (alvo do escalonamento hierárquico).
  isLead         Boolean   @default(false) @map("is_lead")
  /// Último recebimento no round-robin.
  lastAssignedAt DateTime? @map("last_assigned_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  department SdDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User         @relation("SdDepartmentMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("sd_department_members")
}

/// Cliente ou Empresa (mesmo cadastro; `kind` separa as duas listas).
model SdCustomer {
  id           String         @id @default(cuid())
  workspaceId  String         @map("workspace_id")
  kind         SdCustomerKind @default(CLIENT)
  personType   SdPersonType   @default(LEGAL) @map("person_type")
  name         String
  tradeName    String?        @map("trade_name")
  /// CPF/CNPJ só dígitos.
  document     String?
  email        String?
  phone        String?
  whatsapp     String?
  zipCode      String?        @map("zip_code")
  street       String?
  number       String?
  complement   String?
  district     String?
  city         String?
  state        String?
  country      String         @default("BR")
  ibgeCode     String?        @map("ibge_code")
  notes        String?
  customFields Json           @default("{}") @map("custom_fields")
  active       Boolean        @default(true)
  createdById  String         @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                @relation("SdCustomerCreatedBy", fields: [createdById], references: [id])
  contacts         SdContactCustomer[]
  ticketsAsClient  SdTicket[]          @relation("SdTicketCustomer")
  ticketsAsCompany SdTicket[]          @relation("SdTicketCompany")
  configItems      SdConfigItem[]
  contracts        SdContract[]
  recurringTickets SdRecurringTicket[]

  @@index([workspaceId, kind])
  @@index([workspaceId, document])
  @@index([deletedAt])
  @@map("sd_customers")
}

/// Contato (pessoa) de um ou mais clientes/empresas.
model SdContact {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  name         String
  jobTitle     String?   @map("job_title")
  email        String?
  phone        String?
  whatsapp     String?
  /// Usuário da plataforma que é este contato (chat interno / portal).
  userId       String?   @map("user_id")
  notes        String?
  customFields Json      @default("{}") @map("custom_fields")
  active       Boolean   @default(true)
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?               @relation("SdContactUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy      User                @relation("SdContactCreatedBy", fields: [createdById], references: [id])
  customers      SdContactCustomer[]
  portalAccesses SdPortalAccess[]
  tickets        SdTicket[]
  messages       SdTicketMessage[]

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, whatsapp])
  @@index([userId])
  @@index([deletedAt])
  @@map("sd_contacts")
}

model SdContactCustomer {
  contactId  String  @map("contact_id")
  customerId String  @map("customer_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  contact  SdContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customer SdCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([contactId, customerId])
  @@index([customerId])
  @@map("sd_contact_customers")
}

/// Tipo de item de configuração (CMDB) — customizável (Servidor, Notebook,
/// Link, Licença…), com ícone e os atributos esperados.
model SdConfigItemType {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  name            String
  icon            String?
  color           String?
  /// Esquema dos atributos específicos: [{key,label,type,options?}]
  attributeSchema Json     @default("[]") @map("attribute_schema")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     SdConfigItem[]

  @@unique([workspaceId, name])
  @@map("sd_config_item_types")
}

/// Item de configuração (CI) — Service Configuration Management / CMDB.
model SdConfigItem {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  typeId        String?            @map("type_id")
  parentId      String?            @map("parent_id")
  name          String
  /// Etiqueta patrimonial / código.
  code          String?
  status        SdConfigItemStatus @default(ACTIVE)
  criticality   SdRiskLevel        @default(MEDIUM)
  customerId    String?            @map("customer_id")
  departmentId  String?            @map("department_id")
  ownerId       String?            @map("owner_id")
  serialNumber  String?            @map("serial_number")
  manufacturer  String?
  model         String?
  location      String?
  ipAddress     String?            @map("ip_address")
  purchasedAt   DateTime?          @map("purchased_at")
  warrantyUntil DateTime?          @map("warranty_until")
  attributes    Json               @default("{}")
  customFields  Json               @default("{}") @map("custom_fields")
  notes         String?
  createdById   String             @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type             SdConfigItemType?   @relation(fields: [typeId], references: [id], onDelete: SetNull)
  parent           SdConfigItem?       @relation("SdConfigItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         SdConfigItem[]      @relation("SdConfigItemTree")
  customer         SdCustomer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  department       SdDepartment?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner            User?               @relation("SdConfigItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy        User                @relation("SdConfigItemCreatedBy", fields: [createdById], references: [id])
  tickets          SdTicket[]
  monitorAlerts    SdMonitorAlert[]
  recurringTickets SdRecurringTicket[]

  @@index([workspaceId])
  @@index([customerId])
  @@index([typeId])
  @@index([deletedAt])
  @@map("sd_config_items")
}

/// Catálogo de serviços: categoria > subcategoria > serviço (árvore de 3
/// níveis; `level` é validado no service contra o nível do pai).
model SdCategory {
  id            String          @id @default(cuid())
  workspaceId   String          @map("workspace_id")
  parentId      String?         @map("parent_id")
  level         SdCategoryLevel
  name          String
  description   String?
  icon          String?
  /// Tipos em que a categoria aparece (vazio = todos).
  ticketTypes   SdTicketType[]  @default([]) @map("ticket_types")
  /// Time padrão (roteamento) e SLA padrão do nó.
  departmentId  String?         @map("department_id")
  slaPolicyId   String?         @map("sla_policy_id")
  /// Visível no portal do solicitante.
  portalVisible Boolean         @default(true) @map("portal_visible")
  active        Boolean         @default(true)
  position      Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent               SdCategory?   @relation("SdCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children             SdCategory[]  @relation("SdCategoryTree")
  department           SdDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  slaPolicy            SdSlaPolicy?  @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  ticketsAsCategory    SdTicket[]    @relation("SdTicketCategory")
  ticketsAsSubcategory SdTicket[]    @relation("SdTicketSubcategory")
  ticketsAsService     SdTicket[]    @relation("SdTicketService")
  kbArticles           SdKbArticle[]

  @@index([workspaceId, level])
  @@index([parentId])
  @@map("sd_categories")
}

/// Classificação do chamado (TICKET) ou da solução (SOLUTION).
model SdClassification {
  id          String               @id @default(cuid())
  workspaceId String               @map("workspace_id")
  kind        SdClassificationKind
  name        String
  description String?
  color       String?
  ticketTypes SdTicketType[]       @default([]) @map("ticket_types")
  active      Boolean              @default(true)
  position    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketsAsTicket   SdTicket[] @relation("SdTicketClassification")
  ticketsAsSolution SdTicket[] @relation("SdTicketSolutionClassification")

  @@index([workspaceId, kind])
  @@map("sd_classifications")
}

/// Impacto (ITIL) — customizável. `level` maior = mais impacto.
model SdImpact {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  level       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matrix    SdPriorityMatrix[]
  tickets   SdTicket[]

  @@unique([workspaceId, level])
  @@map("sd_impacts")
}

/// Urgência (ITIL) — customizável. `level` maior = mais urgente.
model SdUrgency {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  level       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matrix    SdPriorityMatrix[]
  tickets   SdTicket[]

  @@unique([workspaceId, level])
  @@map("sd_urgencies")
}

/// Prioridade — customizável (nome, cor, peso). Derivada da matriz
/// impacto × urgência ou escolhida manualmente.
model SdPriority {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String?
  /// Peso: maior = mais prioritário (ordenação, filas, KPIs).
  level       Int
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  matrix        SdPriorityMatrix[]
  slaTargets    SdSlaTarget[]
  tickets       SdTicket[]
  contractRates SdContractRate[]

  @@unique([workspaceId, level])
  @@map("sd_priorities")
}

model SdPriorityMatrix {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  impactId    String @map("impact_id")
  urgencyId   String @map("urgency_id")
  priorityId  String @map("priority_id")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  impact    SdImpact   @relation(fields: [impactId], references: [id], onDelete: Cascade)
  urgency   SdUrgency  @relation(fields: [urgencyId], references: [id], onDelete: Cascade)
  priority  SdPriority @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@unique([impactId, urgencyId])
  @@index([workspaceId])
  @@map("sd_priority_matrix")
}

/// Severidade — customizável (gravidade técnica, independente da prioridade).
model SdSeverity {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  color       String?
  level       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets   SdTicket[]

  @@unique([workspaceId, level])
  @@map("sd_severities")
}

/// Fase do fluxo de um tipo de chamado (kanban). Nome, cor, ordem e % de
/// conclusão (0–100) livres; `category` dá a semântica ao motor.
model SdPhase {
  id                String          @id @default(cuid())
  workspaceId       String          @map("workspace_id")
  ticketType        SdTicketType    @map("ticket_type")
  name              String
  description       String?
  color             String?
  category          SdPhaseCategory
  completionPercent Int             @default(0) @map("completion_percent")
  position          Int             @default(0)
  /// Fase inicial de chamados novos deste tipo (uma por tipo).
  isInitial         Boolean         @default(false) @map("is_initial")
  /// Pausa o relógio do SLA enquanto o chamado está aqui (ex.: aguardando cliente).
  pausesSla         Boolean         @default(false) @map("pauses_sla")
  /// Entrar nesta fase exige aprovação vigente (APPROVED).
  requiresApproval  Boolean         @default(false) @map("requires_approval")
  /// Campos que precisam estar preenchidos para entrar: ["solution","assigneeId",...]
  requiredFields    String[]        @default([]) @map("required_fields")
  /// Limite WIP do kanban (0 = sem limite).
  wipLimit          Int             @default(0) @map("wip_limit")
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets         SdTicket[]
  transitionsFrom SdPhaseTransition[] @relation("SdPhaseTransitionFrom")
  transitionsTo   SdPhaseTransition[] @relation("SdPhaseTransitionTo")

  @@index([workspaceId, ticketType, position])
  @@map("sd_phases")
}

/// Transição permitida entre fases. Sem nenhuma transição cadastrada para o
/// tipo, o fluxo é livre (qualquer fase → qualquer fase).
model SdPhaseTransition {
  id                   String   @id @default(cuid())
  workspaceId          String   @map("workspace_id")
  fromPhaseId          String   @map("from_phase_id")
  toPhaseId            String   @map("to_phase_id")
  /// Restringe a transição a membros destes departamentos (vazio = qualquer agente).
  allowedDepartmentIds String[] @default([]) @map("allowed_department_ids")
  createdAt            DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromPhase SdPhase   @relation("SdPhaseTransitionFrom", fields: [fromPhaseId], references: [id], onDelete: Cascade)
  toPhase   SdPhase   @relation("SdPhaseTransitionTo", fields: [toPhaseId], references: [id], onDelete: Cascade)

  @@unique([fromPhaseId, toPhaseId])
  @@index([workspaceId])
  @@map("sd_phase_transitions")
}

/// Calendário de expediente + feriados (base do relógio de SLA).
model SdBusinessCalendar {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  timezone    String   @default("America/Sao_Paulo")
  /// {"mon":[["08:00","18:00"]],"tue":[...],...,"sun":[]}
  schedule    Json
  /// [{"date":"2026-12-25","name":"Natal"}]
  holidays    Json     @default("[]")
  is24x7      Boolean  @default(false) @map("is_24x7")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slaPolicies     SdSlaPolicy[]
  departments     SdDepartment[]
  onCallSchedules SdOnCallSchedule[]

  @@map("sd_business_calendars")
}

/// Política de SLA/OLA. Aplicada à primeira política ativa (por `position`)
/// cujas `conditions` casam com o chamado; senão a padrão.
model SdSlaPolicy {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  kind        SdSlaKind @default(SLA)
  name        String
  description String?
  calendarId  String?   @map("calendar_id")
  /// [{"field":"type|priorityId|categoryId|customerId|departmentId|channel","operator":"in|not_in|equals","value":...}]
  conditions  Json      @default("[]")
  isDefault   Boolean   @default(false) @map("is_default")
  active      Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calendar   SdBusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  targets    SdSlaTarget[]
  categories SdCategory[]
  tickets    SdTicket[]
  contracts  SdContract[]

  @@index([workspaceId, position])
  @@map("sd_sla_policies")
}

/// Metas de uma política por prioridade (minutos úteis).
model SdSlaTarget {
  id                   String @id @default(cuid())
  policyId             String @map("policy_id")
  priorityId           String @map("priority_id")
  firstResponseMinutes Int    @map("first_response_minutes")
  resolutionMinutes    Int    @map("resolution_minutes")

  policy   SdSlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  priority SdPriority  @relation(fields: [priorityId], references: [id], onDelete: Cascade)

  @@unique([policyId, priorityId])
  @@map("sd_sla_targets")
}

/// Regra de escalonamento (disparada pelo tick de SLA do worker).
model SdEscalationRule {
  id               String              @id @default(cuid())
  workspaceId      String              @map("workspace_id")
  name             String
  trigger          SdEscalationTrigger
  /// NO_UPDATE: minutos sem atualização. AT_RISK usa SdSettings.slaAtRiskPercent.
  thresholdMinutes Int?                @map("threshold_minutes")
  conditions       Json                @default("[]")
  /// {"notifyUserIds":[],"notifyDepartmentLeads":true,"reassignDepartmentId":null,"reassignUserId":null,"raisePriority":false,"kind":"FUNCTIONAL|HIERARCHICAL"}
  actions          Json
  active           Boolean             @default(true)
  position         Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, trigger])
  @@map("sd_escalation_rules")
}

/// Regra de automação: evento → condições → ações (atribuir, mudar campo,
/// notificar, enviar mensagem, criar tarefas…).
model SdAutomationRule {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  name           String
  description    String?
  event          SdAutomationEvent
  conditions     Json              @default("[]")
  /// [{"type":"set_field|assign_department|assign_user|round_robin|add_participant|notify|post_message|create_task|apply_template","params":{...}}]
  actions        Json              @default("[]")
  /// Para de avaliar as próximas regras do mesmo evento.
  stopProcessing Boolean           @default(false) @map("stop_processing")
  active         Boolean           @default(true)
  position       Int               @default(0)
  runCount       Int               @default(0) @map("run_count")
  lastRunAt      DateTime?         @map("last_run_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, event, position])
  @@map("sd_automation_rules")
}

/// Campo customizado (chamado, cliente, contato ou CI). Valor mora no JSON
/// `customFields` da entidade, na chave `key`.
model SdCustomFieldDefinition {
  id              String              @id @default(cuid())
  workspaceId     String              @map("workspace_id")
  entity          SdCustomFieldEntity
  key             String
  label           String
  description     String?
  type            SdCustomFieldType
  /// SELECT/MULTI_SELECT: [{"value":"x","label":"X","color":"#..."}]
  options         Json                @default("[]")
  /// TICKET: tipos em que aparece (vazio = todos). Também filtra por categoria.
  ticketTypes     SdTicketType[]      @default([]) @map("ticket_types")
  categoryIds     String[]            @default([]) @map("category_ids")
  required        Boolean             @default(false)
  visibleInPortal Boolean             @default(false) @map("visible_in_portal")
  defaultValue    Json?               @map("default_value")
  active          Boolean             @default(true)
  position        Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entity, key])
  @@map("sd_custom_field_definitions")
}

/// Modelo de chamado (ITIL: modelos de requisição / mudança padrão):
/// valores padrão + checklist de tarefas aplicados na abertura.
model SdTicketTemplate {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  ticketType    SdTicketType @map("ticket_type")
  name          String
  description   String?
  /// {"title","description","categoryId","subcategoryId","serviceId","priorityId","impactId","urgencyId","severityId","classificationId","departmentId","changeType","customFields":{}}
  defaults      Json         @default("{}")
  /// [{"title":"...","description":"..."}]
  tasks         Json         @default("[]")
  portalVisible Boolean      @default(false) @map("portal_visible")
  active        Boolean      @default(true)
  position      Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets          SdTicket[]
  recurringTickets SdRecurringTicket[]

  @@index([workspaceId, ticketType])
  @@map("sd_ticket_templates")
}

/// Resposta pronta para o histórico/WhatsApp do chamado.
model SdCannedResponse {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  title        String
  shortcut     String?
  body         String
  departmentId String?  @map("department_id")
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SdCannedResponseCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId])
  @@map("sd_canned_responses")
}

/// Catálogo de peças (estoque simples).
model SdPart {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  sku         String?
  description String?
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 2)
  stock       Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticketParts SdTicketPart[]

  @@index([workspaceId])
  @@map("sd_parts")
}

/// Chamado (incidente, requisição, mudança ou problema).
model SdTicket {
  id                       String          @id @default(cuid())
  workspaceId              String          @map("workspace_id")
  /// Sequencial por workspace; exibido como `<prefixo>-<número>`.
  number                   Int
  type                     SdTicketType
  title                    String
  /// HTML do editor rico (sanitizado no service).
  description              String?
  channel                  SdTicketChannel @default(AGENT)
  phaseId                  String          @map("phase_id")
  /// Snapshot da % da fase atual (histórico/relatórios sem join).
  completionPercent        Int             @default(0) @map("completion_percent")
  impactId                 String?         @map("impact_id")
  urgencyId                String?         @map("urgency_id")
  priorityId               String?         @map("priority_id")
  severityId               String?         @map("severity_id")
  categoryId               String?         @map("category_id")
  subcategoryId            String?         @map("subcategory_id")
  serviceId                String?         @map("service_id")
  classificationId         String?         @map("classification_id")
  solutionClassificationId String?         @map("solution_classification_id")
  solution                 String?
  customerId               String?         @map("customer_id")
  companyId                String?         @map("company_id")
  contactId                String?         @map("contact_id")
  configItemId             String?         @map("config_item_id")
  departmentId             String?         @map("department_id")
  assigneeId               String?         @map("assignee_id")
  /// Usuário da plataforma que abriu (portal) — solicitante.
  requesterId              String?         @map("requester_id")
  templateId               String?         @map("template_id")
  /// Item pai (itens filhos: incidentes de um problema, tarefas de uma mudança…).
  parentId                 String?         @map("parent_id")
  /// Conversa do WhatsApp vinculada (aba WhatsApp do chamado).
  whatsappConversationId   String?         @map("whatsapp_conversation_id")
  escalationLevel          Int             @default(0) @map("escalation_level")
  tags                     String[]        @default([])
  customFields             Json            @default("{}") @map("custom_fields")
  // SLA
  slaPolicyId              String?         @map("sla_policy_id")
  /// Contrato do cliente aplicado a este chamado (horas e valor).
  contractId               String?         @map("contract_id")
  firstResponseDueAt       DateTime?       @map("first_response_due_at")
  resolutionDueAt          DateTime?       @map("resolution_due_at")
  firstRespondedAt         DateTime?       @map("first_responded_at")
  slaPausedAt              DateTime?       @map("sla_paused_at")
  /// Minutos úteis acumulados em pausa (somados ao prazo ao retomar).
  slaPausedMinutes         Int             @default(0) @map("sla_paused_minutes")
  firstResponseBreached    Boolean         @default(false) @map("first_response_breached")
  resolutionBreached       Boolean         @default(false) @map("resolution_breached")
  slaAtRiskNotifiedAt      DateTime?       @map("sla_at_risk_notified_at")
  resolvedAt               DateTime?       @map("resolved_at")
  closedAt                 DateTime?       @map("closed_at")
  reopenCount              Int             @default(0) @map("reopen_count")
  // Mudança (Change Enablement)
  changeType               SdChangeType?   @map("change_type")
  changeRisk               SdRiskLevel?    @map("change_risk")
  plannedStartAt           DateTime?       @map("planned_start_at")
  plannedEndAt             DateTime?       @map("planned_end_at")
  implementationPlan       String?         @map("implementation_plan")
  rollbackPlan             String?         @map("rollback_plan")
  testPlan                 String?         @map("test_plan")
  // Problema
  rootCause                String?         @map("root_cause")
  workaround               String?
  knownError               Boolean         @default(false) @map("known_error")
  // IA (pré-atendimento/triagem)
  aiSummary                String?         @map("ai_summary")
  aiTriage                 Json?           @map("ai_triage")
  /// Satisfação (1–5) respondida pelo solicitante após resolver.
  csatScore                Int?            @map("csat_score")
  csatComment              String?         @map("csat_comment")
  lastActivityAt           DateTime        @default(now()) @map("last_activity_at")
  createdById              String?         @map("created_by_id")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  deletedAt                DateTime?       @map("deleted_at")

  workspace              Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phase                  SdPhase                 @relation(fields: [phaseId], references: [id])
  impact                 SdImpact?               @relation(fields: [impactId], references: [id], onDelete: SetNull)
  urgency                SdUrgency?              @relation(fields: [urgencyId], references: [id], onDelete: SetNull)
  priority               SdPriority?             @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  severity               SdSeverity?             @relation(fields: [severityId], references: [id], onDelete: SetNull)
  category               SdCategory?             @relation("SdTicketCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory            SdCategory?             @relation("SdTicketSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  service                SdCategory?             @relation("SdTicketService", fields: [serviceId], references: [id], onDelete: SetNull)
  classification         SdClassification?       @relation("SdTicketClassification", fields: [classificationId], references: [id], onDelete: SetNull)
  solutionClassification SdClassification?       @relation("SdTicketSolutionClassification", fields: [solutionClassificationId], references: [id], onDelete: SetNull)
  customer               SdCustomer?             @relation("SdTicketCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  company                SdCustomer?             @relation("SdTicketCompany", fields: [companyId], references: [id], onDelete: SetNull)
  contact                SdContact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  configItem             SdConfigItem?           @relation(fields: [configItemId], references: [id], onDelete: SetNull)
  department             SdDepartment?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee               User?                   @relation("SdTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requester              User?                   @relation("SdTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  createdBy              User?                   @relation("SdTicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  template               SdTicketTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parent                 SdTicket?               @relation("SdTicketTree", fields: [parentId], references: [id], onDelete: SetNull)
  children               SdTicket[]              @relation("SdTicketTree")
  whatsappConversation   WhatsAppConversation?   @relation(fields: [whatsappConversationId], references: [id], onDelete: SetNull)
  slaPolicy              SdSlaPolicy?            @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  contract               SdContract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  participants           SdTicketParticipant[]
  messages               SdTicketMessage[]
  attachments            SdTicketAttachment[]
  tasks                  SdTicketTask[]
  costs                  SdTicketCost[]
  parts                  SdTicketPart[]
  approvals              SdTicketApproval[]
  escalations            SdTicketEscalation[]
  events                 SdTicketEvent[]
  signatures             SdTicketSignature[]
  kbLinks                SdTicketKbLink[]
  mailMessages           SdMailMessage[]
  monitorAlerts          SdMonitorAlert[]
  followers              SdTicketFollower[]
  timeEntries            SdTimeEntry[]
  approvalRounds         SdApprovalRound[]
  recurringRuns          SdRecurringTicketRun[]
  riskPrediction         SdTicketRiskPrediction?
  integrationLinks       SdIntegrationLink[]
  kbArticlesOriginated   SdKbArticle[]           @relation("SdKbArticleSourceTicket")
  phoneCalls             WhatsAppPhoneCall[]

  @@unique([workspaceId, number])
  @@index([workspaceId, type, phaseId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, requesterId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, resolutionDueAt])
  @@index([workspaceId, createdAt])
  @@index([parentId])
  @@index([whatsappConversationId])
  @@index([deletedAt])
  @@map("sd_tickets")
}

model SdTicketParticipant {
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  addedById String?  @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SdTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User     @relation("SdTicketParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
  @@map("sd_ticket_participants")
}

/// Histórico/chat do chamado (texto com emoji + anexos). INTERNAL = nota
/// interna que o solicitante não vê.
model SdTicketMessage {
  id                String              @id @default(cuid())
  workspaceId       String              @map("workspace_id")
  ticketId          String              @map("ticket_id")
  authorKind        SdMessageAuthorKind @map("author_kind")
  authorUserId      String?             @map("author_user_id")
  authorContactId   String?             @map("author_contact_id")
  visibility        SdMessageVisibility @default(PUBLIC)
  channel           SdMessageChannel    @default(PLATFORM)
  body              String
  /// Mensagem do WhatsApp espelhada (quando channel = WHATSAPP).
  whatsappMessageId String?             @map("whatsapp_message_id")
  /// Agentes citados com `@` no texto (evento `ticket.mentioned`).
  mentionedUserIds  String[]            @default([]) @map("mentioned_user_ids")
  editedAt          DateTime?           @map("edited_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  deletedAt         DateTime?           @map("deleted_at")

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket        SdTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser    User?                @relation("SdTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorContact SdContact?           @relation(fields: [authorContactId], references: [id], onDelete: SetNull)
  attachments   SdTicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("sd_ticket_messages")
}

/// Arquivo no MinIO (bucket `servicedesk`), opcionalmente preso a uma mensagem.
model SdTicketAttachment {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  ticketId     String           @map("ticket_id")
  messageId    String?          @map("message_id")
  uploadedById String?          @map("uploaded_by_id")
  kind         SdAttachmentKind
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  size         Int
  storageKey   String           @map("storage_key")
  createdAt    DateTime         @default(now()) @map("created_at")
  deletedAt    DateTime?        @map("deleted_at")

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket     SdTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    SdTicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User?            @relation("SdTicketAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@map("sd_ticket_attachments")
}

model SdTicketTask {
  id                String       @id @default(cuid())
  workspaceId       String       @map("workspace_id")
  ticketId          String       @map("ticket_id")
  title             String
  description       String?
  status            SdTaskStatus @default(TODO)
  assigneeId        String?      @map("assignee_id")
  dueDate           DateTime?    @map("due_date")
  completedAt       DateTime?    @map("completed_at")
  position          Int          @default(0)
  createdById       String       @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  /// Aviso "vence em breve" já enviado (zerado quando o prazo muda).
  dueSoonNotifiedAt DateTime?    @map("due_soon_notified_at")
  /// Aviso "venceu" já enviado (zerado quando o prazo muda).
  overdueNotifiedAt DateTime?    @map("overdue_notified_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("SdTicketTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("SdTicketTaskCreatedBy", fields: [createdById], references: [id])

  @@index([ticketId, position])
  @@index([workspaceId, assigneeId])
  @@index([status, dueDate])
  @@map("sd_ticket_tasks")
}

model SdTicketCost {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  ticketId    String         @map("ticket_id")
  category    SdCostCategory @default(OTHER)
  description String
  quantity    Decimal        @default(1) @db.Decimal(12, 2)
  unitCost    Decimal        @map("unit_cost") @db.Decimal(14, 2)
  billable    Boolean        @default(false)
  incurredAt  DateTime       @default(now()) @map("incurred_at")
  /// Técnico a quem o custo se refere (mão de obra).
  userId      String?        @map("user_id")
  createdById String         @map("created_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User?     @relation("SdTicketCostUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User      @relation("SdTicketCostCreatedBy", fields: [createdById], references: [id])

  @@index([ticketId])
  @@map("sd_ticket_costs")
}

model SdTicketPart {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  ticketId     String       @map("ticket_id")
  partId       String?      @map("part_id")
  name         String
  sku          String?
  quantity     Int          @default(1)
  unitCost     Decimal      @default(0) @map("unit_cost") @db.Decimal(14, 2)
  serialNumber String?      @map("serial_number")
  status       SdPartStatus @default(REQUESTED)
  notes        String?
  createdById  String       @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  part      SdPart?   @relation(fields: [partId], references: [id], onDelete: SetNull)
  createdBy User      @relation("SdTicketPartCreatedBy", fields: [createdById], references: [id])

  @@index([ticketId])
  @@map("sd_ticket_parts")
}

/// Pedido de aprovação por e-mail (link público com token de uso único,
/// guardado como hash SHA-256).
model SdTicketApproval {
  id             String           @id @default(cuid())
  workspaceId    String           @map("workspace_id")
  ticketId       String           @map("ticket_id")
  approverName   String?          @map("approver_name")
  approverEmail  String           @map("approver_email")
  approverUserId String?          @map("approver_user_id")
  tokenHash      String           @unique @map("token_hash")
  status         SdApprovalStatus @default(PENDING)
  message        String?
  comment        String?
  requestedById  String           @map("requested_by_id")
  /// Rodada de aprovação (CAB) a que o pedido pertence, se houver.
  roundId        String?          @map("round_id")
  sentAt         DateTime?        @map("sent_at")
  respondedAt    DateTime?        @map("responded_at")
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket      SdTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approver    User?            @relation("SdTicketApprovalApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  requestedBy User             @relation("SdTicketApprovalRequestedBy", fields: [requestedById], references: [id])
  round       SdApprovalRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([workspaceId, status])
  @@map("sd_ticket_approvals")
}

model SdTicketEscalation {
  id               String           @id @default(cuid())
  workspaceId      String           @map("workspace_id")
  ticketId         String           @map("ticket_id")
  kind             SdEscalationKind
  fromLevel        Int              @map("from_level")
  toLevel          Int              @map("to_level")
  fromDepartmentId String?          @map("from_department_id")
  toDepartmentId   String?          @map("to_department_id")
  fromAssigneeId   String?          @map("from_assignee_id")
  toAssigneeId     String?          @map("to_assignee_id")
  reason           String
  /// Disparada por regra (SLA) e não por uma pessoa.
  automatic        Boolean          @default(false)
  ruleId           String?          @map("rule_id")
  createdById      String?          @map("created_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SdTicketEscalationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("sd_ticket_escalations")
}

/// Rastreabilidade: tudo que acontece no chamado (append-only).
model SdTicketEvent {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  ticketId    String              @map("ticket_id")
  actorKind   SdMessageAuthorKind @map("actor_kind")
  actorUserId String?             @map("actor_user_id")
  /// ex.: ticket.created, field.changed, phase.changed, message.posted,
  /// task.completed, approval.requested, sla.breached, escalated, signed…
  action      String
  field       String?
  fromValue   Json?               @map("from_value")
  toValue     Json?               @map("to_value")
  meta        Json?
  createdAt   DateTime            @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?     @relation("SdTicketEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@map("sd_ticket_events")
}

/// Assinatura digital (PNG no MinIO + SHA-256 do PNG e do snapshot do chamado).
model SdTicketSignature {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  ticketId       String   @map("ticket_id")
  purpose        String   @default("Aceite do atendimento")
  signerName     String   @map("signer_name")
  signerDocument String?  @map("signer_document")
  signerEmail    String?  @map("signer_email")
  signedById     String?  @map("signed_by_id")
  storageKey     String   @map("storage_key")
  imageSha256    String   @map("image_sha256")
  /// Hash do estado do chamado no momento da assinatura (integridade).
  ticketSha256   String   @map("ticket_sha256")
  signedAt       DateTime @default(now()) @map("signed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  signedBy  User?     @relation("SdTicketSignatureSignedBy", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("sd_ticket_signatures")
}

/// Visão salva da lista de chamados (filtros, colunas, ordenação, modo).
model SdSavedView {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  name        String
  ticketType  SdTicketType? @map("ticket_type")
  mode        SdViewMode    @default(KANBAN)
  filters     Json          @default("{}")
  sort        Json          @default("[]")
  columns     Json          @default("[]")
  /// Compartilhada com todo o workspace.
  shared      Boolean       @default(false)
  position    Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("SdSavedViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@map("sd_saved_views")
}

/// Base de conhecimento (port da Wiki do Nexo + publicação no portal,
/// vínculo com categoria e avaliação de utilidade).
model SdKbArticle {
  id                 String            @id @default(cuid())
  workspaceId        String            @map("workspace_id")
  parentId           String?           @map("parent_id")
  title              String
  icon               String?
  coverImage         String?           @map("cover_image")
  content            Json
  /// Texto plano extraído do conteúdo (busca e contexto da IA).
  plainText          String            @default("") @map("plain_text")
  status             SdKbArticleStatus @default(DRAFT)
  visibility         SdKbVisibility    @default(INTERNAL)
  categoryId         String?           @map("category_id")
  tags               String[]          @default([])
  position           Int               @default(0)
  viewCount          Int               @default(0) @map("view_count")
  helpfulCount       Int               @default(0) @map("helpful_count")
  notHelpfulCount    Int               @default(0) @map("not_helpful_count")
  /// KCS: quantas vezes o artigo foi usado para resolver um chamado.
  reuseCount         Int               @default(0) @map("reuse_count")
  /// Chamado que originou o artigo ("criar documento a partir deste chamado").
  sourceTicketId     String?           @map("source_ticket_id")
  /// Validade: de quanto em quanto tempo o artigo deve ser revisado e quando
  /// cai a próxima revisão (`null` = sem validade definida).
  reviewIntervalDays Int?              @map("review_interval_days")
  reviewDueAt        DateTime?         @map("review_due_at")
  lastReviewedAt     DateTime?         @map("last_reviewed_at")
  publishedAt        DateTime?         @map("published_at")
  createdById        String?           @map("created_by_id")
  updatedById        String?           @map("updated_by_id")
  archivedAt         DateTime?         @map("archived_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       SdKbArticle?     @relation("SdKbArticleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     SdKbArticle[]    @relation("SdKbArticleTree")
  category     SdCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("SdKbArticleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("SdKbArticleEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  sourceTicket SdTicket?        @relation("SdKbArticleSourceTicket", fields: [sourceTicketId], references: [id], onDelete: SetNull)
  comments     SdKbComment[]
  ticketLinks  SdTicketKbLink[]
  reviews      SdKbReview[]

  @@index([workspaceId, parentId])
  @@index([workspaceId, status, visibility])
  @@index([workspaceId, reviewDueAt])
  @@map("sd_kb_articles")
}

model SdKbComment {
  id           String    @id @default(cuid())
  articleId    String    @map("article_id")
  authorId     String?   @map("author_id")
  parentId     String?   @map("parent_id")
  markId       String    @map("mark_id")
  content      Json
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  article    SdKbArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author     User?         @relation("SdKbCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy User?         @relation("SdKbCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent     SdKbComment?  @relation("SdKbCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    SdKbComment[] @relation("SdKbCommentThread")

  @@index([articleId, markId])
  @@map("sd_kb_comments")
}

/// Artigo usado/sugerido num chamado (KCS: medir reuso do conhecimento).
model SdTicketKbLink {
  ticketId       String   @map("ticket_id")
  articleId      String   @map("article_id")
  linkedById     String?  @map("linked_by_id")
  /// O artigo resolveu este chamado — é o que conta no reuso (KCS).
  resolvedTicket Boolean  @default(false) @map("resolved_ticket")
  createdAt      DateTime @default(now()) @map("created_at")

  ticket  SdTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  article SdKbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([ticketId, articleId])
  @@index([articleId])
  @@map("sd_ticket_kb_links")
}

/// Conversa do agente de IA do ServiceDesk (copiloto do agente ou
/// pré-atendimento do solicitante).
model SdAiConversation {
  id                     String   @id @default(cuid())
  workspaceId            String   @map("workspace_id")
  userId                 String?  @map("user_id")
  /// COPILOT (agente, dentro de um chamado) | PRE_SERVICE (portal/WhatsApp).
  mode                   String
  ticketId               String?  @map("ticket_id")
  /// Resultado do pré-atendimento: resolved_by_kb | ticket_opened | abandoned
  outcome                String?
  messages               Json     @default("[]")
  /// Pré-atendimento pelo WhatsApp: conversa do WhatsApp (conexão do
  /// ServiceDesk) em que a IA está atendendo. Nulo no portal e no copiloto.
  whatsappConversationId String?  @map("whatsapp_conversation_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation("SdAiConversationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId])
  @@index([ticketId])
  @@index([whatsappConversationId])
  @@map("sd_ai_conversations")
}

// ============================================================================
// ServiceDesk — Leva 2 de features: canais de entrada (e-mail e
// monitoramento), portal do contato externo e preferências de notificação.
// Ver docs/servicedesk/README.md.
// ============================================================================

enum SdMailboxProtocol {
  IMAP
}

enum SdMailboxStatus {
  ACTIVE
  ERROR
  PAUSED
}

/// Caixa de e-mail que vira chamado. Credenciais cifradas com
/// `CONNECTION_SECRETS`, como as demais conexões do produto.
model SdMailbox {
  id                    String            @id @default(cuid())
  workspaceId           String            @map("workspace_id")
  name                  String
  /// Endereço que recebe (e de onde as respostas saem).
  address               String
  protocol              SdMailboxProtocol @default(IMAP)
  status                SdMailboxStatus   @default(ACTIVE)
  statusError           String?           @map("status_error")
  imapHost              String            @map("imap_host")
  imapPort              Int               @default(993) @map("imap_port")
  imapSecure            Boolean           @default(true) @map("imap_secure")
  imapUser              String            @map("imap_user")
  encryptedImapPassword String            @map("encrypted_imap_password")
  /// Pasta monitorada e para onde a mensagem vai depois de processada.
  folder                String            @default("INBOX")
  processedFolder       String?           @map("processed_folder")
  smtpHost              String?           @map("smtp_host")
  smtpPort              Int?              @map("smtp_port")
  smtpSecure            Boolean           @default(true) @map("smtp_secure")
  smtpUser              String?           @map("smtp_user")
  encryptedSmtpPassword String?           @map("encrypted_smtp_password")
  /// Padrões aplicados ao chamado aberto por esta caixa.
  defaultType           SdTicketType      @default(INCIDENT) @map("default_type")
  defaultDepartmentId   String?           @map("default_department_id")
  defaultCategoryId     String?           @map("default_category_id")
  defaultPriorityId     String?           @map("default_priority_id")
  /// Remetentes aceitos/bloqueados (vazio = qualquer um).
  allowedSenders        String[]          @default([]) @map("allowed_senders")
  blockedSenders        String[]          @default([]) @map("blocked_senders")
  /// Abre chamado para remetente sem contato cadastrado.
  createUnknownContacts Boolean           @default(true) @map("create_unknown_contacts")
  /// Responde automaticamente confirmando a abertura.
  sendAcknowledgement   Boolean           @default(true) @map("send_acknowledgement")
  lastSyncAt            DateTime?         @map("last_sync_at")
  lastSeenUid           Int?              @map("last_seen_uid")
  createdById           String            @map("created_by_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User            @relation("SdMailboxCreatedBy", fields: [createdById], references: [id])
  messages  SdMailMessage[]

  @@unique([workspaceId, address])
  @@index([workspaceId, status])
  @@map("sd_mailboxes")
}

enum SdMailDirection {
  INBOUND
  OUTBOUND
}

/// Mensagem de e-mail ligada a um chamado — guarda o cabeçalho de thread
/// (`Message-ID`/`In-Reply-To`) para a resposta do cliente cair no mesmo
/// chamado, e serve de trava contra processar duas vezes.
model SdMailMessage {
  id              String          @id @default(cuid())
  workspaceId     String          @map("workspace_id")
  mailboxId       String          @map("mailbox_id")
  ticketId        String?         @map("ticket_id")
  messageId       String          @map("message_id")
  inReplyTo       String?         @map("in_reply_to")
  /// `References` do cabeçalho, do mais antigo ao mais novo.
  references      String[]        @default([])
  direction       SdMailDirection
  fromAddress     String          @map("from_address")
  fromName        String?         @map("from_name")
  toAddresses     String[]        @default([]) @map("to_addresses")
  ccAddresses     String[]        @default([]) @map("cc_addresses")
  subject         String?
  /// Corpo já limpo (sem citação e assinatura), usado na mensagem do chamado.
  bodyText        String?         @map("body_text")
  /// Mensagem automática (férias, bounce): não abre nem reabre chamado.
  automatic       Boolean         @default(false)
  /// Mensagem do histórico gerada por este e-mail (marcador da aba Histórico).
  ticketMessageId String?         @map("ticket_message_id")
  processedAt     DateTime?       @map("processed_at")
  error           String?
  createdAt       DateTime        @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox   SdMailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  ticket    SdTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([mailboxId, messageId])
  @@index([ticketId])
  @@index([workspaceId, createdAt])
  @@map("sd_mail_messages")
}

enum SdMonitorKind {
  ZABBIX
  WEBHOOK
}

enum SdMonitorAlertStatus {
  OPEN
  RESOLVED
  IGNORED
}

/// Origem de monitoramento que abre chamado (Zabbix ou webhook genérico).
/// O token é guardado como hash; o valor só aparece na criação.
model SdMonitorSource {
  id                    String        @id @default(cuid())
  workspaceId           String        @map("workspace_id")
  name                  String
  kind                  SdMonitorKind @default(ZABBIX)
  tokenHash             String        @unique @map("token_hash")
  active                Boolean       @default(true)
  /// Padrões do chamado gerado.
  ticketType            SdTicketType  @default(INCIDENT) @map("ticket_type")
  departmentId          String?       @map("department_id")
  categoryId            String?       @map("category_id")
  customerId            String?       @map("customer_id")
  /// severidade da origem → prioridade do ServiceDesk:
  /// [{"from":"disaster","priorityId":"..."}]
  severityMap           Json          @default("[]") @map("severity_map")
  /// Fecha o chamado quando o alerta normaliza.
  autoResolve           Boolean       @default(true) @map("auto_resolve")
  /// Reabre o chamado anterior se o mesmo alerta voltar dentro de N minutos.
  flappingWindowMinutes Int           @default(30) @map("flapping_window_minutes")
  lastEventAt           DateTime?     @map("last_event_at")
  createdById           String        @map("created_by_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User             @relation("SdMonitorSourceCreatedBy", fields: [createdById], references: [id])
  alerts    SdMonitorAlert[]

  @@index([workspaceId])
  @@map("sd_monitor_sources")
}

/// Alerta recebido. `externalId` deduplica (o mesmo problema reenviado não
/// abre outro chamado) e liga o evento de normalização ao chamado certo.
model SdMonitorAlert {
  id           String               @id @default(cuid())
  workspaceId  String               @map("workspace_id")
  sourceId     String               @map("source_id")
  ticketId     String?              @map("ticket_id")
  externalId   String               @map("external_id")
  status       SdMonitorAlertStatus @default(OPEN)
  severity     String?
  host         String?
  configItemId String?              @map("config_item_id")
  subject      String
  body         String?
  payload      Json?
  startedAt    DateTime             @default(now()) @map("started_at")
  resolvedAt   DateTime?            @map("resolved_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source     SdMonitorSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ticket     SdTicket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  configItem SdConfigItem?   @relation(fields: [configItemId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([workspaceId, status])
  @@index([ticketId])
  @@map("sd_monitor_alerts")
}

/// Acesso do contato externo ao portal, por link mágico enviado no e-mail.
/// `tokenHash` = SHA-256 do token do link; a sessão criada depois tem vida
/// curta e cookie próprio (não é sessão do Better Auth).
model SdPortalAccess {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  contactId        String    @map("contact_id")
  tokenHash        String    @unique @map("token_hash")
  email            String
  /// Enviado por (agente) ou `null` quando o próprio contato pediu o link.
  requestedById    String?   @map("requested_by_id")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  /// Sessão aberta a partir do link (hash do cookie) e sua validade.
  sessionHash      String?   @unique @map("session_hash")
  sessionExpiresAt DateTime? @map("session_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     SdContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("SdPortalAccessRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, contactId])
  @@index([expiresAt])
  @@map("sd_portal_accesses")
}

enum SdNotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

/// Preferência de notificação por usuário × evento × canal. Sem linha, vale
/// o padrão do evento (`src/config/servicedesk-notifications.ts`).
model SdNotificationPreference {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  /// Chave do evento: ticket.assigned, ticket.message, sla.at_risk...
  event       String
  channel     SdNotificationChannel
  enabled     Boolean               @default(true)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("SdNotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, event, channel])
  @@index([workspaceId, userId])
  @@map("sd_notification_preferences")
}

/// Quem acompanha um chamado sem ser responsável nem participante — recebe
/// as notificações públicas dele ("seguir chamado").
model SdTicketFollower {
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SdTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User     @relation("SdTicketFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
  @@map("sd_ticket_followers")
}

// ============================================================================
// ServiceDesk — Leva 3 de features: contratos e horas, calendário de mudanças
// com CAB, plantão (on-call) e chamados recorrentes.
// Ver docs/servicedesk/README.md.
// ============================================================================

enum SdContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ENDED
}

enum SdContractBillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Contrato de atendimento de um cliente: franquia de horas, valor da hora e
/// as regras que decidem quanto custa cada apontamento.
model SdContract {
  id              String                 @id @default(cuid())
  workspaceId     String                 @map("workspace_id")
  customerId      String                 @map("customer_id")
  name            String
  code            String?
  status          SdContractStatus       @default(DRAFT)
  startsAt        DateTime               @map("starts_at")
  endsAt          DateTime?              @map("ends_at")
  billingCycle    SdContractBillingCycle @default(MONTHLY) @map("billing_cycle")
  /// Franquia do período em minutos (0 = tudo é cobrado à parte).
  includedMinutes Int                    @default(0) @map("included_minutes")
  /// Sobra da franquia acumula para o período seguinte.
  carryOver       Boolean                @default(false) @map("carry_over")
  /// Valor da hora dentro e fora da franquia.
  hourlyRate      Decimal                @default(0) @map("hourly_rate") @db.Decimal(14, 2)
  overtimeRate    Decimal?               @map("overtime_rate") @db.Decimal(14, 2)
  /// Arredondamento do apontamento, em minutos (ex.: 15) e mínimo por
  /// chamado (ex.: 30) — práticas comuns de contrato de suporte.
  roundingMinutes Int                    @default(1) @map("rounding_minutes")
  minimumMinutes  Int                    @default(0) @map("minimum_minutes")
  /// Tipos cobertos (vazio = todos) e SLA que o contrato promete.
  ticketTypes     SdTicketType[]         @default([]) @map("ticket_types")
  slaPolicyId     String?                @map("sla_policy_id")
  notes           String?
  createdById     String                 @map("created_by_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    SdCustomer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  slaPolicy   SdSlaPolicy?       @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("SdContractCreatedBy", fields: [createdById], references: [id])
  rates       SdContractRate[]
  periods     SdContractPeriod[]
  timeEntries SdTimeEntry[]
  tickets     SdTicket[]

  @@index([workspaceId, status])
  @@index([customerId])
  @@index([deletedAt])
  @@map("sd_contracts")
}

enum SdRateWindow {
  BUSINESS_HOURS
  AFTER_HOURS
  WEEKEND
  HOLIDAY
}

/// Valor da hora por combinação (tipo × prioridade × janela). A primeira
/// regra que casa vence; sem regra, vale o valor do contrato.
model SdContractRate {
  id         String        @id @default(cuid())
  contractId String        @map("contract_id")
  ticketType SdTicketType? @map("ticket_type")
  priorityId String?       @map("priority_id")
  window     SdRateWindow  @default(BUSINESS_HOURS)
  hourlyRate Decimal       @map("hourly_rate") @db.Decimal(14, 2)
  /// Multiplicador aplicado ao tempo (ex.: 1.5 em plantão).
  multiplier Decimal       @default(1) @db.Decimal(6, 2)
  position   Int           @default(0)
  createdAt  DateTime      @default(now()) @map("created_at")

  contract SdContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  priority SdPriority? @relation(fields: [priorityId], references: [id], onDelete: SetNull)

  @@index([contractId, position])
  @@map("sd_contract_rates")
}

enum SdContractPeriodStatus {
  OPEN
  CLOSED
}

/// Fechamento do período: quanto foi usado, quanto passou da franquia e o
/// valor apurado. Gerado pelo worker e fechado por um admin.
model SdContractPeriod {
  id                String                 @id @default(cuid())
  workspaceId       String                 @map("workspace_id")
  contractId        String                 @map("contract_id")
  periodStart       DateTime               @map("period_start")
  periodEnd         DateTime               @map("period_end")
  status            SdContractPeriodStatus @default(OPEN)
  /// Franquia do período (inclui saldo acumulado, quando `carryOver`).
  includedMinutes   Int                    @default(0) @map("included_minutes")
  usedMinutes       Int                    @default(0) @map("used_minutes")
  billableMinutes   Int                    @default(0) @map("billable_minutes")
  overageMinutes    Int                    @default(0) @map("overage_minutes")
  carriedMinutes    Int                    @default(0) @map("carried_minutes")
  amount            Decimal                @default(0) @db.Decimal(14, 2)
  closedAt          DateTime?              @map("closed_at")
  closedById        String?                @map("closed_by_id")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  /// Aviso de franquia em 80% já enviado neste período.
  franchiseWarnedAt DateTime?              @map("franchise_warned_at")
  /// Aviso de excedente já enviado neste período.
  overageWarnedAt   DateTime?              @map("overage_warned_at")

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contract    SdContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  closedBy    User?         @relation("SdContractPeriodClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  timeEntries SdTimeEntry[]

  @@unique([contractId, periodStart])
  @@index([workspaceId, status])
  @@map("sd_contract_periods")
}

enum SdTimeEntrySource {
  TIMER
  MANUAL
}

/// Apontamento de tempo no chamado. Cronômetro aberto = `endedAt` nulo;
/// `minutes` é o valor já arredondado pela regra do contrato.
model SdTimeEntry {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  ticketId    String            @map("ticket_id")
  userId      String            @map("user_id")
  contractId  String?           @map("contract_id")
  periodId    String?           @map("period_id")
  source      SdTimeEntrySource @default(TIMER)
  startedAt   DateTime          @map("started_at")
  endedAt     DateTime?         @map("ended_at")
  minutes     Int               @default(0)
  billable    Boolean           @default(true)
  window      SdRateWindow      @default(BUSINESS_HOURS)
  /// Valor apurado do apontamento (congelado no fechamento).
  amount      Decimal?          @db.Decimal(14, 2)
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User              @relation("SdTimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  contract  SdContract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  period    SdContractPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([workspaceId, userId, startedAt])
  @@index([periodId])
  @@index([deletedAt])
  @@map("sd_time_entries")
}

enum SdChangeWindowKind {
  MAINTENANCE
  FREEZE
}

/// Janela de manutenção (quando pode mexer) ou de congelamento (quando não
/// pode). Serve de pano de fundo do calendário de mudanças.
model SdChangeWindow {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  name          String
  kind          SdChangeWindowKind @default(MAINTENANCE)
  startsAt      DateTime           @map("starts_at")
  endsAt        DateTime           @map("ends_at")
  /// Repetição opcional (RRULE simplificada: FREQ/INTERVAL/BYDAY).
  recurrence    Json?
  timezone      String             @default("America/Sao_Paulo")
  configItemIds String[]           @default([]) @map("config_item_ids")
  departmentIds String[]           @default([]) @map("department_ids")
  description   String?
  createdById   String             @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SdChangeWindowCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, startsAt])
  @@map("sd_change_windows")
}

/// Comitê de mudanças (CAB): quem aprova e quantas aprovações bastam.
model SdCabBoard {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  description String?
  /// Quantas aprovações fecham a rodada (0 = todos os membros).
  quorum      Int       @default(0)
  /// Uma reprovação encerra a rodada como reprovada.
  rejectEnds  Boolean   @default(true) @map("reject_ends")
  /// Condições do chamado que fazem este comitê ser o responsável
  /// (`SdConditionsSchema`): tipo de mudança, risco, departamento…
  conditions  Json      @default("[]")
  active      Boolean   @default(true)
  position    Int       @default(0)
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User              @relation("SdCabBoardCreatedBy", fields: [createdById], references: [id])
  members   SdCabMember[]
  rounds    SdApprovalRound[]

  @@index([workspaceId, position])
  @@map("sd_cab_boards")
}

model SdCabMember {
  id       String  @id @default(cuid())
  boardId  String  @map("board_id")
  userId   String  @map("user_id")
  /// Voto obrigatório: a rodada não fecha sem ele, mesmo com quórum.
  required Boolean @default(false)

  board SdCabBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User       @relation("SdCabMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@map("sd_cab_members")
}

enum SdApprovalRoundStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  EXPIRED
}

/// Rodada de aprovação: agrupa os pedidos (`SdTicketApproval`) enviados
/// juntos e guarda a regra de quórum aplicada. Pedido avulso continua
/// funcionando sem rodada.
model SdApprovalRound {
  id            String                @id @default(cuid())
  workspaceId   String                @map("workspace_id")
  ticketId      String                @map("ticket_id")
  boardId       String?               @map("board_id")
  status        SdApprovalRoundStatus @default(PENDING)
  quorum        Int                   @default(1)
  rejectEnds    Boolean               @default(true) @map("reject_ends")
  requestedById String                @map("requested_by_id")
  decidedAt     DateTime?             @map("decided_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket      SdTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  board       SdCabBoard?        @relation(fields: [boardId], references: [id], onDelete: SetNull)
  requestedBy User               @relation("SdApprovalRoundRequestedBy", fields: [requestedById], references: [id])
  approvals   SdTicketApproval[]

  @@index([ticketId])
  @@index([workspaceId, status])
  @@map("sd_approval_rounds")
}

enum SdOnCallRotation {
  DAILY
  WEEKLY
  BIWEEKLY
}

/// Escala de plantão de um time: camadas (primeira chamada, segunda…) com
/// rodízio entre os participantes.
model SdOnCallSchedule {
  id            String           @id @default(cuid())
  workspaceId   String           @map("workspace_id")
  departmentId  String?          @map("department_id")
  name          String
  timezone      String           @default("America/Sao_Paulo")
  rotation      SdOnCallRotation @default(WEEKLY)
  /// Início do rodízio e hora da virada (ex.: "09:00").
  rotationStart DateTime         @map("rotation_start")
  handoffTime   String           @default("09:00") @map("handoff_time")
  /// Só vale fora do expediente do calendário informado (opcional).
  calendarId    String?          @map("calendar_id")
  active        Boolean          @default(true)
  createdById   String           @map("created_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department SdDepartment?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  calendar   SdBusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  createdBy  User                @relation("SdOnCallScheduleCreatedBy", fields: [createdById], references: [id])
  layers     SdOnCallLayer[]
  overrides  SdOnCallOverride[]

  @@index([workspaceId, active])
  @@map("sd_oncall_schedules")
}

model SdOnCallLayer {
  id         String @id @default(cuid())
  scheduleId String @map("schedule_id")
  name       String
  /// 1 = primeira chamada, 2 = retaguarda…
  level      Int    @default(1)

  schedule     SdOnCallSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  participants SdOnCallParticipant[]

  @@unique([scheduleId, level])
  @@map("sd_oncall_layers")
}

model SdOnCallParticipant {
  id       String @id @default(cuid())
  layerId  String @map("layer_id")
  userId   String @map("user_id")
  position Int    @default(0)

  layer SdOnCallLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  user  User          @relation("SdOnCallParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([layerId, userId])
  @@index([userId])
  @@map("sd_oncall_participants")
}

/// Troca pontual: quem cobre o plantão nesta janela, no lugar do rodízio.
model SdOnCallOverride {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  scheduleId  String   @map("schedule_id")
  layerId     String?  @map("layer_id")
  userId      String   @map("user_id")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  reason      String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schedule  SdOnCallSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user      User             @relation("SdOnCallOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User             @relation("SdOnCallOverrideCreatedBy", fields: [createdById], references: [id])

  @@index([scheduleId, startsAt])
  @@map("sd_oncall_overrides")
}

enum SdRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SdRecurringRunStatus {
  CREATED
  SKIPPED
  FAILED
}

/// Chamado recorrente (manutenção preventiva, rotina periódica): agenda +
/// modelo do chamado que será aberto.
model SdRecurringTicket {
  id              String                @id @default(cuid())
  workspaceId     String                @map("workspace_id")
  name            String
  description     String?
  active          Boolean               @default(true)
  ticketType      SdTicketType          @map("ticket_type")
  templateId      String?               @map("template_id")
  /// Valores do chamado gerado (mesma forma do `SdTicketTemplate.defaults`).
  defaults        Json                  @default("{}")
  customerId      String?               @map("customer_id")
  configItemId    String?               @map("config_item_id")
  departmentId    String?               @map("department_id")
  assigneeId      String?               @map("assignee_id")
  // Agenda
  frequency       SdRecurrenceFrequency @default(MONTHLY)
  interval        Int                   @default(1)
  /// DAILY/WEEKLY: dias da semana (0=domingo). MONTHLY: dia do mês.
  byWeekday       Int[]                 @default([]) @map("by_weekday")
  byMonthday      Int?                  @map("by_monthday")
  atTime          String                @default("08:00") @map("at_time")
  timezone        String                @default("America/Sao_Paulo")
  startsAt        DateTime              @map("starts_at")
  endsAt          DateTime?             @map("ends_at")
  /// Abre o chamado com N minutos de antecedência da ocorrência.
  leadTimeMinutes Int                   @default(0) @map("lead_time_minutes")
  /// Não abre outra ocorrência enquanto a anterior estiver aberta.
  skipIfOpen      Boolean               @default(true) @map("skip_if_open")
  lastRunAt       DateTime?             @map("last_run_at")
  nextRunAt       DateTime?             @map("next_run_at")
  createdById     String                @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template   SdTicketTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customer   SdCustomer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  configItem SdConfigItem?          @relation(fields: [configItemId], references: [id], onDelete: SetNull)
  createdBy  User                   @relation("SdRecurringTicketCreatedBy", fields: [createdById], references: [id])
  runs       SdRecurringTicketRun[]

  @@index([workspaceId, active, nextRunAt])
  @@index([deletedAt])
  @@map("sd_recurring_tickets")
}

/// Ocorrência de um chamado recorrente — o histórico de "abriu, pulou ou
/// falhou", e a trava de idempotência por horário agendado.
model SdRecurringTicketRun {
  id           String               @id @default(cuid())
  workspaceId  String               @map("workspace_id")
  recurringId  String               @map("recurring_id")
  scheduledFor DateTime             @map("scheduled_for")
  status       SdRecurringRunStatus @default(CREATED)
  ticketId     String?              @map("ticket_id")
  reason       String?
  createdAt    DateTime             @default(now()) @map("created_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recurring SdRecurringTicket @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  ticket    SdTicket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([recurringId, scheduledFor])
  @@index([workspaceId, createdAt])
  @@map("sd_recurring_ticket_runs")
}

// ============================================================================
// ServiceDesk — Leva 3 de features: relatório de SLA agendado, KCS (ciclo de
// vida do artigo), IA preditiva de risco e integrações (Slack e GitHub).
// Ver docs/servicedesk/README.md.
// ============================================================================

enum SdReportKind {
  SLA
}

enum SdReportFormat {
  PDF
  CSV
}

enum SdReportPeriod {
  LAST_MONTH
  LAST_WEEK
  CURRENT_MONTH
  LAST_30_DAYS
  LAST_90_DAYS
}

/// Relatório agendado (hoje só SLA): o que medir, de quem, em que período e
/// para quem mandar. Destinatários são e-mails livres — internos ou do
/// cliente — porque nem todo mundo que recebe tem conta no Steel.
model SdScheduledReport {
  id                   String           @id @default(cuid())
  workspaceId          String           @map("workspace_id")
  name                 String
  kind                 SdReportKind     @default(SLA)
  /// Recorte: clientes, departamentos e tipos (vazio = todos).
  customerIds          String[]         @default([]) @map("customer_ids")
  departmentIds        String[]         @default([]) @map("department_ids")
  ticketTypes          SdTicketType[]   @default([]) @map("ticket_types")
  period               SdReportPeriod   @default(LAST_MONTH)
  formats              SdReportFormat[] @default([PDF, CSV])
  /// Dia do mês (1–28) e hora local do envio, no fuso do relatório.
  dayOfMonth           Int              @default(1) @map("day_of_month")
  atTime               String           @default("07:00") @map("at_time")
  timezone             String           @default("America/Sao_Paulo")
  recipients           String[]         @default([])
  /// Manda uma cópia para o responsável de cada cliente do recorte.
  includeAccountOwners Boolean          @default(false) @map("include_account_owners")
  active               Boolean          @default(true)
  lastRunAt            DateTime?        @map("last_run_at")
  nextRunAt            DateTime?        @map("next_run_at")
  createdById          String           @map("created_by_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("SdScheduledReportCreatedBy", fields: [createdById], references: [id])
  runs      SdReportRun[]

  @@index([workspaceId, active, nextRunAt])
  @@map("sd_scheduled_reports")
}

enum SdReportRunStatus {
  GENERATED
  SENT
  FAILED
}

/// Execução de um relatório: o recorte apurado, onde o arquivo foi parar e
/// para quem foi enviado. Também é a trava de idempotência do agendamento.
model SdReportRun {
  id            String            @id @default(cuid())
  workspaceId   String            @map("workspace_id")
  reportId      String?           @map("report_id")
  kind          SdReportKind      @default(SLA)
  status        SdReportRunStatus @default(GENERATED)
  periodStart   DateTime          @map("period_start")
  periodEnd     DateTime          @map("period_end")
  /// Resumo apurado (total, dentro do prazo, violados, MTTR, CSAT…), já
  /// pronto para a tela de histórico não ter de recalcular.
  summary       Json?
  /// Chaves no MinIO (bucket `servicedesk`), por formato.
  pdfKey        String?           @map("pdf_key")
  csvKey        String?           @map("csv_key")
  recipients    String[]          @default([])
  sentAt        DateTime?         @map("sent_at")
  error         String?
  requestedById String?           @map("requested_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  report      SdScheduledReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  requestedBy User?              @relation("SdReportRunRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  /// Trava de idempotência do agendamento: um relatório por período. Execução
  /// sob demanda tem `reportId` nulo e, como NULL não conflita em índice
  /// único no Postgres, pode repetir à vontade.
  @@unique([reportId, periodStart])
  @@index([workspaceId, createdAt])
  @@map("sd_report_runs")
}

enum SdKbReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// Revisão de artigo (KCS): quem revisou, o que decidiu e quando o artigo
/// precisa ser olhado de novo.
model SdKbReview {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  articleId   String           @map("article_id")
  reviewerId  String?          @map("reviewer_id")
  status      SdKbReviewStatus @default(PENDING)
  comment     String?
  decidedAt   DateTime?        @map("decided_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  article   SdKbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer  User?       @relation("SdKbReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([workspaceId, status])
  @@map("sd_kb_reviews")
}

enum SdRiskLevelPrediction {
  LOW
  MEDIUM
  HIGH
}

/// Previsão de risco de violação de SLA de um chamado. Heurística
/// explicável: `factors` guarda o porquê (prazo consumido, fila, prioridade,
/// reaberturas…), para a tela mostrar a razão e não só a nota.
model SdTicketRiskPrediction {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  ticketId    String                @unique @map("ticket_id")
  level       SdRiskLevelPrediction @default(LOW)
  /// 0–100: quanto maior, mais perto de violar.
  score       Int                   @default(0)
  /// [{"key":"sla_consumed","label":"…","weight":30,"detail":"…"}]
  factors     Json                  @default("[]")
  /// Previsão de quando o prazo estoura, se nada mudar.
  breachEtaAt DateTime?             @map("breach_eta_at")
  computedAt  DateTime              @default(now()) @map("computed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    SdTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([workspaceId, level, score])
  @@map("sd_ticket_risk_predictions")
}

/// Grupo de incidentes parecidos detectado pela análise (candidato a virar
/// um problema). `signature` é a chave de agrupamento (categoria + termos).
model SdIncidentCluster {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  signature       String
  title           String
  ticketIds       String[]  @default([]) @map("ticket_ids")
  ticketCount     Int       @default(0) @map("ticket_count")
  firstSeenAt     DateTime  @map("first_seen_at")
  lastSeenAt      DateTime  @map("last_seen_at")
  /// Problema aberto a partir do grupo, quando o agente aceita a sugestão.
  problemTicketId String?   @map("problem_ticket_id")
  dismissedAt     DateTime? @map("dismissed_at")
  dismissedById   String?   @map("dismissed_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dismissedBy User?     @relation("SdIncidentClusterDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, signature])
  @@index([workspaceId, lastSeenAt])
  @@map("sd_incident_clusters")
}

enum SdIntegrationKind {
  SLACK
  GITHUB
}

enum SdIntegrationStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

/// Integração do módulo com Slack ou GitHub. Segredos cifrados com
/// `CONNECTION_SECRETS`, como as demais conexões do produto.
///
/// DEPRECATED (settings-integrations, ADR 0024): the rows were copied to
/// `workspace_integrations` (same ids) and nothing reads or writes this table
/// any more. Kept only for rollback; drop it in a later migration.
model SdIntegration {
  id                     String              @id @default(cuid())
  workspaceId            String              @map("workspace_id")
  kind                   SdIntegrationKind
  status                 SdIntegrationStatus @default(ACTIVE)
  statusError            String?             @map("status_error")
  /// Identificação externa: workspace do Slack ou dono/repositório no GitHub.
  externalId             String              @map("external_id")
  externalName           String?             @map("external_name")
  encryptedToken         String              @map("encrypted_token")
  /// Segredo de assinatura do webhook recebido (Slack/GitHub).
  encryptedSigningSecret String?             @map("encrypted_signing_secret")
  /// Preferências da integração (canais por departamento, eventos, filtros).
  config                 Json                @default("{}")
  createdById            String              @map("created_by_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  deletedAt              DateTime?           @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SdIntegrationCreatedBy", fields: [createdById], references: [id])

  @@unique([workspaceId, kind, externalId])
  @@index([workspaceId, kind])
  @@map("sd_integrations")
}

enum SdIntegrationLinkKind {
  SLACK_THREAD
  GITHUB_ISSUE
  GITHUB_PULL_REQUEST
  GITLAB_ISSUE
  GITLAB_MERGE_REQUEST
}

/// Vínculo entre um chamado e algo externo: a thread do Slack que o
/// acompanha, ou a issue/PR do GitHub que o resolve.
model SdIntegrationLink {
  id            String                @id @default(cuid())
  workspaceId   String                @map("workspace_id")
  integrationId String                @map("integration_id")
  ticketId      String                @map("ticket_id")
  kind          SdIntegrationLinkKind
  /// Canal + timestamp da thread (Slack) ou número da issue/PR (GitHub).
  externalKey   String                @map("external_key")
  externalUrl   String?               @map("external_url")
  /// Último estado conhecido do lado de lá (open, merged, closed…).
  externalState String?               @map("external_state")
  meta          Json?
  createdById   String?               @map("created_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration WorkspaceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  ticket      SdTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation("SdIntegrationLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([integrationId, kind, externalKey])
  @@index([ticketId])
  @@map("sd_integration_links")
}

enum WorkspaceIntegrationKind {
  SLACK
  GITHUB
  GITLAB
  APOLLO

  @@map("workspace_integration_kind")
}

enum WorkspaceIntegrationStatus {
  ACTIVE
  ERROR
  DISCONNECTED

  @@map("workspace_integration_status")
}

/// Workspace-level connection to Slack, GitHub or GitLab (Ajustes >
/// Integrações), shared by every module. Token and webhook secret are
/// encrypted with `CONNECTION_SECRETS` and never leave the server. One live
/// connection per (workspace, kind); a disconnected row keeps `deletedAt` so
/// the ticket links that point at it stay in the ticket history.
model WorkspaceIntegration {
  id                     String                     @id @default(cuid())
  workspaceId            String                     @map("workspace_id")
  kind                   WorkspaceIntegrationKind
  status                 WorkspaceIntegrationStatus @default(ACTIVE)
  statusError            String?                    @map("status_error")
  /// Slack team id (`T…`), GitHub `owner/repo` or GitLab `group/project`.
  externalId             String                     @map("external_id")
  externalName           String?                    @map("external_name")
  /// GitLab instance (`https://gitlab.com` or self-managed). Null otherwise.
  baseUrl                String?                    @map("base_url")
  encryptedToken         String                     @map("encrypted_token")
  /// Webhook secret (GitHub HMAC key, GitLab `X-Gitlab-Token`).
  encryptedSigningSecret String?                    @map("encrypted_signing_secret")
  /// Notification rules and per-module settings (`src/lib/integrations/config.ts`).
  config                 Json                       @default("{}")
  /// Last inbound/outbound event (webhook received, Slack message sent).
  lastEventAt            DateTime?                  @map("last_event_at")
  lastEventType          String?                    @map("last_event_type")
  /// Last "Testar conexão" (success or failure).
  lastCheckedAt          DateTime?                  @map("last_checked_at")
  createdById            String                     @map("created_by_id")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")
  deletedAt              DateTime?                  @map("deleted_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User                @relation("WorkspaceIntegrationCreatedBy", fields: [createdById], references: [id])
  sdLinks   SdIntegrationLink[]

  @@unique([workspaceId, kind, externalId])
  @@index([workspaceId, kind])
  @@index([kind, externalId])
  @@map("workspace_integrations")
}

// ─── Steel Agents (autonomous AI agents) ─────────────────────────────────────

enum SteelAgentTriggerType {
  /// Cron expression (`cron` + `timezone`), checked every minute.
  SCHEDULE
  /// Domain event (`eventKey`, catalog in `src/lib/steel-agents/events.ts`).
  EVENT
  /// Only the "Executar agora" button.
  MANUAL
}

/// AUTO = the agent executes the write on its own (never for DELETE tools);
/// APPROVAL = the write becomes an AiPendingAction approved in the inbox.
enum SteelAgentToolMode {
  AUTO
  APPROVAL
}

enum SteelAgentRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  SUCCEEDED
  FAILED
  SKIPPED
}

enum SteelAgentRunStepKind {
  MODEL
  TOOL
  APPROVAL
}

enum SteelAgentRunStepStatus {
  OK
  FAILED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  /// Test run: the write was simulated from its preview, never executed.
  SIMULATED
}

/// Autonomous agent configured by a workspace admin. It runs with the
/// permissions of `ownerId` (the domain services still enforce RBAC for that
/// user); no owner (account deleted) = the agent never runs.
model SteelAgent {
  id            String                @id @default(cuid())
  workspaceId   String                @map("workspace_id")
  name          String
  description   String?               @db.Text
  /// System prompt written by the admin.
  instructions  String                @db.Text
  triggerType   SteelAgentTriggerType @map("trigger_type")
  cron          String?
  timezone      String                @default("America/Sao_Paulo")
  eventKey      String?               @map("event_key")
  enabled       Boolean               @default(true)
  ownerId       String?               @map("owner_id")
  createdById   String?               @map("created_by_id")
  maxToolRounds Int                   @default(8) @map("max_tool_rounds")
  /// Optional cap of runs per calendar month (null = unlimited).
  monthlyRunCap Int?                  @map("monthly_run_cap")
  /// Last cron occurrence already dispatched (schedule dedupe).
  lastRunAt     DateTime?             @map("last_run_at")
  nextRunAt     DateTime?             @map("next_run_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?            @relation("SteelAgentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("SteelAgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tools     SteelAgentTool[]
  runs      SteelAgentRun[]

  @@index([workspaceId])
  @@index([triggerType, enabled])
  @@map("steel_agents")
}

/// A registry tool (`STEEL_AI_TOOLS`) the agent may call, and how writes run.
model SteelAgentTool {
  id        String             @id @default(cuid())
  agentId   String             @map("agent_id")
  toolName  String             @map("tool_name")
  mode      SteelAgentToolMode @default(APPROVAL)
  createdAt DateTime           @default(now()) @map("created_at")

  agent SteelAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
  @@map("steel_agent_tools")
}

/// One execution of an agent. `state` keeps the provider transcript and the
/// round counter so a run paused on WAITING_APPROVAL resumes exactly.
model SteelAgentRun {
  id             String                @id @default(cuid())
  workspaceId    String                @map("workspace_id")
  agentId        String                @map("agent_id")
  status         SteelAgentRunStatus   @default(QUEUED)
  triggerType    SteelAgentTriggerType @map("trigger_type")
  triggerPayload Json?                 @map("trigger_payload")
  /// Human who clicked "Executar agora" (null for schedule/event).
  startedById    String?               @map("started_by_id")
  startedAt      DateTime?             @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  summary        String?               @db.Text
  error          String?               @db.Text
  modelKey       String?               @map("model_key")
  rounds         Int                   @default(0)
  inputTokens    Int                   @default(0) @map("input_tokens")
  outputTokens   Int                   @default(0) @map("output_tokens")
  costUsd        Decimal               @default(0) @map("cost_usd") @db.Decimal(14, 6)
  state          Json?
  /// "Testar agente": reads real, writes simulated, no approvals, never
  /// counts against the monthly cap nor shows as the agent's last run.
  isTest         Boolean               @default(false) @map("is_test")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent          SteelAgent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  startedBy      User?               @relation("SteelAgentRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  steps          SteelAgentRunStep[]
  pendingActions AiPendingAction[]

  @@index([agentId, createdAt])
  @@index([workspaceId, status])
  @@map("steel_agent_runs")
}

/// Timeline of a run: each model call, tool call and approval.
model SteelAgentRunStep {
  id              String                  @id @default(cuid())
  runId           String                  @map("run_id")
  kind            SteelAgentRunStepKind
  toolName        String?                 @map("tool_name")
  toolCallId      String?                 @map("tool_call_id")
  pendingActionId String?                 @map("pending_action_id")
  input           Json?
  output          Json?
  status          SteelAgentRunStepStatus
  error           String?                 @db.Text
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  run SteelAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([pendingActionId])
  @@map("steel_agent_run_steps")
}

/// Global search index (Ctrl+K): one denormalized row per searchable record,
/// kept fresh by the services (fire-and-forget) and by the nightly
/// `search-reindex` job. `title_norm` and `search_vector` are GENERATED
/// columns (unaccent + Portuguese stemming, weights A/B/C) — written only by
/// Postgres; the app writes through raw SQL (`SearchDocumentRepository`).
model SearchDocument {
  workspaceId  String                   @map("workspace_id")
  entityType   String                   @map("entity_type")
  entityId     String                   @map("entity_id")
  /// ModuleKind of the record, `null` for platform records (members).
  module       String?
  /// PUBLIC | AGENTS | PARTIES (see `src/lib/search/search-entities.ts`).
  audience     String                   @default("PUBLIC")
  title        String
  subtitle     String?
  body         String?
  keywords     String                   @default("")
  codes        String[]                 @default([])
  userIds      String[]                 @default([]) @map("user_ids")
  path         String
  updatedAt    DateTime                 @map("updated_at") @db.Timestamptz(6)
  indexedAt    DateTime                 @default(now()) @map("indexed_at") @db.Timestamptz(6)
  /// GENERATED ALWAYS (the `dbgenerated` default mirrors the expression so
  /// `migrate diff` sees no drift).
  titleNorm    String?                  @default(dbgenerated("lower(f_unaccent(title))")) @map("title_norm")
  searchVector Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('portuguese'::regconfig, f_unaccent(COALESCE(title, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(keywords, ''::text))), 'A'::\"char\")) || setweight(to_tsvector('portuguese'::regconfig, f_unaccent(COALESCE(subtitle, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('portuguese'::regconfig, f_unaccent(COALESCE(body, ''::text))), 'C'::\"char\"))")) @map("search_vector")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, entityType, entityId])
  @@index([searchVector], type: Gin, map: "search_documents_search_vector_idx")
  @@index([titleNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "search_documents_title_norm_trgm_idx")
  @@index([codes], type: Gin, map: "search_documents_codes_idx")
  @@index([workspaceId, entityType, indexedAt])
  @@map("search_documents")
}

/// Steel AI knowledge index (ADR 0037): the text the assistant may cite —
/// KB articles, Wiki pages, resolved tickets, WhatsApp AI documents, CRM
/// notes and proposals — split into chunks. Permissions are re-applied at
/// query time (`audience`, `user_ids` and the source-type allow-list). The
/// embedding of each chunk lives in `ai_vector.ai_knowledge_embeddings`,
/// outside the Prisma schema, created only where pgvector is installed.
model AiKnowledgeChunk {
  id              String                   @id @default(cuid())
  workspaceId     String                   @map("workspace_id")
  /// `src/lib/ai/knowledge/sources.ts` (sd-kb-article, wiki-page, ...).
  sourceType      String                   @map("source_type")
  sourceId        String                   @map("source_id")
  chunkIndex      Int                      @map("chunk_index")
  /// ModuleKind of the source, `null` for platform sources (Wiki).
  module          String?
  /// PUBLIC | AGENTS | PARTIES, same meaning as `search_documents.audience`.
  audience        String                   @default("PUBLIC")
  /// Requester/participants of a ticket (`PARTIES` access).
  userIds         String[]                 @default([]) @map("user_ids")
  title           String
  content         String
  /// App path relative to the workspace (the citation link).
  path            String
  /// sha256 of title + content: the embedding is redone only when it changes.
  contentHash     String                   @map("content_hash")
  sourceUpdatedAt DateTime                 @map("source_updated_at") @db.Timestamptz(6)
  indexedAt       DateTime                 @default(now()) @map("indexed_at") @db.Timestamptz(6)
  /// GENERATED ALWAYS (the `dbgenerated` default mirrors the expression so
  /// `migrate diff` sees no drift).
  searchVector    Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('portuguese'::regconfig, f_unaccent(COALESCE(title, ''::text))), 'A'::\"char\") || setweight(to_tsvector('portuguese'::regconfig, f_unaccent(COALESCE(content, ''::text))), 'B'::\"char\"))")) @map("search_vector")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceType, sourceId, chunkIndex])
  @@index([searchVector], type: Gin, map: "ai_knowledge_chunks_search_vector_idx")
  @@index([workspaceId, sourceType, indexedAt])
  @@map("ai_knowledge_chunks")
}

model WikiPage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  parentId    String?   @map("parent_id")
  title       String
  icon        String?
  coverImage  String?   @map("cover_image")
  content     Json
  yjsState    Bytes?    @map("yjs_state")
  position    Int       @default(0)
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Secret of the public read-only link `/w/<publicToken>` (192 random
  /// bits, base64url). Null while the page is not published; unpublishing
  /// clears it, so the old link 404s.
  publicToken String?   @unique @map("public_token")
  publishedAt DateTime? @map("published_at")
  /// Edit lock: while set, only the author and workspace OWNER/ADMIN edit.
  lockedAt    DateTime? @map("locked_at")
  lockedById  String?   @map("locked_by_id")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    WikiPage?          @relation("WikiPageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  WikiPage[]         @relation("WikiPageTree")
  createdBy User?              @relation("WikiPageAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?              @relation("WikiPageEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  lockedBy  User?              @relation("WikiPageLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  comments  WikiComment[]
  labels    WikiPageLabel[]
  favorites WikiPageFavorite[]

  @@index([workspaceId, archivedAt])
  @@map("wiki_pages")
}

/// Per-user favorite wiki page (the sidebar's "Favoritos").
model WikiPageFavorite {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  wikiPageId String   @map("wiki_page_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wikiPage WikiPage @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)

  @@unique([userId, wikiPageId])
  @@index([wikiPageId])
  @@map("wiki_page_favorites")
}

model WikiComment {
  id           String    @id @default(cuid())
  wikiPageId   String    @map("wiki_page_id")
  authorId     String?   @map("author_id")
  parentId     String?   @map("parent_id")
  // Discussion id shared by the root comment and all its replies — matches
  // the Plate `comment_<markId>` mark applied to the referenced text range.
  markId       String    @map("mark_id")
  content      Json
  // Only meaningful on the root comment (parentId null); replies inherit the
  // thread's resolved state instead of carrying their own.
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  wikiPage   WikiPage      @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  author     User?         @relation("WikiCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy User?         @relation("WikiCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  parent     WikiComment?  @relation("WikiCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    WikiComment[] @relation("WikiCommentThread")

  @@index([wikiPageId, markId])
  @@map("wiki_comments")
}

/// Etiqueta da Wiki, gerida em Ajustes > Wiki e aplicada às páginas.
model WikiLabel {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages     WikiPageLabel[]

  @@unique([workspaceId, name])
  @@map("wiki_labels")
}

model WikiPageLabel {
  wikiPageId String   @map("wiki_page_id")
  labelId    String   @map("label_id")
  createdAt  DateTime @default(now()) @map("created_at")

  wikiPage WikiPage  @relation(fields: [wikiPageId], references: [id], onDelete: Cascade)
  label    WikiLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([wikiPageId, labelId])
  @@index([labelId])
  @@map("wiki_page_labels")
}

// ─── Ajustes › Exportações ──────────────────────────────────────────────────

enum WorkspaceExportKind {
  /// Dados completos do workspace (ZIP com JSON + CSV por tabela).
  DATA
  /// Logs do workspace no Axiom (ZIP com CSV + NDJSON).
  LOGS
}

enum WorkspaceExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

/// Exportação pedida por um OWNER/ADMIN em Ajustes › Exportações. Uma de cada
/// tipo por workspace por dia (São Paulo): o índice único em
/// `(workspace_id, kind, day_key)` segura cliques simultâneos, e uma falha
/// zera `day_key` para liberar a nova tentativa no mesmo dia.
model WorkspaceExport {
  id            String                @id @default(cuid())
  workspaceId   String                @map("workspace_id")
  kind          WorkspaceExportKind
  status        WorkspaceExportStatus @default(PENDING)
  requestedById String?               @map("requested_by_id")
  /// `YYYY-MM-DD` (São Paulo) do pedido; `null` depois de uma falha.
  dayKey        String?               @map("day_key")
  /// LOGS: janela consultada no Axiom.
  periodFrom    DateTime?             @map("period_from")
  periodTo      DateTime?             @map("period_to")
  /// Objeto no bucket `workspace-exports`; `null` depois de expirar.
  storageKey    String?               @map("storage_key")
  fileName      String?               @map("file_name")
  sizeBytes     BigInt?               @map("size_bytes")
  /// Tabelas (DATA) ou eventos (LOGS) no arquivo.
  itemCount     Int?                  @map("item_count")
  errorMessage  String?               @map("error_message")
  createdAt     DateTime              @default(now()) @map("created_at")
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  expiresAt     DateTime?             @map("expires_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation("WorkspaceExportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, kind, dayKey])
  @@index([workspaceId, createdAt])
  @@index([status, expiresAt])
  @@map("workspace_exports")
}

/// Quadro-branco (Excalidraw) do workspace. `scene` guarda os elementos, um
/// recorte do appState e só as referências dos arquivos — as imagens ficam no
/// bucket `whiteboards`, nunca em base64 no banco.
model Whiteboard {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  title             String
  scene             Json
  /// Bumped on every scene save; a save carries the revision it started from
  /// (optimistic locking).
  revision          Int       @default(0)
  /// Board revision held by the newest version (drives the auto cadence).
  versionedRevision Int       @default(0) @map("versioned_revision")
  lastVersionAt     DateTime? @map("last_version_at")
  /// PNG preview in the `whiteboards` bucket (`<ws>/thumbnails/<id>.png`).
  thumbnailAt       DateTime? @map("thumbnail_at")
  /// Edit lease: only its holder saves while it lasts (single editor).
  lockedById        String?   @map("locked_by_id")
  lockedUntil       DateTime? @map("locked_until")
  createdById       String?   @map("created_by_id")
  updatedById       String?   @map("updated_by_id")
  archivedAt        DateTime? @map("archived_at")
  /// Last content/title change ("editado há…"); `updatedAt` also moves on
  /// lease renewals and thumbnails, so lists sort by this one.
  editedAt          DateTime  @default(now()) @map("edited_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?               @relation("WhiteboardAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?               @relation("WhiteboardEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  lockedBy  User?               @relation("WhiteboardLockHolder", fields: [lockedById], references: [id], onDelete: SetNull)
  versions  WhiteboardVersion[]

  @@index([workspaceId, archivedAt, editedAt])
  @@map("whiteboards")
}

enum WhiteboardVersionKind {
  /// Cut by the save cadence; only the newest ones are kept.
  AUTO
  /// "Salvar versão" — kept for the life of the board.
  MANUAL
  /// Created by restoring an older version — kept like MANUAL.
  RESTORE
}

/// Snapshot of a board's scene for the history panel. Restoring one creates
/// a new RESTORE version; versions are never edited.
model WhiteboardVersion {
  id             String                @id @default(cuid())
  whiteboardId   String                @map("whiteboard_id")
  kind           WhiteboardVersionKind
  name           String?
  scene          Json
  /// Board revision this snapshot holds.
  revision       Int
  elementCount   Int                   @default(0) @map("element_count")
  restoredFromId String?               @map("restored_from_id")
  createdById    String?               @map("created_by_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  whiteboard Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("WhiteboardVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([whiteboardId, kind, createdAt])
  @@map("whiteboard_versions")
}

// ─── Site builder (ADR 0026, phase S1) ────────────────────────────────────

enum SiteStatus {
  DRAFT
  PUBLISHED
}

enum SiteGlobalKind {
  HEADER
  FOOTER
  SYMBOL
  /// Template of a dynamic page (blog index/post/archives, collection
  /// item); `name` holds the template key (see src/lib/sites/blog/templates.ts).
  TEMPLATE
}

/// A website built with the Steel Canvas `site` catalog. `slug` is globally
/// unique because it doubles as the subdomain (`<slug>.<SITES_ROOT_DOMAIN>`);
/// a soft-deleted site gets its slug rewritten so the name is freed. The draft
/// lives in the pages/globals/theme rows; the public runtime only ever reads
/// `publishedVersion` (an immutable snapshot).
model Site {
  id                  String     @id @default(cuid())
  workspaceId         String     @map("workspace_id")
  name                String
  slug                String     @unique
  status              SiteStatus @default(DRAFT)
  /// Theme of the `site` catalog (palette, typography, buttons, spacing).
  theme               Json       @default("{}")
  /// SEO defaults, favicon, social image, tracking ids, cookie banner.
  settings            Json       @default("{}")
  homePageId          String?    @map("home_page_id")
  publishedVersionId  String?    @unique @map("published_version_id")
  publishedAt         DateTime?  @map("published_at")
  /// Landing page this site was migrated from (idempotent migration).
  sourceLandingPageId String?    @unique @map("source_landing_page_id")
  createdById         String     @map("created_by_id")
  updatedById         String?    @map("updated_by_id")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User               @relation("SiteCreatedBy", fields: [createdById], references: [id])
  updatedBy        User?              @relation("SiteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedVersion SiteVersion?       @relation("SitePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  pages            SitePage[]
  globals          SiteGlobal[]
  versions         SiteVersion[]      @relation("SiteVersions")
  views            SiteView[]
  redirects        SiteRedirect[]
  posts            SitePost[]
  blogCategories   SiteBlogCategory[]
  blogTags         SiteBlogTag[]
  authors          SiteAuthor[]
  collections      SiteCollection[]
  experiments      SiteExperiment[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@map("sites")
}

/// One page of a site. `slug` is the last URL segment; `path` is the full
/// path (parent slugs joined by `/`), unique per site. The home page is
/// served at `/` and also at its own path.
model SitePage {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  parentId  String?  @map("parent_id")
  title     String
  slug      String
  path      String
  /// Canvas document of the `site` catalog.
  document  Json
  /// Title, description, social image, noindex.
  seo       Json     @default("{}")
  position  Int      @default(0)
  isHome    Boolean  @default(false) @map("is_home")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   SitePage?  @relation("SitePageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children SitePage[] @relation("SitePageTree")

  @@unique([siteId, path])
  @@index([siteId, position])
  @@index([parentId])
  @@map("site_pages")
}

/// Shared document of a site: the header and footer around every page, and
/// symbols (reusable blocks) referenced by `meta.symbolId`.
model SiteGlobal {
  id        String         @id @default(cuid())
  siteId    String         @map("site_id")
  kind      SiteGlobalKind
  name      String
  document  Json
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, kind])
  @@map("site_globals")
}

/// Immutable snapshot of a publication: theme, settings, globals and pages.
/// Restoring copies it back into the draft rows.
model SiteVersion {
  id            String   @id @default(cuid())
  siteId        String   @map("site_id")
  number        Int
  snapshot      Json
  publishedById String?  @map("published_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  site          Site  @relation("SiteVersions", fields: [siteId], references: [id], onDelete: Cascade)
  publishedBy   User? @relation("SiteVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedSite Site? @relation("SitePublishedVersion")

  @@unique([siteId, number])
  @@map("site_versions")
}

/// Anonymous page view of a published site. No PII: `visitorHash` is a
/// daily-salted hash (IP + user agent + site + day), the referrer keeps only
/// its host and UTM values are capped.
model SiteView {
  id          String        @id @default(cuid())
  siteId      String        @map("site_id")
  pageId      String?       @map("page_id")
  path        String
  visitorHash String        @map("visitor_hash")
  referrer    String?
  utmSource   String?       @map("utm_source")
  utmMedium   String?       @map("utm_medium")
  utmCampaign String?       @map("utm_campaign")
  utmTerm     String?       @map("utm_term")
  utmContent  String?       @map("utm_content")
  /// VIEW (page view) or CONVERSION (a CRM form sent from the page).
  kind        SiteEventKind @default(VIEW)
  /// Public token of the CRM form behind a CONVERSION.
  formToken   String?       @map("form_token")
  createdAt   DateTime      @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("site_views")
}

enum SiteEventKind {
  VIEW
  CONVERSION
}

/// 301-style redirect of a site (old address → new one), applied by the
/// public runtime before the page lookup. Takes effect right away (not
/// part of the published snapshot).
model SiteRedirect {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  /// Normalized path (`/antigo`, `/blog/*`), unique per site.
  fromPath  String   @map("from_path")
  /// Site path (`/novo`) or absolute URL.
  toPath    String   @map("to_path")
  permanent Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, fromPath])
  @@map("site_redirects")
}

// ─── Site blog and collections (Sites wave S4, slice site-blog) ──────────

enum SitePostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum SiteCollectionItemStatus {
  DRAFT
  PUBLISHED
}

/// Blog post of a site. Unlike pages, posts go live on their own (no site
/// publish): PUBLISHED with `publishedAt` in the past is public; SCHEDULED
/// is flipped to PUBLISHED by the worker at `publishedAt`. `content` is the
/// Plate editor value; `contentHtml` is its sanitized HTML, rendered on save.
model SitePost {
  id             String         @id @default(cuid())
  siteId         String         @map("site_id")
  title          String
  slug           String
  excerpt        String?
  content        Json           @default("[]")
  contentHtml    String         @default("") @map("content_html")
  /// Plain text of the body (search, feeds, llms.txt, AI), capped.
  plainText      String         @default("") @map("plain_text")
  /// First words of the body: the card text when `excerpt` is empty.
  autoExcerpt    String         @default("") @map("auto_excerpt")
  coverImageUrl  String?        @map("cover_image_url")
  coverImageAlt  String?        @map("cover_image_alt")
  authorId       String?        @map("author_id")
  status         SitePostStatus @default(DRAFT)
  featured       Boolean        @default(false)
  publishedAt    DateTime?      @map("published_at")
  wordCount      Int            @default(0) @map("word_count")
  readingMinutes Int            @default(1) @map("reading_minutes")
  /// Title/description, focus keyword, social image, canonical, noindex,
  /// FAQ (same shape as the page SEO plus the post-only fields).
  seo            Json           @default("{}")
  createdById    String         @map("created_by_id")
  updatedById    String?        @map("updated_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author     SiteAuthor?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories SitePostCategory[]
  tags       SitePostTag[]

  @@unique([siteId, slug])
  @@index([siteId, status, publishedAt])
  @@index([status, publishedAt])
  @@map("site_posts")
}

model SiteBlogCategory {
  id          String   @id @default(cuid())
  siteId      String   @map("site_id")
  name        String
  slug        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  site  Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts SitePostCategory[]

  @@unique([siteId, slug])
  @@map("site_blog_categories")
}

model SiteBlogTag {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")

  site  Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts SitePostTag[]

  @@unique([siteId, slug])
  @@map("site_blog_tags")
}

model SitePostCategory {
  postId     String @map("post_id")
  categoryId String @map("category_id")

  post     SitePost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  category SiteBlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
  @@map("site_post_categories")
}

model SitePostTag {
  postId String @map("post_id")
  tagId  String @map("tag_id")

  post SitePost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  SiteBlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("site_post_tags")
}

/// Public author profile of a site's blog, tied to a workspace member
/// (`userId`, no FK: the profile and its posts outlive the account).
model SiteAuthor {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  userId    String?  @map("user_id")
  name      String
  slug      String
  bio       String?
  avatarUrl String?  @map("avatar_url")
  /// Social/profile links: [{ network, url }].
  links     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site  Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  posts SitePost[]

  @@unique([siteId, slug])
  @@unique([siteId, userId])
  @@map("site_authors")
}

/// Custom content type of a site (cases, equipe, vagas, imóveis…): typed
/// `fields` and items served at `/<slug>/<item slug>` when the collection
/// has an item template (`templateGlobalId`, a TEMPLATE global; no FK
/// because restoring a version recreates the globals with the same ids).
model SiteCollection {
  id               String   @id @default(cuid())
  siteId           String   @map("site_id")
  name             String
  /// Singular label ("Caso", "Vaga") for the UI.
  itemName         String   @map("item_name")
  slug             String
  /// Field definitions: [{ key, label, type, required, ... }].
  fields           Json     @default("[]")
  templateGlobalId String?  @map("template_global_id")
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  site  Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items SiteCollectionItem[]

  @@unique([siteId, slug])
  @@map("site_collections")
}

model SiteCollectionItem {
  id           String                   @id @default(cuid())
  collectionId String                   @map("collection_id")
  title        String
  slug         String
  /// Field values by field key, validated against the collection fields.
  data         Json                     @default("{}")
  status       SiteCollectionItemStatus @default(DRAFT)
  position     Int                      @default(0)
  publishedAt  DateTime?                @map("published_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  collection SiteCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, slug])
  @@index([collectionId, status, position])
  @@map("site_collection_items")
}

/// Yjs state of a Steel Canvas document co-edited in real time (site pages,
/// site globals, e-mail templates v2). `documentName` is the realtime room
/// (`canvas.<kind>.<id>`). `documentHash` is the hash of the stored JSON
/// document this state was persisted with: when the row's document changed
/// elsewhere (REST autosave, version restore), the realtime server merges
/// that change into the state on load.
model CanvasCollabState {
  documentName String   @id @map("document_name")
  workspaceId  String   @map("workspace_id")
  state        Bytes
  documentHash String   @map("document_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("canvas_collab_states")
}

enum SiteExperimentKind {
  /// Variants of one section of a page (siblings marked `meta.variantOf`).
  SECTION
  /// Variants of a whole page (hidden copies of the page).
  PAGE
}

enum SiteExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  ENDED
}

enum SiteExperimentEventKind {
  EXPOSURE
  CONVERSION
}

/// A/B test of a published site. Variants live in the site's documents (a
/// section variant is a sibling section with `meta.variantOf`, a page
/// variant is a hidden page); the public runtime assigns each visitor a
/// variant of the published version. `run` grows on every restart, so the
/// results of a run never mix with an earlier one.
model SiteExperiment {
  id            String               @id @default(cuid())
  siteId        String               @map("site_id")
  /// Page the test runs on (the control page of a PAGE test).
  pageId        String               @map("page_id")
  name          String
  kind          SiteExperimentKind
  status        SiteExperimentStatus @default(DRAFT)
  /// Section under test (SECTION tests).
  controlNodeId String?              @map("control_node_id")
  /// `[{ key, name, weight, nodeId?, pageId? }]`; `A` is the control.
  variants      Json
  /// `{ type: FORM, formToken? } | { type: CLICK, nodeId, label } | { type: PAGE, pageId }`.
  goal          Json
  startsAt      DateTime?            @map("starts_at")
  endsAt        DateTime?            @map("ends_at")
  run           Int                  @default(1)
  startedAt     DateTime?            @map("started_at")
  endedAt       DateTime?            @map("ended_at")
  winnerKey     String?              @map("winner_key")
  /// Hash of each variant's published content when the run started: a
  /// publish that changes it restarts the test.
  fingerprints  Json                 @default("{}")
  createdById   String               @map("created_by_id")
  updatedById   String?              @map("updated_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  site   Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  events SiteExperimentEvent[]

  @@index([siteId, status])
  @@map("site_experiments")
}

/// Exposure or conversion of one visitor in one run of an experiment. No
/// PII: `visitorKey` is the opaque key of the A/B cookie (after consent) or
/// a hash derived from the daily visitor hash. One row per visitor, kind
/// and run.
model SiteExperimentEvent {
  id           String                  @id @default(cuid())
  experimentId String                  @map("experiment_id")
  run          Int
  variantKey   String                  @map("variant_key")
  kind         SiteExperimentEventKind
  visitorKey   String                  @map("visitor_key")
  createdAt    DateTime                @default(now()) @map("created_at")

  experiment SiteExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, run, kind, visitorKey])
  @@index([experimentId, run, variantKey])
  @@map("site_experiment_events")
}

// ---------------------------------------------------------------------------
// OAuth 2.1 provider for integrations (ADR 0033): models required by
// `@better-auth/oauth-provider`. Model and field names follow the plugin's
// schema (the Prisma adapter maps `oauthClient` → `prisma.oauthClient`).
// Tokens and client secrets are stored hashed (SHA-256) by the plugin.
// ---------------------------------------------------------------------------

model OauthClient {
  id                      String    @id @default(cuid())
  clientId                String    @unique @map("client_id")
  clientSecret            String?   @map("client_secret")
  disabled                Boolean?  @default(false)
  skipConsent             Boolean?  @map("skip_consent")
  enableEndSession        Boolean?  @map("enable_end_session")
  subjectType             String?   @map("subject_type")
  scopes                  String[]
  userId                  String?   @map("user_id")
  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @updatedAt @map("updated_at")
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]
  tos                     String?
  policy                  String?
  softwareId              String?   @map("software_id")
  softwareVersion         String?   @map("software_version")
  softwareStatement       String?   @map("software_statement")
  redirectUris            String[]  @map("redirect_uris")
  postLogoutRedirectUris  String[]  @map("post_logout_redirect_uris")
  tokenEndpointAuthMethod String?   @map("token_endpoint_auth_method")
  grantTypes              String[]  @map("grant_types")
  responseTypes           String[]  @map("response_types")
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?  @map("require_pkce")
  referenceId             String?   @map("reference_id")
  metadata                Json?

  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     OauthRefreshToken[]
  accessTokens      OauthAccessToken[]
  consents          OauthConsent[]
  integrationGrants IntegrationGrant[]

  @@index([userId])
  @@map("oauth_clients")
}

model OauthRefreshToken {
  id          String    @id @default(cuid())
  token       String    @unique
  clientId    String    @map("client_id")
  sessionId   String?   @map("session_id")
  userId      String    @map("user_id")
  /// `IntegrationGrant.id` the token was issued for.
  referenceId String?   @map("reference_id")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  revoked     DateTime?
  authTime    DateTime? @map("auth_time")
  scopes      String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([referenceId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id          String    @id @default(cuid())
  token       String?   @unique
  clientId    String    @map("client_id")
  sessionId   String?   @map("session_id")
  userId      String?   @map("user_id")
  /// `IntegrationGrant.id` the token was issued for.
  referenceId String?   @map("reference_id")
  refreshId   String?   @map("refresh_id")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  scopes      String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([referenceId])
  @@map("oauth_access_tokens")
}

model OauthConsent {
  id          String    @id @default(cuid())
  clientId    String    @map("client_id")
  userId      String?   @map("user_id")
  /// `IntegrationGrant.id` the consent belongs to.
  referenceId String?   @map("reference_id")
  scopes      String[]
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([referenceId])
  @@map("oauth_consents")
}

/// What an integration (MCP client, later the CLI) may do on behalf of a user:
/// one workspace, the consented scopes and modules (ADR 0033). OAuth tokens
/// point here through `referenceId`. Unique per (user, client, workspace)
/// while not revoked — a partial unique index in the migration.
model IntegrationGrant {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  workspaceId  String       @map("workspace_id")
  clientId     String       @map("client_id")
  scopes       String[]
  modules      ModuleKind[]
  /// Host of the redirect_uri the user saw on the consent screen (where the
  /// code went). The client's name is self-declared; this is not.
  redirectHost String?      @map("redirect_host")
  lastUsedAt   DateTime?    @map("last_used_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  pendingActions AiPendingAction[]

  @@index([userId, revokedAt])
  @@index([workspaceId, revokedAt])
  @@index([clientId])
  @@map("integration_grants")
}

/// How a personal API token was issued (ADR 0035).
enum ApiTokenCreatedVia {
  SETTINGS
  DEVICE
}

/// Personal API token (`stl_pat_...`) of the public API v1 (ADR 0035): one
/// user, one workspace, scopes and modules. Only the SHA-256 of the value is
/// stored; the value itself is shown once, at creation.
model ApiToken {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  workspaceId String             @map("workspace_id")
  name        String
  tokenHash   String             @unique @map("token_hash")
  /// First 8 characters after `stl_pat_`, for display (`stl_pat_abcd1234…`).
  prefix      String
  scopes      String[]
  modules     ModuleKind[]
  expiresAt   DateTime           @map("expires_at")
  /// Written at most once per minute.
  lastUsedAt  DateTime?          @map("last_used_at")
  revokedAt   DateTime?          @map("revoked_at")
  createdVia  ApiTokenCreatedVia @default(SETTINGS) @map("created_via")
  /// Machine name the CLI sent on the device flow.
  deviceName  String?            @map("device_name")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([workspaceId, revokedAt])
  @@map("api_tokens")
}

// ─── Outbound webhooks (ADR 0036) ───────────────────────────────────────────

/// A workspace HTTPS URL that receives signed Steel events (Ajustes ›
/// Integrações › Webhooks). OWNER/ADMIN manage it, in the app or by the API v1.
model WebhookEndpoint {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  url             String
  description     String?
  /// Catalog types (`src/lib/webhooks/events.ts`) or `*` for every event.
  events          String[]
  /// HMAC-SHA256 key (`whsec_...`), encrypted with `CONNECTION_SECRETS`.
  encryptedSecret String    @map("encrypted_secret")
  /// Last 4 characters of the secret, to tell secrets apart on screen.
  secretHint      String    @map("secret_hint")
  active          Boolean   @default(true)
  /// Set when the endpoint was switched off; `auto` after 3 days failing.
  disabledAt      DateTime? @map("disabled_at")
  disabledReason  String?   @map("disabled_reason")
  /// First failed attempt since the last success (auto-disable clock).
  failingSince    DateTime? @map("failing_since")
  lastSuccessAt   DateTime? @map("last_success_at")
  lastFailureAt   DateTime? @map("last_failure_at")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User              @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([workspaceId, active, deletedAt])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  /// Queued, first attempt not made yet.
  PENDING
  /// Answered 2xx.
  SUCCEEDED
  /// Failed; the queue tries again.
  RETRYING
  /// Failed on the last attempt (or the URL was refused).
  FAILED
  /// Not sent: the endpoint was disabled or removed meanwhile.
  SKIPPED
}

/// One event sent to one endpoint (delivery log, kept 30 days).
model WebhookDelivery {
  id             String                @id @default(cuid())
  workspaceId    String                @map("workspace_id")
  endpointId     String                @map("endpoint_id")
  /// `evt_...` — `Steel-Webhook-Id`, the same across retries.
  eventId        String                @map("event_id")
  eventType      String                @map("event_type")
  /// Exact JSON body sent (the signature is computed over it).
  body           String
  status         WebhookDeliveryStatus @default(PENDING)
  /// Attempts made so far (automatic and manual).
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  /// First 1 KB of the answer, for the log screen.
  responseBody   String?               @map("response_body")
  durationMs     Int?                  @map("duration_ms")
  error          String?
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([endpointId, createdAt])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ─── Proactive AI (ADR 0040) ─────────────────────────────────────────────────

/// What an insight is about. Rules live in `src/lib/ai/proactive/rules.ts`.
enum AiInsightKind {
  /// ServiceDesk: tickets predicted to breach the SLA in the next hours.
  SD_SLA_BREACH_FORECAST
  /// CRM: open deals without activity for N days.
  CRM_STALE_OPPORTUNITIES
  /// CRM: one stage concentrates idle deals.
  CRM_STALLED_STAGE
  /// CRM: weighted forecast of the month below the quota.
  CRM_FORECAST_GAP
  /// Comunicação: unassigned conversations waiting too long.
  ZAP_WAITING_TOO_LONG
  /// Comunicação: a conversation's sentiment fell to the alert threshold.
  ZAP_NEGATIVE_SENTIMENT
}

enum AiInsightSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AiInsightStatus {
  /// The condition holds (last evaluation found it).
  ACTIVE
  /// The condition is gone; a recurrence opens a new episode.
  RESOLVED
}

/// One explainable insight for one user, recomputed by the `ai-proactive`
/// worker. `dedupeKey` identifies the condition (e.g. `sd-breach:dept:<id>`),
/// so a recomputation updates the same row instead of piling up.
model AiInsight {
  id           String            @id @default(cuid())
  workspaceId  String            @map("workspace_id")
  userId       String            @map("user_id")
  kind         AiInsightKind
  module       ModuleKind
  severity     AiInsightSeverity @default(INFO)
  dedupeKey    String            @map("dedupe_key")
  /// pt-BR, numbers included ("3 chamados de N1 devem estourar o SLA até 15:00").
  title        String
  /// pt-BR: why — the numbers behind the insight.
  body         String
  /// [{"label":"Chamados","value":"3"}] — the facts shown as chips.
  facts        Json              @default("[]")
  /// Path inside the workspace (slug included) to open the records.
  href         String?
  /// Prefilled Steel AI question for "Perguntar ao Steel AI".
  prompt       String?
  status       AiInsightStatus   @default(ACTIVE)
  /// Start of the current episode (reset when a resolved insight recurs).
  firstSeenAt  DateTime          @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime          @default(now()) @map("last_seen_at")
  resolvedAt   DateTime?         @map("resolved_at")
  /// Hidden by the user while the episode lasts.
  dismissedAt  DateTime?         @map("dismissed_at")
  /// Hidden by the user until then.
  snoozedUntil DateTime?         @map("snoozed_until")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, dedupeKey])
  @@index([userId, workspaceId, status])
  @@index([workspaceId, status, module])
  @@index([status, resolvedAt])
  @@map("ai_insights")
}

/// Per-user channels of the daily AI digest (no row = both on) and the
/// local day it was last sent (once a day, in the user's time zone).
model AiDigestSetting {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  inApp       Boolean  @default(true) @map("in_app")
  email       Boolean  @default(true)
  /// `YYYY-MM-DD` in the user's time zone of the last digest sent.
  lastSentOn  String?  @map("last_sent_on")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("ai_digest_settings")
}

// ─── CRM: Apollo.io lead import ──────────────────────────────────────────────

enum CrmApolloImportStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  PAUSED_RATE_LIMIT

  @@map("crm_apollo_import_status")
}

enum CrmApolloImportSource {
  SEARCH
  LIST

  @@map("crm_apollo_import_source")
}

/// One run of "Importar da Apollo": the people picked in the preview
/// (`apolloIds`) are enriched in batches of 10 by the `crm-apollo-import`
/// worker and become CRM leads. The API key never lives here (it is the
/// workspace's `APOLLO` integration).
model CrmApolloImport {
  id               String                @id @default(cuid())
  workspaceId      String                @map("workspace_id")
  createdById      String                @map("created_by_id")
  status           CrmApolloImportStatus @default(QUEUED)
  source           CrmApolloImportSource
  /// Filters of the search (or `{ labelId }` for a saved list) for the history.
  filters          Json                  @default("{}")
  /// Apollo person ids (SEARCH) or contact ids (LIST) to import.
  apolloIds        String[]              @default([]) @map("apollo_ids")
  /// LIST imports carry the already-saved contacts (no enrichment, 0 credits).
  contacts         Json?
  mailingListId    String?               @map("mailing_list_id")
  requestedCount   Int                   @default(0) @map("requested_count")
  createdCount     Int                   @default(0) @map("created_count")
  skippedCount     Int                   @default(0) @map("skipped_count")
  failedCount      Int                   @default(0) @map("failed_count")
  /// Next index of `apolloIds` to process (resume after a rate-limit pause).
  cursor           Int                   @default(0)
  creditsConsumed  Int                   @default(0) @map("credits_consumed")
  /// "Revelar telefones": Apollo delivers the numbers later, to the webhook.
  revealPhones     Boolean               @default(false) @map("reveal_phones")
  /// SHA-256 of the webhook token (the token itself is derived, never stored).
  webhookTokenHash String?               @unique @map("webhook_token_hash")
  phonesRequested  Int                   @default(0) @map("phones_requested")
  phonesReceived   Int                   @default(0) @map("phones_received")
  /// People without an importable e-mail whose phone was requested: the lead
  /// is only created when the webhook brings a number.
  phoneOnlyPeople  Json?                 @map("phone_only_people")
  /// Why people were skipped: counts by reason (`no_email`, `opted_out`...).
  skipReasons      Json?                 @map("skip_reasons")
  error            String?
  startedAt        DateTime?             @map("started_at")
  finishedAt       DateTime?             @map("finished_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("CrmApolloImportCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("crm_apollo_imports")
}

/// Where the IVR voice attendant listens: a PABX queue or a DID (ADR 0046).
enum VoiceAgentRouteKind {
  QUEUE
  DID
}

/// IVR voice attendant of a workspace (ADR 0046). Off by default; the
/// PABX dialplan authenticates with `pabxSecretHash` and the attendant acts
/// as `runAsUser` (same RBAC as any Steel AI tool).
model VoiceAgentSettings {
  workspaceId           String   @id @map("workspace_id")
  enabled               Boolean  @default(false)
  /// Spoken verbatim at the start of every call; empty = platform default.
  noticeText            String?  @map("notice_text") @db.VarChar(500)
  /// Extra instructions of the company (tone, scope, FAQ).
  instructions          String?  @db.VarChar(2000)
  voice                 String   @default("alloy") @db.VarChar(20)
  maxCallSeconds        Int      @default(300) @map("max_call_seconds")
  /// Monthly cap of attendant minutes (cost control).
  monthlyMinutesCap     Int      @default(300) @map("monthly_minutes_cap")
  silenceTimeoutSeconds Int      @default(20) @map("silence_timeout_seconds")
  runAsUserId           String?  @map("run_as_user_id")
  canOpenTickets        Boolean  @default(true) @map("can_open_tickets")
  canLookupTickets      Boolean  @default(true) @map("can_lookup_tickets")
  /// Extension/queue that takes the call on error, silence or request.
  fallbackTarget        String?  @map("fallback_target") @db.VarChar(40)
  /// SHA-256 of the secret the dialplan sends; the secret is shown once.
  pabxSecretHash        String?  @map("pabx_secret_hash") @db.Char(64)
  pabxSecretHint        String?  @map("pabx_secret_hint") @db.VarChar(8)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runAsUser User?     @relation(fields: [runAsUserId], references: [id], onDelete: SetNull)

  @@map("voice_agent_settings")
}

model VoiceAgentRoute {
  id             String              @id @default(cuid())
  workspaceId    String              @map("workspace_id")
  kind           VoiceAgentRouteKind
  /// Queue name or DID number, as the dialplan reports it.
  value          String              @db.VarChar(40)
  label          String?             @db.VarChar(80)
  enabled        Boolean             @default(true)
  /// Human destination of this route; falls back to the workspace one.
  transferTarget String?             @map("transfer_target") @db.VarChar(40)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, value])
  @@index([workspaceId])
  @@map("voice_agent_routes")
}
