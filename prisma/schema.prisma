// nov: a2-agent-versions

enum SteelAgentVersionStatus {
  /// Waiting for the eval run that gates its publication.
  PENDING_EVAL
  /// The eval run failed or scored under the minimum.
  REJECTED
  /// The version the agent runs for everyone (or the majority).
  PUBLISHED
  /// Passed the gate and receives `rolloutPercent` of the real traffic.
  CHALLENGER
  /// Was published, replaced by a newer one.
  SUPERSEDED
  /// Discarded by a human (or replaced as challenger) before publishing.
  DISCARDED
}

/// Immutable snapshot of what an edit changes in a Steel Agent: instructions,
/// tools and the tool-round cap. Every such edit creates one; it is published
/// only after the gate eval set passes (A2).
model SteelAgentVersion {
  id             String                  @id @default(cuid())
  workspaceId    String                  @map("workspace_id")
  agentId        String                  @map("agent_id")
  /// Sequential per agent (1, 2, 3...).
  number         Int
  status         SteelAgentVersionStatus
  instructions   String                  @db.Text
  maxToolRounds  Int                     @map("max_tool_rounds")
  /// `[{ toolName, mode }]` snapshot.
  tools          Json
  changeNote     String?                 @map("change_note") @db.Text
  /// 1..99 = go live as challenger with this traffic share; null = replaces
  /// the published version.
  rolloutPercent Int?                    @map("rollout_percent")
  /// Eval run that gated this version, with its outcome.
  evalRunId      String?                 @map("eval_run_id")
  evalPassed     Int?                    @map("eval_passed")
  evalTotal      Int?                    @map("eval_total")
  evalNote       String?                 @map("eval_note") @db.Text
  /// Simulation that gated this version (when the agent gates on simulations).
  simulationId   String?                 @map("simulation_id")
  simPassed      Int?                    @map("sim_passed")
  simTotal       Int?                    @map("sim_total")
  createdById    String?                 @map("created_by_id")
  publishedAt    DateTime?               @map("published_at")
  resolvedAt     DateTime?               @map("resolved_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  agent SteelAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, number])
  @@index([agentId, status])
  @@map("steel_agent_versions")
}

// ─── nov: z1-pix-in-chat ──────────────────────────────────────────────────

enum WhatsAppPixChargeStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
}

/// Pix in the conversation (Z1): per-workspace switch, off by default.
model WhatsAppPixSettings {
  id                    String   @id @default(cuid())
  workspaceId           String   @unique @map("workspace_id")
  enabled               Boolean  @default(false)
  /// Minutes a charge stays payable when the agent does not choose.
  defaultExpiresMinutes Int      @default(60) @map("default_expires_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("whatsapp_pix_settings")
}

/// A Pix charge sent in a WhatsApp conversation (by an agent or the AI).
/// `provider` + `providerChargeId` identify it at the PSP; the payment
/// notification marks it PAID. EXPIRED is derived from `expiresAt` when read.
model WhatsAppPixCharge {
  id               String                  @id @default(cuid())
  workspaceId      String                  @map("workspace_id")
  conversationId   String                  @map("conversation_id")
  /// CRM deal the charge belongs to; the payment is noted on it.
  opportunityId    String?                 @map("opportunity_id")
  createdById      String?                 @map("created_by_id")
  createdByAi      Boolean                 @default(false) @map("created_by_ai")
  provider         String
  providerChargeId String                  @map("provider_charge_id")
  amount           Decimal                 @db.Decimal(14, 2)
  description      String                  @db.VarChar(140)
  /// "Copia e cola" (EMV BR Code) payload.
  brCode           String                  @map("br_code")
  status           WhatsAppPixChargeStatus @default(PENDING)
  expiresAt        DateTime                @map("expires_at")
  paidAt           DateTime?               @map("paid_at")
  paidAmount       Decimal?                @map("paid_amount") @db.Decimal(14, 2)
  endToEndId       String?                 @map("end_to_end_id")
  payerName        String?                 @map("payer_name")
  canceledAt       DateTime?               @map("canceled_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  opportunity  CrmOpportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@unique([provider, providerChargeId])
  @@index([workspaceId, conversationId, createdAt])
  @@index([opportunityId])
  @@map("whatsapp_pix_charges")
}

