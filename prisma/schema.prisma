enum ConsentDocument {
  TERMS
  PRIVACY
  COOKIES
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum OnboardingStep {
  PROFILE
  ROLE
  BRINGS
  WORKSPACE
}

enum UserRole {
  PRODUCT_MANAGER
  ENGINEERING_MANAGER
  DESIGNER
  DEVELOPER
  FOUNDER_EXECUTIVE
  OPERATIONS_MANAGER
  OTHER
}

enum UserGoal {
  ROADMAP
  SPRINTS
  CROSS_FUNCTIONAL
  REPLACE_TOOL
  EXPLORING
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum QuickSendShortcut {
  ENTER
  CTRL_ENTER
}

model UserPreference {
  id                 String            @id @default(cuid())
  userId             String            @unique @map("user_id")
  theme              Theme             @default(SYSTEM)
  smoothCursor       Boolean           @default(false) @map("smooth_cursor")
  quickSendShortcut  QuickSendShortcut @default(ENTER) @map("quick_send_shortcut")
  timezone           String            @default("America/Sao_Paulo")
  weekStartsOn       Int               @default(1) @map("week_starts_on")
  weekendDays        Int[]             @default([0, 6]) @map("weekend_days")
  /// "Atalhos de uma tecla": off disables single-key shortcuts and sequences (WCAG 2.1.4).
  singleKeyShortcuts Boolean           @default(true) @map("single_key_shortcuts")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSetting {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  priorityChanges Boolean  @default(true) @map("priority_changes")
  stateChanges    Boolean  @default(true) @map("state_changes")
  comments        Boolean  @default(true)
  mentions        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_setting")
}

model ConsentEvent {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  document  ConsentDocument
  version   String
  action    ConsentAction
  ipAddress String?         @map("ip_address")
  userAgent String?         @map("user_agent")
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document, createdAt])
  @@map("consent_events")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String  @map("backup_codes")
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean @default(true)

  /// Lockout por conta, que o plugin two-factor do better-auth liga **por
  /// padrão** (`accountLockout.enabled` default `true`) e grava em toda
  /// verificação de segundo fator, nos dois desfechos. Sem estas colunas o
  /// adapter do Prisma recusa a escrita com "Unknown argument" — e como o
  /// reset roda no caminho de SUCESSO, um código correto falhava o login
  /// igual a um errado. Ou seja: o 2FA por e-mail que já existia não
  /// funcionava no login.
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  /// O plugin declara `index: true` em `secret`; sem o índice o lookup do
  /// segundo fator faz seq scan na tabela.
  @@index([secret])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  aiActionConnectors AiActionConnector[]
  aiActionSettings   AiActionSettings?
  aiActionExecutions AiActionExecution[]
  id                String                @id @default(cuid())
  name              String
  slug              String                @unique
  activePlan        Plan                  @default(FREE) @map("active_plan")
  trialEndsAt       DateTime?             @map("trial_ends_at")
  /// Ciclo de vida controlado pelo admin global: SUSPENDED bloqueia membros
  /// (UI e API) e DELETING marca a exclusão em andamento (backup → purge).
  status            WorkspaceStatus       @default(ACTIVE)
  suspendedAt       DateTime?             @map("suspended_at")
  suspendedReason   String?               @map("suspended_reason")
  suspendedById     String?               @map("suspended_by_id")
  /// Wiki do workspace: desligada até um OWNER/ADMIN ativar em Ajustes > Wiki.
  wikiEnabled       Boolean               @default(false) @map("wiki_enabled")
  /// Quadro-branco (Excalidraw): ligado por padrão; OWNER/ADMIN desliga em
  /// Ajustes > Quadro-branco.
  whiteboardEnabled Boolean               @default(true) @map("whiteboard_enabled")
  /// Logo público (bucket `workspace-logos`, chave `<id>/logo-<uuid>.<ext>`),
  /// editado em Ajustes > Geral. `null` = sem logo (a UI mostra a inicial).
  logoUrl           String?               @map("logo_url")
  /// Allowlist de IPs/CIDRs de origem, definida pelo admin global. Vazio = acesso
  /// liberado de qualquer rede.
  allowedIps        String[]              @default([]) @map("allowed_ips")
  /// Faixa de tamanho da empresa, informada em Ajustes > Geral.
  companySize       WorkspaceCompanySize? @map("company_size")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  memberships       Membership[]
  subscriptions     Subscription[]
  projects          Project[]
  wikiPages         WikiPage[]
  wikiLabels        WikiLabel[]
  whiteboards       Whiteboard[]

  invitations       WorkspaceInvitation[]
  moduleConnections WorkspaceModuleConnection[]
  moduleAccess      WorkspaceModuleAccess[]
  featureOverrides  WorkspaceFeatureOverride[]
  moduleUsage       ModuleUsageDaily[]

  whatsappConnections          WhatsAppConnection[]
  whatsappContacts             WhatsAppContact[]
  whatsappConversations        WhatsAppConversation[]
  whatsappPhoneCalls           WhatsAppPhoneCall[]
  voiceAgentSettings           VoiceAgentSettings?
  voiceAgentRoutes             VoiceAgentRoute[]
  whatsappMessages             WhatsAppMessage[]
  whatsappQuickReplies         WhatsAppQuickReply[]
  whatsappChatbots             WhatsAppChatbot[]
  whatsappChatbotSessions      WhatsAppChatbotSession[]
  whatsappFlows                WhatsAppFlow[]
  whatsappFlowResponses        WhatsAppFlowResponse[]
  whatsappCommerceSettings     WhatsAppCommerceSettings?
  whatsappCatalogProducts      WhatsAppCatalogProduct[]
  whatsappCatalogOrders        WhatsAppCatalogOrder[]
  whatsappStoreIntegrations    WhatsAppStoreIntegration[]
