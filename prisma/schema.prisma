/// Scheduled maintenance window: shown as a banner on the status pages it is
/// attached to, announced to the subscribers and, optionally, it suppresses
/// the ticket creation of monitoring alerts for the covered CMDB items.
/// `announcedAt` / `canceledNoticeAt` are claimed by the delivery job before
/// it sends (at-most-once).
model SdStatusMaintenance {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  title              String
  description        String?
  startsAt           DateTime  @map("starts_at")
  endsAt             DateTime  @map("ends_at")
  suppressMonitoring Boolean   @default(false) @map("suppress_monitoring")
  /// CMDB items covered by the window (ids, no FK).
  configItemIds      String[]  @default([]) @map("config_item_ids")
  notifySubscribers  Boolean   @default(true) @map("notify_subscribers")
  announcedAt        DateTime? @map("announced_at")
  canceledAt         DateTime? @map("canceled_at")
  canceledNoticeAt   DateTime? @map("canceled_notice_at")
  notifyTotal        Int       @default(0) @map("notify_total")
