  /// Platform: data export (LGPD) ready.
  DATA_EXPORT_READY
  /// Platform: trial ended.
  TRIAL_ENDED
  /// Platform: subscription payment failed.
  BILLING_PAYMENT_FAILED
  /// Platform: subscription canceled.
  BILLING_SUBSCRIPTION_CANCELED
  /// Platform: 80% of the monthly AI quota used.
  AI_QUOTA_WARNING
  /// Platform: monthly AI quota exhausted.
  AI_QUOTA_EXCEEDED
  /// Communication: 50% or 80% of a monthly WhatsApp limit used.
  WHATSAPP_USAGE_WARNING
  /// Communication: a monthly WhatsApp limit reached (sends blocked).
  WHATSAPP_USAGE_LIMIT_REACHED
  /// Pedido de aprovação cancelado (aviso ao aprovador).
  SD_APPROVAL_CANCELED
  /// Pedido/rodada de aprovação venceu sem resposta.
  SD_APPROVAL_EXPIRED
  /// Tarefa do chamado vence em breve ou venceu.
  SD_TASK_DUE
  /// Plantão: troca pontual ou entrada no rodízio.
  SD_ONCALL_SHIFT
  /// Contrato: franquia em 80% ou excedente no período.
  SD_CONTRACT_FRANCHISE
  /// Comentário num artigo da base de conhecimento.
  SD_KB_COMMENT
  /// Alerta do monitoramento abriu/reabriu chamado no plantão.
  SD_MONITOR_ALERT
  WHATSAPP_CONVERSATION_ASSIGNED
  WHATSAPP_AI_HANDOFF
  WHATSAPP_CONNECTION_LOST
  WHATSAPP_BROADCAST_FINISHED
  WHATSAPP_TEMPLATE_REJECTED
  /// Communication: a Meta template's quality dropped to RED or it was paused/disabled.
  WHATSAPP_TEMPLATE_QUALITY
  /// Steel Agents: a run proposed a write that waits for approval.
  AGENT_APPROVAL_REQUESTED
  /// Steel Agents: a run failed.
  AGENT_RUN_FAILED
  /// Steel AI: a pending assistant action expires in ~5 minutes.
  AI_ACTION_EXPIRING
  /// Outbound webhooks (ADR 0036): an endpoint failing for 3 days was disabled.
  WEBHOOK_ENDPOINT_DISABLED
  /// Proactive AI (ADR 0040): the user's daily digest of active insights.
  AI_DAILY_DIGEST
  /// Comunicação: monthly cost reached 80% of the budget (ADR 0050).
  WHATSAPP_COST_BUDGET_WARNING
  /// Comunicação: monthly cost reached the budget.
  WHATSAPP_COST_BUDGET_REACHED
}

/// Notificação no app (caixa de entrada do usuário no workspace).
model Notification {
  id           String           @id @default(cuid())
  workspaceId  String           @map("workspace_id")
  userId       String           @map("user_id")
  kind         NotificationKind
  title        String
  body         String
  /// Caminho interno para onde o clique leva (ex.: a conversa).
  href         String?
  readAt       DateTime?        @map("read_at")
  /// Optional idempotency key: a re-run job never duplicates the same
  /// notification for the same user (unique with `userId`).
  dedupeKey    String?          @map("dedupe_key")
  /// Arquivada pelo usuário: sai de "Tudo" e vive na pasta "Arquivadas".
  archivedAt   DateTime?        @map("archived_at")
  /// Exclusão lógica: nunca mais aparece na caixa de entrada.
  deletedAt    DateTime?        @map("deleted_at")
  /// Snoozed until this instant: hidden from every folder until then, and
  /// back as unread afterwards (the snooze clears `readAt`).
  snoozedUntil DateTime?        @map("snoozed_until")
  createdAt    DateTime         @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, workspaceId, createdAt])
  @@index([userId, workspaceId, readAt])
  @@index([userId, workspaceId, archivedAt, deletedAt])
  @@map("notifications")
}

/// Per-user, per-kind preference for non-ServiceDesk notifications (the
/// ServiceDesk has its own, `SdNotificationPreference`). No row = enabled.
model NotificationPreference {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  workspaceId String           @map("workspace_id")
  kind        NotificationKind
  inApp       Boolean          @default(true) @map("in_app")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, kind])
  @@index([workspaceId, kind])
  @@map("notification_preferences")
}

/// Per-user delivery channels of the inbox in a workspace (kind-agnostic).
/// No row = defaults (browser notifications off until the user opts in).
model NotificationDeliverySetting {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  workspaceId    String   @map("workspace_id")
  /// Desktop notifications for urgent kinds while the tab is hidden.
  browserEnabled Boolean  @default(false) @map("browser_enabled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("notification_delivery_settings")
}

// ============================================================================
// ServiceDesk (ITIL 4) — ver docs/servicedesk/README.md e ADR 0008.
// Tudo prefixado `Sd` / tabelas `sd_*`. Práticas cobertas: Incident, Service
// Request, Change Enablement, Problem, Knowledge, Service Configuration (CMDB),
// Service Level (SLA/OLA) e Service Catalog. Quase tudo é configurável por
// workspace (tabelas em vez de enums) — os enums abaixo guardam só a
// *semântica* fixa que o motor precisa entender.
// ============================================================================

/// Prática ITIL do chamado. Fixa: o motor (SLA, aprovação, campos de mudança
/// e problema) depende dela. Customização fica em fases/templates/campos.
enum SdTicketType {
  INCIDENT
  SERVICE_REQUEST
  CHANGE
  PROBLEM
}

/// Semântica de uma fase (o nome/cor/% são livres). O motor usa isto para
/// SLA (WAITING pausa), resolução (RESOLVED carimba resolvedAt) e fechamento.
enum SdPhaseCategory {
  NEW
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  CANCELED
}

enum SdTicketChannel {
  AGENT
  PORTAL
  EMAIL
  WHATSAPP
