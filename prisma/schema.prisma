  PUBLISHED
}

enum CrmLandingPageSectionType {
  HEADER
  HERO
  SERVICES
  FACTS
  ABOUT
  TESTIMONIAL
  FEATURES
  WORKS
  FOOTER
  PRICING
  FAQ
  STEPS
